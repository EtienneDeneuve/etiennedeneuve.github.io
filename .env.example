# Copy to `.env` for local builds (gitignored).
# Production: repository secrets PUBLIC_GA4_MEASUREMENT_ID / PUBLIC_CLARITY_PROJECT_ID
# are injected by `.github/workflows/deploy.yml` and `pr.yml` at Astro build time.
# These measurement IDs are client-visible in HTML — not confidential — but must
# come from env so a missing secret cannot silently fall back to a hardcoded ID.

# Google Analytics 4 measurement ID (G-XXXXXXXX)
PUBLIC_GA4_MEASUREMENT_ID=G-DH1KQ6T6XX

# Microsoft Clarity project ID
PUBLIC_CLARITY_PROJECT_ID=xs4kgk0kth
