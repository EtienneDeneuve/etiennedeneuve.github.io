{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "bun run validate-publication && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.{astro,ts,tsx,js,mjs}\"",
    "check": "node src/scripts/astro-check-ci.mjs",
    "validate:collections": "node src/scripts/validate-collections.mjs",
    "validate-publication": "bun run src/scripts/validate-publication.ts",
    "generate-media-kit": "bun run src/scripts/generate-media-kit.ts",
    "sync:github-projects": "bun run src/scripts/sync-github-projects.ts",
    "fetch-social-stats": "node src/scripts/fetch-social-stats.mjs",
    "generate:assets": "pnpm run fetch-social-stats",
    "spellcheck": "cspell \"**/*.{md,astro,ts,js,mjs,json}\" --no-progress",
    "linkcheck": "node src/scripts/check-internal-links.mjs",
    "linkcheck:source": "node src/scripts/check-links.mjs",
    "verify-seo": "node src/scripts/verify-seo.mjs",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run test:no-secrets-in-dist && pnpm run test:seo",
    "test:seo": "node src/scripts/tests/test-seo-dist.mjs",
    "test:no-secrets-in-dist": "node src/scripts/tests/test-no-secrets-in-dist.mjs",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "check-resources": "node src/scripts/check-resource-review.mjs",
    "verify-git-dates": "node src/scripts/verify-git-dates.mjs",
    "sync-linkedin": "node src/scripts/sync-linkedin-profile.mjs",
    "harmonize-profile": "node src/scripts/harmonize-profile.mjs",
    "migrate:thinking-routes": "bun run src/scripts/migrate-thinking-routes.ts",
    "ci:quality": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run validate:collections && pnpm run validate-publication && pnpm run spellcheck && pnpm run verify-seo",
    "ci:build": "pnpm run build && pnpm run linkcheck && pnpm run test && pnpm run test:e2e && pnpm run lighthouse",
    "ci:deploy-prep": "pnpm run generate:assets && pnpm run generate-media-kit && pnpm run sync:github-projects && pnpm run build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@jop-software/astro-cookieconsent": "^3.0.0",
    "@thewebforge/astro-og-images": "^3.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "aos": "^2.3.4",
    "astro": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-mermaidjs": "^6.0.0",
    "sharp": "^0.34.5",
    "vanilla-cookieconsent": "^3.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@cspell/dict-aws": "^4.0.17",
    "@cspell/dict-docker": "^1.1.17",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@cspell/dict-k8s": "^1.0.12",
    "@cspell/dict-terraform": "^1.1.3",
    "@frontmatter/extensibility": "^0.0.18",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/parser": "^6.21.0",
    "cspell": "^9.4.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^0.31.4",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "gray-matter": "^4.0.3",
    "html-encoder-decoder": "^1.3.10",
    "html-entities": "^2.5.2",
    "markdown-link-check": "^3.14.2",
    "mdast-util-to-string": "^4.0.0",
    "playwright-core": "^1.57.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.13.0",
    "reading-time": "^1.5.0",
    "rehype-accessible-emojis": "^0.3.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-toc": "^3.0.2",
    "remark-toc": "^9.0.0",
    "tw-to-css": "^0.0.12",
    "typescript": "^5.6.2",
    "unlighthouse": "^0.17.4",
    "uuid": "^13.0.0"
  }
}
