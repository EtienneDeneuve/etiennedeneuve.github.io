---
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutConfig } from "../config/about.ts";
import { siteConfig } from "../config/site.ts";
import {
  buildJsonLdGraph,
  personJsonLd,
  profilePageJsonLd,
  websiteJsonLd,
  type JsonLdObject,
} from "../lib/json-ld.ts";
import { ecosystemNodeId } from "../lib/ecosystem-json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const aboutPath = `${prefix}/about/`;
const config = aboutConfig;
const labels = config.labels;
const links = config.links;

const omnivyaExpertNode: JsonLdObject = {
  "@type": "Organization",
  "@id": ecosystemNodeId("omnivya-expert"),
  name: siteConfig.omnivya.name,
  url: siteConfig.omnivya.website,
};

const jsonLd = buildJsonLdGraph([
  personJsonLd({
    worksFor: { "@id": ecosystemNodeId("omnivya-expert") },
  }),
  omnivyaExpertNode,
  websiteJsonLd(),
  profilePageJsonLd(aboutPath),
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={aboutPath}
  ogType="profile"
  alternates={[
    { lang: "fr", href: "/about/" },
    { lang: "en", href: "/en/about/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper about stack gap-12">
    <header class="page-hero stack gap-4">
      <p class="eyebrow">{siteConfig.professionalRole.title}</p>
      <h1>{config.meta.title[lang]}</h1>
      <p class="lede">{config.meta.lead[lang]}</p>
    </header>

    <section class="stack gap-3" id="today">
      <h2>{config.today.title[lang]}</h2>
      {config.today.paragraphs[lang].map((paragraph) => <p>{paragraph}</p>)}
      <p>
        <a href={`${prefix}/work/`}>{labels.work[lang]}</a>
        {" · "}
        <a
          href={lang === "en"
            ? "https://www.omnivya.fr/contact/?utm_source=etienne_deneuve&utm_medium=referral&utm_campaign=about&utm_content=omnivya-link"
            : "https://www.omnivya.fr/fr/contact/?utm_source=etienne_deneuve&utm_medium=referral&utm_campaign=about&utm_content=omnivya-link"}
          target="_blank"
          rel="noopener noreferrer"
        >
          {labels.omnivyaLink[lang]}
        </a>
      </p>
    </section>

    <section class="stack gap-3" id="path">
      <h2>{config.path.title[lang]}</h2>
      {config.path.paragraphs[lang].map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="stack gap-4" id="timeline" aria-labelledby="timeline-heading">
      <div class="stack gap-2">
        <h2 id="timeline-heading">{config.timeline.title[lang]}</h2>
        <p class="intro">{config.timeline.intro[lang]}</p>
      </div>
      <ol class="timeline">
        {
          config.timeline.items.map((item) => (
            <li class="timeline-item">
              <p class="timeline-period">
                <time>{item.period}</time>
              </p>
              <div class="timeline-body">
                <h3>{item.title[lang]}</h3>
                <p>{item.body[lang]}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="stack gap-3" id="responsibilities">
      <h2>{config.responsibilities.title[lang]}</h2>
      {config.responsibilities.paragraphs[lang].map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <nav class="elsewhere stack gap-3" aria-labelledby="elsewhere-heading">
      <h2 id="elsewhere-heading">{links.title[lang]}</h2>
      <ul>
        <li><a href={`${prefix}/work/`}>{links.work[lang]}</a></li>
        <li><a href={`${prefix}/projects/`}>{links.projects[lang]}</a></li>
        <li><a href={`${prefix}/speaking/`}>{links.speaking[lang]}</a></li>
        <li><a href={`${prefix}/thinking/`}>{links.thinking[lang]}</a></li>
        <li><a href={`${prefix}/contact/`}>{links.contact[lang]}</a></li>
      </ul>
    </nav>
  </main>
</BaseLayout>

<style>
  .about {
    max-width: 72ch;
  }
  .intro {
    margin: 0;
    color: var(--color-fg-subtle);
    font-size: var(--text-sm);
  }
  .about p {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: 1.65;
  }
  .elsewhere ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .timeline {
    list-style: decimal;
    margin: 0;
    padding-left: 1.5rem;
    display: grid;
    gap: 1.25rem;
  }
  .timeline-item {
    display: block;
  }
  .timeline-period {
    margin: 0 0 0.25rem;
    font-weight: 600;
    color: var(--color-fg);
  }
  .timeline-body h3 {
    margin: 0 0 0.35rem;
    font-size: var(--text-md);
  }
  .timeline-body p {
    margin: 0;
  }

  @supports (display: grid) {
    .timeline {
      list-style: none;
      padding-left: 0;
      border-left: 2px solid var(--gray-800);
      margin-left: 0.65rem;
      padding-left: 1.25rem;
      gap: 1.5rem;
    }
    .timeline-item {
      position: relative;
    }
    .timeline-item::before {
      content: "";
      position: absolute;
      left: calc(-1.25rem - 5px);
      top: 0.35rem;
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 50%;
      background: var(--gray-400);
      border: 2px solid var(--gray-999);
    }
    .timeline-period time {
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.02em;
      color: var(--color-fg-subtle);
      font-size: var(--text-sm);
      font-weight: 600;
      text-transform: uppercase;
    }
  }
</style>
