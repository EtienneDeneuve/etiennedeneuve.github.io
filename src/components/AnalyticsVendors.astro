---
/**
 * GA4 + Microsoft Clarity, gated by cookieconsent "analytics" category.
 * IDs come from PUBLIC_GA4_MEASUREMENT_ID / PUBLIC_CLARITY_PROJECT_ID at build time.
 * Legacy Universal Analytics (UA-*) is intentionally not loaded.
 *
 * Must use type="text/plain" + data-category (vanilla-cookieconsent v3).
 * Partytown type="text/partytown" bypasses consent and loads third-party cookies
 * before accept — that tanks Lighthouse best-practices (and breaks GDPR gating).
 *
 * Vendor snippets use set:html so Prettier does not parse `arguments` inside inline scripts.
 */
import { siteConfig } from "../config/site.ts";

const ga4Id = siteConfig.analytics.ga4MeasurementId;
const clarityId = siteConfig.analytics.clarityProjectId;
const hasGa4 = Boolean(ga4Id);
const hasClarity = Boolean(clarityId);

const ga4Inline = hasGa4
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag("js", new Date());
gtag("config", ${JSON.stringify(ga4Id)});`
  : "";

const clarityInline = hasClarity
  ? `(function(c,l,a,r,i,t,y){
c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window,document,"clarity","script",${JSON.stringify(clarityId)});`
  : "";
---

{
  hasGa4 && (
    <>
      <script
        is:inline
        type="text/plain"
        data-category="analytics"
        data-service="Google Analytics"
        data-src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}
      />
      <script
        is:inline
        type="text/plain"
        data-category="analytics"
        data-service="Google Analytics"
        set:html={ga4Inline}
      />
    </>
  )
}

{
  hasClarity && (
    <script
      is:inline
      type="text/plain"
      data-category="analytics"
      data-service="Microsoft Clarity"
      set:html={clarityInline}
    />
  )
}
