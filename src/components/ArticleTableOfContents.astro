---
import { thinkingConfig } from "../config/thinking.ts";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang: "fr" | "en";
}

/** rehype-autolink-headings appends "#" into Astro's heading.text — strip it for TOC. */
function cleanHeadingText(text: string): string {
  return text.replace(/\s*#\s*$/u, "").trim();
}

const { headings, lang } = Astro.props;
const items = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({
    ...heading,
    text: cleanHeadingText(heading.text),
  }));
const tocLabel = thinkingConfig.labels.toc[lang];
const quickNav = thinkingConfig.labels.quickNav[lang];
---

{
  items.length >= 2 && (
    <nav class="toc" aria-label={tocLabel} data-toc>
      <details class="toc__panel" open>
        <summary class="toc__summary">
          <span class="toc__summary-mobile">{quickNav}</span>
          <span class="toc__summary-desktop">{tocLabel}</span>
        </summary>
        <ol>
          {items.map((heading) => (
            <li>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<style>
  .toc {
    min-width: 0;
    color: var(--brand-main-muted);
  }
  .toc__panel {
    margin: 0;
  }
  .toc__summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-main-muted);
  }
  .toc__summary::-webkit-details-marker {
    display: none;
  }
  .toc__summary-mobile {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .toc__summary-mobile::after {
    content: "▾";
    font-size: 0.7em;
    opacity: 0.7;
  }
  .toc__panel[open] .toc__summary-mobile::after {
    content: "▴";
  }
  .toc__summary-desktop {
    display: none;
  }
  .toc ol {
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }
  .toc li {
    margin: 0;
  }
  .toc a {
    display: block;
    color: color-mix(in srgb, var(--brand-main-ink) 62%, transparent);
    text-decoration: none;
    font-size: 0.78rem;
    line-height: 1.35;
    font-weight: 450;
    border-left: 2px solid transparent;
    padding-left: 0.55rem;
    margin-left: -0.55rem;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .toc a:hover,
  .toc a:focus-visible {
    color: var(--brand-main-copper);
  }
  .toc a:focus-visible {
    outline: 2px solid var(--brand-main-copper);
    outline-offset: 2px;
  }
  .toc a.is-active {
    color: var(--brand-main-copper);
    font-weight: 600;
    border-left-color: var(--brand-main-copper);
  }
  @media (prefers-reduced-motion: reduce) {
    .toc a {
      transition: none;
    }
  }

  @media (max-width: 63.99em) {
    .toc {
      margin: 0 0 0.85rem;
    }
    .toc__summary {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      min-height: 2.5rem;
      padding: 0.4rem 0.75rem;
      border: 1px solid var(--brand-main-border);
      border-radius: 4px;
      background: var(--brand-main-soft);
      color: var(--brand-main-ink);
      font-size: 0.78rem;
      font-weight: 650;
      letter-spacing: 0.06em;
    }
    .toc__summary-mobile {
      color: var(--brand-main-copper);
    }
    .toc__summary-mobile::after {
      color: var(--brand-main-ink);
      opacity: 0.85;
      font-size: 0.85em;
    }
    .toc a {
      border-left: 0;
      padding-left: 0;
      margin-left: 0;
    }
  }

  @media (min-width: 64em) {
    .toc {
      position: sticky;
      /* Clear sticky nav + reading progress (3px) so TOC never covers headings. */
      top: calc(var(--site-nav-offset, 4.75rem) + 0.35rem);
      align-self: start;
      max-height: calc(100vh - var(--site-nav-offset, 4.75rem) - 1.5rem);
      overflow: auto;
      padding-top: 0.35rem;
      padding-left: 0.85rem;
      border-left: 1px solid var(--border-on-dark, rgba(243, 239, 231, 0.16));
      z-index: 1;
    }
    .toc__summary {
      cursor: default;
      margin-bottom: 0.55rem;
      pointer-events: none;
    }
    .toc__summary-mobile {
      display: none;
    }
    .toc__summary-desktop {
      display: inline;
    }
    .toc__panel ol {
      display: grid;
    }
  }
</style>

<script>
  /**
   * ClientRouter: re-bind on every astro:page-load and tear down prior
   * scroll/resize/matchMedia listeners so soft navigations never stack handlers.
   */
  type TocItem = { id: string; el: HTMLElement; link: HTMLAnchorElement };

  let tocSpyCleanup: (() => void) | undefined;

  const navOffsetPx = (): number => {
    const raw = getComputedStyle(document.documentElement).getPropertyValue("--site-nav-offset");
    const px = Number.parseFloat(raw);
    return Number.isFinite(px) ? px : 76;
  };

  const pageScrollY = (): number =>
    window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;

  const prefersReducedMotion = (): boolean =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const scrollHeadingIntoView = (heading: HTMLElement): void => {
    const top = pageScrollY() + heading.getBoundingClientRect().top - navOffsetPx() - 10;
    const behavior = prefersReducedMotion() ? "auto" : "smooth";
    window.scrollTo({ top: Math.max(0, top), behavior });
    document.documentElement.scrollTo?.({ top: Math.max(0, top), behavior });
  };

  const syncTocOpen = (): void => {
    const desktop = window.matchMedia("(min-width: 64em)").matches;
    document.querySelectorAll(".toc__panel").forEach((panel) => {
      if (!(panel instanceof HTMLDetailsElement)) return;
      panel.open = desktop;
    });
  };

  function initTocSpy(): void {
    tocSpyCleanup?.();
    tocSpyCleanup = undefined;
    syncTocOpen();

    const toc = document.querySelector("[data-toc]");
    if (!(toc instanceof HTMLElement)) return;

    const links = [...toc.querySelectorAll("[data-toc-link]")].filter(
      (el): el is HTMLAnchorElement => el instanceof HTMLAnchorElement
    );
    if (links.length === 0) return;

    const items: TocItem[] = links.flatMap((link) => {
      const id = link.getAttribute("data-toc-link");
      if (!id) return [];
      const el = document.getElementById(id);
      return el instanceof HTMLElement ? [{ id, el, link }] : [];
    });
    if (items.length === 0) return;

    let activeId = "";

    const pickActive = (): void => {
      const line = navOffsetPx() + 12;
      let current = items[0]?.id;
      if (!current) return;
      for (const item of items) {
        if (item.el.getBoundingClientRect().top - line <= 0) current = item.id;
        else break;
      }
      if (current === activeId) return;
      activeId = current;
      for (const item of items) {
        item.link.classList.toggle("is-active", item.id === current);
        if (item.id === current) {
          item.link.setAttribute("aria-current", "true");
        } else {
          item.link.removeAttribute("aria-current");
        }
      }
    };

    const onTocClick = (event: Event): void => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest("[data-toc-link]");
      if (!(link instanceof HTMLAnchorElement)) return;
      const id = link.getAttribute("data-toc-link");
      if (!id) return;
      const heading = document.getElementById(id);
      if (!(heading instanceof HTMLElement)) return;
      event.preventDefault();
      scrollHeadingIntoView(heading);
      history.replaceState(history.state, "", `#${id}`);
      pickActive();
      link.focus({ preventScroll: true });
    };

    const desktopMq = window.matchMedia("(min-width: 64em)");
    const onMq = (): void => syncTocOpen();
    const onScroll = (): void => pickActive();

    toc.addEventListener("click", onTocClick);
    window.addEventListener("scroll", onScroll, { passive: true });
    document.body.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    desktopMq.addEventListener("change", onMq);
    pickActive();

    tocSpyCleanup = () => {
      toc.removeEventListener("click", onTocClick);
      window.removeEventListener("scroll", onScroll);
      document.body.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      desktopMq.removeEventListener("change", onMq);
    };
  }

  document.addEventListener("astro:page-load", initTocSpy);
</script>
