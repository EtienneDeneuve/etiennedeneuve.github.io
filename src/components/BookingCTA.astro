---
import ConversionCTA from "./ConversionCTA.astro";
import { omnivyaContactUrl } from "../config/site.ts";
import { contactConfig } from "../config/contact.ts";

interface Props {
  lang?: "fr" | "en";
  bookingSubject?: string;
  surface?: string;
}

const {
  lang = "fr",
  bookingSubject = lang === "en" ? "Contact : discussion" : "Contact : discussion",
  surface = "booking-cta",
} = Astro.props;

const mailtoHref = contactConfig.buildMailto(bookingSubject);
const calendarHref = omnivyaContactUrl(lang, surface);
const omnivyaLabel = contactConfig.mission.cta[lang];
---

<ConversionCTA
  href={mailtoHref}
  event="cta_contact_email"
  props={{ intent: "booking", surface, lang }}
  secondaryHref={calendarHref}
  secondaryLabel={omnivyaLabel}
  secondaryEvent="cta_booking"
  secondaryProps={{ surface, lang }}
>
  <slot />
</ConversionCTA>
