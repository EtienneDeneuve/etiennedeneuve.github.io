---
import { analyticsAttrs } from "../lib/analytics.ts";
import type { ConversionEvent } from "../config/conversion.ts";

interface Props {
  href: string;
  event?: ConversionEvent;
  props?: Record<string, string | number | boolean>;
  size?: "md" | "lg";
  external?: boolean;
}

const {
  href,
  event = "cta_start_here",
  props = {},
  size = "lg",
  external = href.startsWith("http") || href.startsWith("mailto:"),
} = Astro.props;

const attrs = analyticsAttrs(event, props);
---

<a
  class:list={["btn-primary", size === "lg" && "btn-lg"]}
  href={href}
  {...attrs}
  {...external && !href.startsWith("mailto:")
    ? { target: "_blank", rel: "noopener noreferrer" }
    : {}}
>
  <slot />
</a>
