---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DisclosureBadge from "../components/DisclosureBadge.astro";
import { getPublishableEntries } from "../lib/publication-policy.ts";
import { resolveContentRefs } from "../lib/resolve-content.ts";
import { FALLBACK_PROOF_LINKS } from "../lib/publication-policy.ts";
import { breadcrumbJsonLd, buildJsonLdGraph, collectionPageJsonLd } from "../lib/json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";

const studies = getPublishableEntries(await getCollection("caseStudies")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [articles, projects, resources] = await Promise.all([
  getCollection("blog"),
  getCollection("projects"),
  getCollection("resources"),
]);

const fallbackProofs = resolveContentRefs(
  [
    ...FALLBACK_PROOF_LINKS.projects.map((id) => ({ kind: "project" as const, id })),
    ...FALLBACK_PROOF_LINKS.articles.map((id) => ({ kind: "article" as const, id })),
  ],
  { articles, projects, resources },
  lang
);

const emptyMessage =
  lang === "en"
    ? "Some work cannot be published. Public projects and contributions currently form the main available proof base."
    : "Certains travaux ne peuvent pas être publiés. Les projets et contributions publiques constituent actuellement la principale base de preuve disponible.";

const projectsLabel = lang === "en" ? "View projects" : "Voir les projets";
const thinkingLabel = lang === "en" ? "Technical articles" : "Articles techniques";
const readLabel = lang === "en" ? "Read" : "Lire";
const openLabel = lang === "en" ? "Open" : "Ouvrir";
const caseStudiesPath = `${prefix}/work/case-studies/`;
const caseStudiesTitle = lang === "en" ? "Case Studies" : "Études de cas";
const caseStudiesDescription =
  lang === "en"
    ? "Publishable and verifiable case studies."
    : "Études de cas publiables et vérifiables.";

const jsonLd = buildJsonLdGraph([
  collectionPageJsonLd({
    name: caseStudiesTitle,
    description: caseStudiesDescription,
    path: caseStudiesPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: "Work", path: `${prefix}/work/` },
    { name: caseStudiesTitle, path: caseStudiesPath },
  ]),
]);
---

<BaseLayout
  title={caseStudiesTitle}
  description={caseStudiesDescription}
  lang={lang}
  path={caseStudiesPath}
  alternates={[
    { lang: "fr", href: "/work/case-studies/" },
    { lang: "en", href: "/en/work/case-studies/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper stack gap-8">
    <section class="stack gap-3 hero">
      <h1>Case Studies</h1>
      <p class="subtitle">
        {
          lang === "en"
            ? "Only verified outcomes and structured evidence are published."
            : "Seuls les résultats vérifiés et les preuves structurées sont publiés."
        }
      </p>
    </section>

    {
      studies.length > 0 ? (
        <div class="stack gap-4">
          {studies.map((study) => (
            <article class="card">
              <div class="card-header">
                <h2>
                  <a href={`${prefix}/work/case-studies/${study.id}/`}>{study.data.title}</a>
                </h2>
                <DisclosureBadge level={study.data.disclosureLevel} lang={lang} />
              </div>
              <p>{study.data.summary}</p>
              <p class="meta">{study.data.industry}</p>
            </article>
          ))}
        </div>
      ) : (
        <section class="empty-state stack gap-4">
          <p>{emptyMessage}</p>
          <div class="actions">
            <a class="btn-primary" href={`${prefix}/projects/`}>
              {projectsLabel}
            </a>
          </div>
          {fallbackProofs.length > 0 && (
            <div class="stack gap-3">
              <h2>{thinkingLabel}</h2>
              <ul class="proof-links">
                {fallbackProofs.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      {...(item.href.startsWith("http")
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {item.title}
                    </a>
                    <span class="action">
                      {item.href.startsWith("http") ? openLabel : readLabel}
                    </span>
                    <p>{item.description}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .hero {
    max-width: 72ch;
  }
  .card {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    box-shadow: var(--shadow-sm);
  }
  .card-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  .card h2 {
    margin: 0;
    font-size: var(--text-xl);
  }
  .card h2 a {
    color: inherit;
    text-decoration: none;
  }
  .card h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .meta {
    color: var(--color-fg-subtle);
    font-size: var(--text-sm);
    margin: var(--space-3) 0 0;
  }
  .empty-state {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    max-width: 72ch;
    box-shadow: var(--shadow-sm);
  }
  .proof-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .proof-links li {
    border-top: var(--border-width) solid var(--color-border);
    padding-top: var(--space-3);
  }
  .proof-links a {
    color: var(--color-fg);
    text-decoration: none;
    font-weight: 600;
  }
  .proof-links a:hover {
    text-decoration: underline;
  }
  .action {
    margin-left: var(--space-2);
    color: var(--color-fg-subtle);
    font-size: var(--text-sm);
  }
  .proof-links p {
    margin: var(--space-1) 0 0;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }
</style>
