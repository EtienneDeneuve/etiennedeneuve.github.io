---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConversionCTA from "../components/ConversionCTA.astro";
import { contactConfig } from "../config/contact.ts";
import { siteConfig } from "../config/site.ts";
import {
  breadcrumbJsonLd,
  buildJsonLdGraph,
  collectionPageJsonLd,
  personJsonLd,
} from "../lib/json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const config = contactConfig;
const prefix = lang === "en" ? "/en" : "";
const contactPath = `${prefix}/contact/`;
const mailto = config.buildMailto(config.other.subject[lang]);

const jsonLd = buildJsonLdGraph([
  personJsonLd(),
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path: contactPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: config.meta.title[lang], path: contactPath },
  ]),
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={contactPath}
  alternates={[
    { lang: "fr", href: "/contact/" },
    { lang: "en", href: "/en/contact/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper contact stack gap-10">
    <header class="page-hero stack gap-3">
      <h1>{config.meta.title[lang]}</h1>
      <p class="lede">{config.meta.intro[lang]}</p>
      <p class="subtle">
        <a href={`mailto:${config.email}`}>{config.email}</a>
      </p>
    </header>

    <section class="path stack gap-3" id="mission">
      <h2>{config.mission.title[lang]}</h2>
      <p>{config.mission.body[lang]}</p>
      <ConversionCTA
        href={config.mission.hrefFor(lang)}
        event="cta_booking"
        props={{ surface: "contact", intent: "mission", lang }}
        variant="primary"
        external
      >
        {config.mission.cta[lang]}
      </ConversionCTA>
    </section>

    <section class="path stack gap-3" id="other">
      <h2>{config.other.title[lang]}</h2>
      <p>{config.other.body[lang]}</p>
      <ConversionCTA
        href={mailto}
        event="cta_contact_email"
        props={{ surface: "contact", intent: "other", lang }}
      >
        {config.other.cta[lang]}
      </ConversionCTA>
      <p class="subtle">
        <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        {" · "}
        <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .contact {
    max-width: 40rem;
  }
  .path p {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: 1.55;
  }
  .path {
    border-top: var(--border-width) solid var(--color-border);
    padding-top: var(--space-6);
  }
  .subtle {
    font-size: var(--text-sm);
    color: var(--color-fg-subtle);
  }
</style>
