---
import { projectsPageConfig } from "../config/projects-page.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const config = projectsPageConfig.ecosystem;
---

<section class="ecosystem" aria-labelledby="ecosystem-title">
  <h2 id="ecosystem-title">{config.title[lang]}</h2>
  <ol class="ecosystem-flow">
    {
      config.nodes.map((node, index) => (
        <li>
          {index > 0 && (
            <span class="connector" aria-hidden="true">
              ↓
            </span>
          )}
          <a class="node" href={lang === "en" ? `/en${node.href}` : node.href}>
            <span class="node-name">{node.name[lang]}</span>
            <span class="node-role">{node.role[lang]}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .ecosystem {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    background: var(--color-bg-elevated);
  }
  .ecosystem h2 {
    margin: 0 0 1rem;
    font-size: var(--text-lg);
  }
  .ecosystem-flow {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }
  .ecosystem-flow li {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .connector {
    color: var(--color-fg-subtle);
    font-size: var(--text-sm);
    line-height: 1;
    padding: 0.35rem 0;
  }
  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 28rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    background: var(--color-bg-elevated);
    transition: border-color var(--theme-transition);
  }
  .node:hover {
    border-color: var(--color-fg-subtle);
  }
  .node-name {
    font-weight: 600;
    color: var(--color-fg);
  }
  .node-role {
    font-size: var(--text-sm);
    color: var(--color-fg-subtle);
    margin-top: 0.2rem;
  }
  @media (min-width: 50em) {
    .ecosystem-flow {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
    }
    .ecosystem-flow li {
      flex: 1 1 140px;
      max-width: 180px;
    }
    .connector {
      display: none;
    }
    .ecosystem-flow li:not(:last-child)::after {
      content: "→";
      position: absolute;
      right: -0.65rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--color-fg-subtle);
      font-size: var(--text-sm);
    }
    .ecosystem-flow li {
      position: relative;
    }
  }
</style>
