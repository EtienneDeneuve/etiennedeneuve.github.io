---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ecosystemPageConfig } from "../config/ecosystem-page.ts";
import { buildJsonLdGraph, websiteJsonLd } from "../lib/json-ld.ts";
import { fullEcosystemNodes, ecosystemNodeId } from "../lib/ecosystem-json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const path = `${prefix}/ecosystem/`;
const config = ecosystemPageConfig;

const jsonLd = buildJsonLdGraph([
  ...fullEcosystemNodes(lang),
  websiteJsonLd(),
  {
    "@type": "WebPage",
    "@id": `https://etienne.deneuve.xyz${path}`,
    url: `https://etienne.deneuve.xyz${path}`,
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    isPartOf: { "@id": ecosystemNodeId("website") },
    about: { "@id": ecosystemNodeId("omnivya") },
    mainEntity: { "@id": ecosystemNodeId("omnivya") },
  },
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={path}
  alternates={[
    { lang: "fr", href: "/ecosystem/" },
    { lang: "en", href: "/en/ecosystem/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper ecosystem-page stack gap-12">
    <header class="page-hero stack gap-4">
      <p class="eyebrow">{config.meta.eyebrow[lang]}</p>
      <h1>{config.meta.title[lang]}</h1>
      <p class="lede">{config.definition.paragraphs[lang].join(" ")}</p>
    </header>

    <section class="stack gap-3" id="definition" aria-labelledby="definition-title">
      <h2 id="definition-title">{config.definition.title[lang]}</h2>
      {config.definition.paragraphs[lang].map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="stack gap-3" id="how-built" aria-labelledby="how-built-title">
      <h2 id="how-built-title">{config.howBuilt.title[lang]}</h2>
      {config.howBuilt.paragraphs[lang].map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="stack gap-4" id="structure" aria-labelledby="structure-title">
      <h2 id="structure-title">{config.structure.title[lang]}</h2>
      <p>{config.structure.intro[lang]}</p>
      <ul class="structure-list">
        {
          config.structure.items.map((item) => (
            <li>
              <a href={item.href[lang]}>
                <span class="structure-name">{item.name[lang]}</span>
                <span class="structure-role">{item.role[lang]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="stack gap-3" id="historical" aria-labelledby="historical-title">
      <h2 id="historical-title">{config.historical.title[lang]}</h2>
      {config.historical.paragraphs[lang].map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="stack gap-4" id="timeline" aria-labelledby="timeline-title">
      <h2 id="timeline-title">{config.timeline.title[lang]}</h2>
      <p>{config.timeline.intro[lang]}</p>
      <ol class="timeline">
        {
          config.timeline.steps.map((step) => (
            <li>
              <p class="timeline-when">{step.date ?? (lang === "en" ? "Later" : "Ensuite")}</p>
              <h3>{step.title[lang]}</h3>
              <p>{step.summary[lang]}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="stack gap-4" id="links" aria-labelledby="links-title">
      <h2 id="links-title">{config.links.title[lang]}</h2>
      <ul class="link-list">
        {
          config.links.items.map((item) => (
            <li>
              <a
                href={item.href[lang]}
                {...("external" in item && item.external
                  ? { rel: "noopener noreferrer", target: "_blank" }
                  : {})}
              >
                {item.label[lang]}
              </a>
              <span class="link-hint">{item.hint[lang]}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .ecosystem-page {
    padding-block: var(--section-padding, 2rem);
  }
  .lede {
    max-width: 42rem;
    color: var(--color-fg-muted, var(--color-fg-subtle));
    font-size: var(--text-lg);
    line-height: 1.5;
  }
  .structure-list,
  .link-list,
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .structure-list a,
  .link-list a {
    text-decoration: none;
  }
  .structure-list li a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    background: var(--color-bg-elevated);
  }
  .structure-list li a:hover {
    border-color: var(--color-fg-subtle);
  }
  .structure-name {
    font-weight: 600;
  }
  .structure-role,
  .link-hint,
  .timeline-when {
    font-size: var(--text-sm);
    color: var(--color-fg-subtle);
  }
  .timeline {
    gap: 1.25rem;
  }
  .timeline h3 {
    margin: 0.15rem 0 0.35rem;
    font-size: var(--text-base);
  }
  .link-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  @media (min-width: 50em) {
    .structure-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
