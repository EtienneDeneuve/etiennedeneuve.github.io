---
import { omnivyaContactUrl, siteConfig } from "../config/site.ts";
import { navigationConfig } from "../config/navigation.ts";
import { analyticsAttrs } from "../lib/analytics.ts";

const pathname = Astro.url.pathname;
const locale =
  pathname.startsWith("/en/") || pathname === "/en" || pathname === "/en/" ? "en" : "fr";
const explore = navigationConfig.footerExplore[locale];
const legal = navigationConfig.legal[locale];
const role = siteConfig.professionalRole.title;
const omnivyaHref = omnivyaContactUrl(locale, "footer");
const email = siteConfig.omnivya.email;

const linkAttrs = (href: string) => {
  if (href.includes("rss")) return analyticsAttrs("cta_rss", { surface: "footer", lang: locale });
  if (href.includes("contact") || href.startsWith("mailto:")) {
    return analyticsAttrs("cta_contact_email", {
      surface: "footer",
      intent: "qualification",
      lang: locale,
    });
  }
  return {};
};
---

<footer class="site-footer">
  <div class="site-footer__shell">
    <div class="site-footer__brand-row">
      <p class="site-footer__brand">
        <span class="site-footer__mono" aria-hidden="true">ÉD</span>
        <span aria-hidden="true">·</span>
        <span>{siteConfig.identity.name}</span>
        <span aria-hidden="true">·</span>
        <span>{role}</span>
      </p>
      <a class="site-footer__email" href={`mailto:${email}`} {...linkAttrs(`mailto:${email}`)}>
        {email}
      </a>
    </div>

    <nav
      class="site-footer__nav site-footer__nav--explore"
      aria-label={locale === "en" ? "Explore" : "Explorer"}
    >
      {
        explore.map((item) => (
          <a href={item.href} {...linkAttrs(item.href)}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <nav
      class="site-footer__nav site-footer__nav--utility"
      aria-label={locale === "en" ? "Utilities" : "Utilitaires"}
    >
      {legal.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={navigationConfig.rss} {...linkAttrs(navigationConfig.rss)}> RSS </a>
      <a
        href={omnivyaHref}
        rel="noopener noreferrer"
        target="_blank"
        {...analyticsAttrs("cta_booking", {
          surface: "footer",
          intent: "qualification",
          lang: locale,
        })}
      >
        {siteConfig.omnivya.publicName}
      </a>
      <a href={siteConfig.social.linkedin}>LinkedIn</a>
      <a
        href={siteConfig.social.github}
        {...analyticsAttrs("cta_github", { surface: "footer", lang: locale })}
      >
        GitHub
      </a>
      <a href={siteConfig.social.x}>X</a>
    </nav>

    <p class="site-footer__copy">{siteConfig.copyright.notice}</p>
  </div>
</footer>

<style>
  .site-footer {
    /* Full-bleed bar — gutter lives on the shell, same as nav/home (Safari). */
    background: var(--brand-main-bg);
    color: var(--brand-main-ink);
    border-top: 1px solid var(--brand-main-border);
    padding-block: 1rem 1.15rem;
    box-sizing: border-box;
  }

  .site-footer__shell {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--page-max, 90rem);
    margin-inline: auto;
    padding-inline: var(--page-gutter, clamp(1.5rem, 4vw, 4rem));
    display: grid;
    gap: 0.65rem;
  }

  .site-footer__brand-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  .site-footer__brand {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.92rem;
    color: var(--brand-main-muted);
  }

  .site-footer__mono {
    font-family: var(--font-serif, "Cormorant Garamond", Georgia, "Times New Roman", serif);
    font-weight: 600;
    color: var(--brand-main-copper);
  }

  .site-footer__email {
    color: var(--brand-main-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .site-footer__email:hover,
  .site-footer__email:focus-visible {
    color: var(--brand-main-copper);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.1rem;
  }

  .site-footer__nav a {
    color: var(--brand-main-muted);
    text-decoration: none;
    font-size: 0.88rem;
  }

  .site-footer__nav--utility a {
    font-size: 0.82rem;
    color: var(--brand-main-muted);
  }

  .site-footer__nav a:hover,
  .site-footer__nav a:focus-visible {
    color: var(--brand-main-copper);
  }

  .site-footer__copy {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    color: var(--brand-main-muted);
  }
</style>
