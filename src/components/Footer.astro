---
import { siteConfig } from "../config/site.ts";
import { navigationConfig } from "../config/navigation.ts";
import { analyticsAttrs } from "../lib/analytics.ts";

const pathname = Astro.url.pathname;
const locale =
  pathname.startsWith("/en/") || pathname === "/en" || pathname === "/en/" ? "en" : "fr";
const secondary = navigationConfig.secondary[locale];
const legal = navigationConfig.legal[locale];
---

<footer class="wrapper">
  <div class="identity">
    <strong>{siteConfig.identity.name}</strong>
    <p class="role">{siteConfig.professionalRole.title}</p>
    <p class="domains">{siteConfig.professionalRole.subtitle}</p>
    <p>
      <a
        href={`mailto:${siteConfig.omnivya.email}`}
        {...analyticsAttrs("cta_contact_email", {
          surface: "footer",
          intent: "qualification",
          lang: locale,
        })}
      >
        {siteConfig.omnivya.email}
      </a>
    </p>
  </div>

  <div class="links">
    {
      secondary.map((item) => (
        <a
          href={item.href}
          {...(item.href.includes("rss")
            ? analyticsAttrs("cta_rss", { surface: "footer", lang: locale })
            : item.href.includes("contact")
              ? analyticsAttrs("cta_contact_email", {
                  surface: "footer",
                  intent: "qualification",
                  lang: locale,
                })
              : {})}
        >
          {item.label}
        </a>
      ))
    }
    <a href={siteConfig.social.linkedin}>LinkedIn</a>
    <a
      href={siteConfig.social.github}
      {...analyticsAttrs("cta_github", { surface: "footer", lang: locale })}
    >
      GitHub
    </a>
    <a href={siteConfig.social.x}>X</a>
    {legal.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>

  <small>{siteConfig.copyright.notice}</small>
</footer>

<style>
  footer {
    display: grid;
    gap: var(--space-5);
    margin-top: auto;
    padding: var(--space-10) var(--space-6) var(--space-8);
    text-align: left;
    color: var(--color-fg-subtle);
    font-size: var(--text-sm);
    border-top: var(--border-width-strong) solid var(--color-fg);
  }

  footer a {
    color: var(--color-fg-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color var(--motion-fast);
  }

  footer a:hover,
  footer a:focus-visible {
    color: var(--accent-regular);
  }

  .identity strong {
    color: var(--color-fg);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .role {
    margin: var(--space-2) 0 0;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }

  .domains {
    margin: var(--space-1) 0 var(--space-3);
    max-width: 40rem;
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  small {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
</style>
