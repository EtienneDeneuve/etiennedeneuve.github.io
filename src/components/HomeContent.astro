---
import type { CollectionEntry } from "astro:content";
import CallToAction from "./CallToAction.astro";
import { siteConfig } from "../config/site.ts";
import { projectField } from "../lib/projects-i18n.ts";
import { getArticlePath, getArticleLanguage, getCanonicalSlug } from "../lib/thinking.ts";
import type { HomeThinkingItem } from "../lib/home-thinking.ts";

interface Props {
  lang: "fr" | "en";
  proofProjects: CollectionEntry<"projects">[];
  selectedThinking: HomeThinkingItem[];
}

const { lang, proofProjects, selectedThinking } = Astro.props;
const base = lang === "en" ? "/en" : "";

const scope = ["Kubernetes", "OpenTelemetry", "DevSecOps", "FinOps", "Platform"];

const copy =
  lang === "fr"
    ? {
        role: siteConfig.professionalRole.title,
        via: "Missions via",
        headline: "Rendre les plateformes cloud lisibles, fiables et gouvernables.",
        lede: "Notes d’architecture, décisions publiques et preuves vérifiables — pour les équipes qui pilotent un SI sous contraintes réelles.",
        ctaPrimary: "Commencer ici",
        ctaProof: "Voir les projets",
        ctaMail: "Écrire",
        scopeLabel: "Domaines",
        proofTitle: "Réalisations",
        proofAll: "Tous les projets",
        thinkingTitle: "Notes",
        thinkingAll: "Tout lire",
        pathsTitle: "Par où commencer",
        paths: [
          { href: `${base}/start-here/`, label: "Start Here", desc: "Cadrer un SI complexe" },
          { href: `${base}/work/`, label: "Work", desc: "Plateforme et delivery" },
          { href: `${base}/speaking/`, label: "Speaking", desc: "Conférences et media kit" },
        ],
        close: "Une conversation utile commence par le système, pas par la stack.",
        closeCta: "Lire Start Here",
      }
    : {
        role: siteConfig.professionalRole.title,
        via: "Delivery via",
        headline: "Make cloud platforms readable, reliable and governable.",
        lede: "Architecture notes, public decisions and verifiable proof — for teams steering an estate under real constraints.",
        ctaPrimary: "Start here",
        ctaProof: "See the evidence",
        ctaMail: "Write",
        scopeLabel: "Domains",
        proofTitle: "Evidence",
        proofAll: "All projects",
        thinkingTitle: "Thinking",
        thinkingAll: "Index",
        pathsTitle: "Where to begin",
        paths: [
          { href: `${base}/start-here/`, label: "Start Here", desc: "Frame a complex estate" },
          { href: `${base}/work/`, label: "Work", desc: "Platform & delivery" },
          { href: `${base}/speaking/`, label: "Speaking", desc: "Talks & media kit" },
        ],
        close: "A useful conversation starts with the system, not the stack.",
        closeCta: "Read Start Here",
      };

const dateFmt = new Intl.DateTimeFormat(lang === "fr" ? "fr-FR" : "en-GB", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});

const featured = proofProjects[0];
const others = proofProjects.slice(1, 4);

const articleLang = (entry: HomeThinkingItem["entry"]) =>
  lang === "en" ? getArticleLanguage(entry) : "fr";
---

<main class="atelier">
  <section class="atelier-hero">
    <div class="atelier-hero__glow" aria-hidden="true"></div>
    <div class="atelier-hero__inner">
      <p class="atelier-kicker">
        {copy.role}
        <span aria-hidden="true"> · </span>
        {copy.via}
        {" "}
        <a href={siteConfig.omnivya.website} rel="noopener noreferrer" target="_blank"
          >{siteConfig.omnivya.name}</a
        >
      </p>
      <p class="atelier-name">{siteConfig.identity.name}</p>
      <div class="atelier-copy">
        <h1>{copy.headline}</h1>
        <p class="atelier-lede">{copy.lede}</p>
      </div>
      <div class="actions atelier-actions">
        <CallToAction
          href={`${base}/start-here/`}
          event="cta_start_here"
          props={{ surface: "home", lang }}
        >
          {copy.ctaPrimary}
        </CallToAction>
        <a class="btn-secondary" href={`${base}/projects/`}>{copy.ctaProof}</a>
        <a class="btn-text" href={`mailto:${siteConfig.omnivya.email}`}>{copy.ctaMail}</a>
      </div>
      <div class="atelier-scope">
        <span class="atelier-scope__label">{copy.scopeLabel}</span>
        <p class="atelier-scope__list">{scope.join(" · ")}</p>
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="atelier-section" aria-labelledby="atelier-proof">
        <div class="atelier-section__head">
          <h2 id="atelier-proof">{copy.proofTitle}</h2>
          <a class="btn-text" href={`${base}/projects/`}>
            {copy.proofAll}
          </a>
        </div>
        <div class="atelier-proof">
          <a class="atelier-card atelier-proof__lead" href={`${base}/projects/${featured.id}/`}>
            <p class="atelier-meta">{projectField(featured, "type", lang)}</p>
            <h3>{projectField(featured, "name", lang)}</h3>
            <p>{projectField(featured, "problem", lang)}</p>
          </a>
          {others.length > 0 && (
            <ul class="atelier-proof__grid">
              {others.map((project) => (
                <li>
                  <a class="atelier-card" href={`${base}/projects/${project.id}/`}>
                    <p class="atelier-meta">{projectField(project, "type", lang)}</p>
                    <h3>{projectField(project, "name", lang)}</h3>
                    <p>{projectField(project, "problem", lang)}</p>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }

  <section class="atelier-section" aria-labelledby="atelier-thinking">
    <div class="atelier-section__head">
      <h2 id="atelier-thinking">{copy.thinkingTitle}</h2>
      <a class="btn-text" href={`${base}/thinking/`}>{copy.thinkingAll}</a>
    </div>
    <ul class="atelier-feed">
      {
        selectedThinking.map((item) =>
          item.entry ? (
            <li>
              <a href={getArticlePath(getCanonicalSlug(item.entry), articleLang(item.entry))}>
                <time datetime={item.entry.data.pubDate.toISOString()}>
                  {dateFmt.format(item.entry.data.pubDate)}
                </time>
                <span class="atelier-meta">{item.label}</span>
                <h3>{item.entry.data.title}</h3>
              </a>
            </li>
          ) : null
        )
      }
    </ul>
  </section>

  <section class="atelier-section" aria-labelledby="atelier-paths">
    <div class="atelier-section__head">
      <h2 id="atelier-paths">{copy.pathsTitle}</h2>
    </div>
    <ul class="atelier-paths">
      {
        copy.paths.map((path) => (
          <li>
            <a class="atelier-card" href={path.href}>
              <span class="atelier-paths__label">{path.label}</span>
              <span class="atelier-paths__desc">{path.desc}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="atelier-close" aria-labelledby="atelier-close-title">
    <div class="atelier-close__inner">
      <h2 id="atelier-close-title">{copy.close}</h2>
      <CallToAction
        href={`${base}/start-here/`}
        event="cta_start_here"
        props={{ surface: "home-closing", lang }}
      >
        {copy.closeCta}
      </CallToAction>
    </div>
  </section>
</main>

<style is:global>
  .atelier {
    display: grid;
    gap: 0;
    width: 100%;
  }

  .atelier-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .atelier-hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
        ellipse 80% 70% at 0% 0%,
        color-mix(in srgb, var(--accent-regular) 22%, transparent),
        transparent 55%
      ),
      radial-gradient(
        ellipse 60% 50% at 100% 10%,
        color-mix(in srgb, var(--accent-regular) 10%, transparent),
        transparent 50%
      );
    pointer-events: none;
    z-index: 0;
  }

  .atelier-hero__inner {
    position: relative;
    z-index: 1;
    width: min(100% - 2 * var(--space-6), var(--wrapper-max));
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5rem);
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 50em) {
    .atelier-hero__inner {
      width: min(100% - 2 * var(--space-8), var(--wrapper-max));
      grid-template-columns: minmax(0, 1.4fr) minmax(12rem, 0.7fr);
      grid-template-areas:
        "kicker kicker"
        "name name"
        "copy side"
        "actions side"
        "scope scope";
      column-gap: var(--space-12);
      align-items: start;
    }

    .atelier-kicker {
      grid-area: kicker;
    }
    .atelier-name {
      grid-area: name;
    }
    .atelier-copy {
      grid-area: copy;
    }
    .atelier-actions {
      grid-area: actions;
      align-self: start;
    }
    .atelier-scope {
      grid-area: scope;
      margin-top: var(--space-2);
    }
  }

  .atelier-copy {
    display: grid;
    gap: var(--space-4);
  }

  .atelier-kicker {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-fg-subtle);
  }

  .atelier-kicker a {
    color: var(--accent-regular);
    text-decoration: none;
    font-weight: 600;
  }

  .atelier-kicker a:hover {
    text-decoration: underline;
  }

  .atelier-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.88;
    color: var(--color-fg);
  }

  .atelier-hero h1 {
    margin: 0;
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.2vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.18;
    color: var(--color-fg);
  }

  .atelier-lede {
    margin: 0;
    max-width: 40ch;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  .atelier-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .atelier-scope {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .atelier-scope__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .atelier-scope__list {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .atelier-section {
    width: min(100% - 2 * var(--space-6), var(--wrapper-max));
    margin-inline: auto;
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }

  @media (min-width: 50em) {
    .atelier-section {
      width: min(100% - 2 * var(--space-8), var(--wrapper-max));
    }
  }

  .atelier-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .atelier-section__head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .atelier-meta {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-regular);
  }

  .atelier-card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--motion-fast),
      box-shadow var(--motion-fast),
      transform var(--motion-fast);
  }

  .atelier-card:hover {
    border-color: color-mix(in srgb, var(--accent-regular) 50%, var(--color-border));
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .atelier-proof {
    display: grid;
    gap: var(--space-5);
  }

  .atelier-proof__lead {
    gap: var(--space-3);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    min-height: 14rem;
    align-content: start;
  }

  .atelier-proof__lead h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .atelier-proof__lead p:not(.atelier-meta) {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  .atelier-proof__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .atelier-proof__grid h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
  }

  .atelier-proof__grid p:not(.atelier-meta) {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 50em) {
    .atelier-proof {
      grid-template-columns: 1.25fr 0.85fr;
      gap: var(--space-5);
      align-items: stretch;
    }

    .atelier-proof__grid {
      height: 100%;
    }

    .atelier-proof__grid .atelier-card {
      height: 100%;
    }
  }

  .atelier-feed {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .atelier-feed li + li {
    border-top: 1px solid var(--color-border);
  }

  .atelier-feed a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .atelier-feed a:hover {
    background: color-mix(in srgb, var(--accent-regular) 6%, var(--color-bg-elevated));
  }

  .atelier-feed time {
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
  }

  .atelier-feed h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .atelier-feed a:hover h3 {
    color: var(--accent-regular);
  }

  @media (min-width: 50em) {
    .atelier-feed a {
      grid-template-columns: 7rem 9rem minmax(0, 1fr);
      align-items: baseline;
      column-gap: var(--space-5);
    }
  }

  .atelier-paths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .atelier-paths__label {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .atelier-paths__desc {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  @media (min-width: 50em) {
    .atelier-paths {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .atelier-close {
    margin-top: var(--space-6);
    padding: clamp(3.5rem, 9vw, 6rem) var(--space-6);
    background: #0c0a09;
    color: #fafaf9;
  }

  :root.theme-dark .atelier-close {
    background: #fafaf9;
    color: #0c0a09;
  }

  .atelier-close__inner {
    width: min(100%, var(--wrapper-max));
    margin-inline: auto;
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .atelier-close h2 {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: inherit;
  }

  .atelier-close .btn-primary {
    background: var(--accent-regular);
    border-color: var(--accent-regular);
    color: var(--accent-text-over);
  }

  .atelier-close .btn-primary:hover {
    background: var(--accent-dark);
    border-color: var(--accent-dark);
  }

  :root.theme-dark .atelier-close .btn-primary {
    color: #0c0a09;
  }
</style>
