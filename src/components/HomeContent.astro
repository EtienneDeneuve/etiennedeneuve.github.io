---
import { omnivyaContactUrl } from "../config/site.ts";
import { messagingConfig } from "../config/messaging.ts";
import { homeConfig } from "../config/home.ts";
import { getArticlePath, getArticleLanguage, getCanonicalSlug } from "../lib/thinking.ts";
import { orderHomeThinking, type HomeThinkingItem } from "../lib/home-thinking.ts";

interface Props {
  lang: "fr" | "en";
  selectedThinking: HomeThinkingItem[];
}

const { lang, selectedThinking } = Astro.props;
const base = lang === "en" ? "/en" : "";
const copy = homeConfig[lang];
const headline = messagingConfig.etienne.positioning[lang];
const approachId = "approche";

const dateFmt = new Intl.DateTimeFormat(lang === "fr" ? "fr-FR" : "en-GB", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});

const articleLang = (entry: HomeThinkingItem["entry"]) =>
  lang === "en" ? getArticleLanguage(entry) : "fr";

const pubs = orderHomeThinking(selectedThinking);

const featured = pubs[0];
const rest = pubs.slice(1);

// Make the role and the editorial promise distinct, regardless of punctuation.
---

<style is:global>
  body:has(.home) {
    background: var(--graphite, #111416);
  }
</style>

<main class="home">
  <section class="home-band home-band--dark home-hero" aria-labelledby="home-title">
    <div class="home-shell home-hero__grid">
      <div class="home-hero__present">
        <p class="home-eyebrow">{copy.eyebrow}</p>
        <h1 id="home-title" class="home-title">
          <span class="home-title__line">{headline}</span>
          <span class="home-title__line home-title__line--accent">{copy.headlineAccent}</span>
        </h1>
        <p class="home-tagline">{copy.tagline}</p>

        <div class="home-intro">
          <figure class="home-portrait">
            <img
              src="/assets/portrait-cto-conseil.jpeg"
              alt={copy.portraitAlt}
              width="280"
              height="280"
              decoding="async"
              fetchpriority="high"
            />
          </figure>
          <div class="home-intro__copy">
            <p class="home-lede">{copy.lede}</p>
            <div class="home-contact">
              <a
                class="home-cta"
                href={omnivyaContactUrl(lang, "home-hero")}
                rel="noopener noreferrer"
                target="_blank"
                data-analytics-event="cta_booking"
                data-analytics-props={JSON.stringify({
                  surface: "home",
                  lang,
                  intent: "qualification",
                })}
              >
                <span>{copy.ctaMission}</span>
                <span aria-hidden="true">{copy.ctaMissionExternalHint}</span>
              </a>
              <p class="home-cta-context">{copy.ctaContext}</p>
            </div>
          </div>
        </div>
      </div>

      <aside class="home-pubs" aria-labelledby="home-pubs-title">
        <div class="home-pubs__head">
          <h2 id="home-pubs-title">{copy.publicationsTitle}</h2>
          <a class="home-pubs__all" href={`${base}/thinking/`}
            >{copy.publicationsAll} <span aria-hidden="true">→</span></a
          >
        </div>
        {
          pubs.length === 0 ? (
            <p class="home-pubs__empty">{copy.publicationsEmpty}</p>
          ) : (
            <>
              {featured && (
                <article class="home-pubs__featured">
                  <a
                    href={getArticlePath(
                      getCanonicalSlug(featured.entry),
                      articleLang(featured.entry)
                    )}
                  >
                    {featured.spotlight && (
                      <span class="home-pubs__series">À la une · OpenTelemetry 2/4</span>
                    )}
                    <time datetime={featured.entry.data.pubDate.toISOString()}>
                      {dateFmt.format(featured.entry.data.pubDate)}
                    </time>
                    <span class="home-pubs__title">{featured.entry.data.title}</span>
                    {featured.entry.data.description && (
                      <span class="home-pubs__desc">{featured.entry.data.description}</span>
                    )}
                    <span class="home-pubs__read">
                      {copy.readArticle} <span aria-hidden="true">→</span>
                    </span>
                  </a>
                </article>
              )}
              <ol class="home-pubs__list">
                {rest.map((item) => (
                  <li>
                    <a href={getArticlePath(getCanonicalSlug(item.entry), articleLang(item.entry))}>
                      <time datetime={item.entry.data.pubDate.toISOString()}>
                        {dateFmt.format(item.entry.data.pubDate)}
                      </time>
                      <span class="home-pubs__title">{item.entry.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </>
          )
        }
      </aside>
    </div>
  </section>

  <section class="home-band home-band--dark home-domains" aria-label={copy.domains.join(", ")}>
    <div class="home-shell">
      <ul class="home-domains__list">
        {copy.domains.map((domain) => <li>{domain}</li>)}
      </ul>
    </div>
  </section>

  <!-- D2 fold: compact approach strip only (no tall intro block). -->
  <section
    class="home-band home-band--light home-approach"
    id={approachId}
    aria-label={copy.approach.steps.map((s) => s.title).join(" · ")}
  >
    <div class="home-shell home-approach__row">
      <ol class="home-approach__steps">
        {
          copy.approach.steps.map((step) => (
            <li>
              <span class="home-approach__num" aria-hidden="true">
                {step.number}
              </span>
              <div>
                <h2 class="home-approach__step-title">{step.title}</h2>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <a class="home-approach__more" href={`${base}${copy.approach.completePath}`}>
        {copy.approach.completeLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="home-band home-band--dark home-depth" aria-labelledby="home-depth-title">
    <div class="home-shell home-depth__row">
      <div class="home-depth__copy">
        <h2 id="home-depth-title">{copy.technicalDepth.title}</h2>
        <p>{copy.technicalDepth.body}</p>
      </div>
      <a class="home-depth__cta" href={copy.technicalDepth.ctaPath}>
        {copy.technicalDepth.cta}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</main>

<style>
  .home {
    /* Shared gutter with nav/footer — avoids Safari left-edge drift. */
    --home-max: 90rem;
    --home-pad: var(--page-gutter, clamp(1.5rem, 4vw, 4rem));
    /* Section-role aliases. In light mode the primary surface is ivory;
       in dark mode it is graphite. Preserve editorial contrast rhythm. */
    --home-bg: var(--brand-main-bg);
    --home-bg-soft: var(--brand-main-soft);
    --home-ivory: var(--brand-contrast-bg);
    --home-ivory-ink: var(--brand-contrast-ink);
    --home-ivory-muted: var(--brand-contrast-muted);
    --home-ivory-border: var(--brand-contrast-border);
    --home-light: var(--home-ivory);
    --home-copper: var(--brand-main-copper);
    --home-copper-bright: var(--brand-main-copper-hover);
    --home-copper-light: var(--brand-contrast-copper);
    --home-ink: var(--brand-main-ink);
    --home-muted: var(--brand-main-muted);
    --home-border: var(--brand-main-border);
    --home-sans: "Outfit", system-ui, -apple-system, "Segoe UI", sans-serif;
    --home-radius: 4px;
    font-family: var(--home-sans);
  }

  .home-band--dark {
    background: var(--home-bg);
    color: var(--home-ink);
  }

  .home-band--light {
    background: var(--home-ivory);
    color: var(--home-ivory-ink);
  }

  .home-band--light :focus-visible {
    outline-color: var(--home-copper-light);
  }

  .home-shell {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--home-max);
    margin-inline: auto;
    padding-inline: var(--home-pad);
  }

  .home-hero {
    padding-block: 0.85rem 0.65rem;
  }

  .home-hero__grid {
    display: grid;
    gap: 1.5rem;
  }

  .home-eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--home-copper);
  }

  .home-title {
    margin: 0 0 0.5rem;
    /* Kit: H1 inherits Outfit — serif is reserved for the ÉD mark only. */
    font-family: var(--home-sans);
    font-weight: 700;
    font-size: clamp(1.85rem, 6vw, 2.35rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-title__line {
    display: block;
    color: var(--home-ink);
  }

  .home-title__line--accent {
    color: var(--home-copper);
  }

  .home-tagline {
    margin: 0 0 1rem;
    max-width: 36ch;
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--home-ink);
  }

  .home-intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem 1.15rem;
    align-items: center;
  }

  .home-portrait {
    margin: 0;
    width: 7.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #1d1d1f;
  }

  .home-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  .home-intro__copy {
    min-width: 0;
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .home-lede {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--home-muted);
  }

  .home-contact {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
  }

  .home-cta-context {
    margin: 0;
    max-width: 42ch;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--home-muted);
  }

  .home-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0 1.15rem;
    border-radius: var(--home-radius);
    background: var(--home-copper);
    color: var(--brand-main-copper-text);
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
  }

  .home-cta:hover,
  .home-cta:focus-visible {
    filter: brightness(1.06);
  }

  .home-pubs__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .home-pubs__head h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
    color: var(--home-ink);
  }

  .home-pubs__all {
    color: var(--home-copper);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .home-pubs__all:hover {
    color: var(--home-copper-bright);
  }

  .home-pubs__empty {
    margin: 0;
    color: var(--home-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .home-pubs__featured {
    margin: 0 0 0.55rem;
  }

  .home-pubs__featured a {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 0.85rem;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--home-border);
  }

  .home-pubs__series {
    color: var(--home-copper);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-pubs__featured time,
  .home-pubs__list time {
    font-size: 0.8125rem;
    color: var(--home-muted);
  }

  .home-pubs__featured .home-pubs__title {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 650;
    line-height: 1.2;
    color: var(--home-ink);
  }

  .home-pubs__desc {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--home-muted);
  }

  .home-pubs__read {
    margin-top: 0.15rem;
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--home-copper);
  }

  .home-pubs__featured a:hover .home-pubs__title,
  .home-pubs__list a:hover .home-pubs__title {
    color: var(--home-copper-bright);
  }

  .home-pubs__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-pubs__list > li {
    border-bottom: 1px solid var(--home-border);
  }

  .home-pubs__list a {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.6rem;
    text-decoration: none;
    color: inherit;
  }

  .home-pubs__list .home-pubs__title {
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 650;
    line-height: 1.3;
    color: var(--home-ink);
  }

  .home-domains {
    background: var(--home-bg-soft);
    padding-block: 0;
    border-top: 1px solid var(--home-border);
  }

  .home-domains__list {
    list-style: none;
    margin: 0;
    padding: 0.85rem 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem 1.25rem;
  }

  .home-domains__list li {
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--home-ink);
  }

  .home-approach {
    padding-block: 0.85rem 0.95rem;
  }

  .home-approach__row {
    display: grid;
    gap: 0.75rem;
  }

  .home-approach__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .home-approach__steps li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.35rem 0.65rem;
    min-width: 0;
  }

  .home-approach__num {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--home-copper-light);
    line-height: 1.15;
  }

  .home-approach__step-title {
    margin: 0 0 0.2rem;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--home-ivory-ink);
    /* Beat global h2 clamp that blew the fold + Safari metrics. */
    font-family: var(--home-sans);
    letter-spacing: 0;
  }

  .home-approach__steps p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--home-ivory-muted);
  }

  .home-approach__more {
    justify-self: start;
    color: var(--home-copper-light);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .home-approach__more:hover {
    color: var(--brand-contrast-copper-hover);
  }

  .home-depth {
    padding-block: 0.85rem 1rem;
    border-top: 1px solid var(--home-border);
  }

  .home-depth__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .home-depth__copy {
    max-width: 40rem;
    min-width: 0;
  }

  .home-depth__copy h2 {
    margin: 0 0 0.25rem;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 650;
    line-height: 1.25;
    color: var(--home-ink);
    font-family: var(--home-sans);
    letter-spacing: 0;
  }

  .home-depth__copy p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--home-muted);
  }

  .home-depth__cta {
    color: var(--home-copper);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .home-depth__cta:hover {
    color: var(--home-copper-bright);
  }

  @media (min-width: 64rem) {
    .home-hero {
      padding-block: 1.35rem 1rem;
    }

    .home-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 2.5rem;
      align-items: start;
    }

    .home-title {
      font-size: clamp(2.75rem, 3.4vw, 3.35rem);
      margin-bottom: 0.35rem;
    }

    .home-tagline {
      margin-bottom: 0.85rem;
      font-size: 1.05rem;
      line-height: 1.35;
    }

    .home-intro {
      align-items: start;
      gap: 0.85rem 1.25rem;
    }

    .home-portrait {
      width: clamp(7.5rem, 10vw, 9.5rem);
    }

    .home-intro__copy {
      gap: 0.65rem;
    }

    .home-lede {
      max-width: 42ch;
      font-size: 0.92rem;
    }

    .home-cta {
      min-height: 2.5rem;
    }

    .home-pubs__head h2 {
      font-size: 1.25rem;
    }

    .home-pubs__featured .home-pubs__title {
      font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    }

    .home-pubs__featured a {
      padding-bottom: 0.55rem;
      gap: 0.25rem;
    }

    .home-pubs__list a {
      padding-block: 0.45rem;
    }

    .home-domains__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      padding-block: 0.5rem;
    }

    .home-domains__list li {
      padding: 0.15rem 0.85rem;
      border-left: 1px solid color-mix(in srgb, var(--home-copper) 50%, transparent);
      font-size: 0.88rem;
    }

    .home-domains__list li:first-child {
      border-left: 0;
      padding-left: 0;
    }

    .home-approach__row {
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: 1.5rem;
    }

    .home-approach__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }

    .home-approach__steps li {
      display: block;
      padding: 0 1rem;
      border-left: 1px solid var(--home-ivory-border);
    }

    .home-approach__steps li:first-child {
      border-left: 0;
      padding-left: 0;
    }

    .home-approach__steps li:last-child {
      padding-right: 0;
    }

    .home-approach__num {
      margin-bottom: 0.2rem;
    }

    .home-approach__more {
      justify-self: end;
    }

    .home-depth__row {
      flex-wrap: nowrap;
    }
  }

  @media (min-width: 64rem) and (max-height: 860px) {
    .home-hero {
      padding-block: 0.85rem 0.65rem;
    }

    .home-title {
      font-size: clamp(2.35rem, 3vw, 2.85rem);
    }

    .home-portrait {
      width: 6.75rem;
    }

    .home-approach {
      padding-block: 0.65rem 0.75rem;
    }

    .home-depth {
      padding-block: 0.65rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home * {
      transition: none !important;
    }
  }
</style>
