---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import {
  resolvePageSeo,
  seoConfig,
  type PageSeoInput,
  type SeoLang,
  type SeoOgType,
} from "../config/seo.ts";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative OG image — never `/public/...`. */
  og?: string;
  image?: string;
  alternates?: { lang: SeoLang; href: string }[];
  /** Absolute URL or site path for canonical. */
  canonical?: string;
  /** Pathname used when canonical is not provided (e.g. `/thinking/`). */
  path?: string;
  noIndex?: boolean;
  robots?: string;
  lang?: SeoLang;
  ogType?: SeoOgType;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  brandTitle?: boolean;
}

const {
  title,
  description,
  og,
  image,
  alternates = [],
  canonical,
  path,
  noIndex = false,
  robots,
  lang = "fr",
  ogType = "website",
  publishedTime,
  modifiedTime,
  brandTitle,
} = Astro.props;

const resolvedPath =
  path ?? (canonical && !/^https?:\/\//i.test(canonical) ? canonical : Astro.url.pathname);

const seoInput: PageSeoInput = {
  title: title ?? seoConfig.defaultTitle,
  description: description ?? seoConfig.defaultDescription,
  path: resolvedPath,
  lang,
  image: image ?? og,
  ogType,
  alternates,
  robots,
  noIndex,
  publishedTime,
  modifiedTime,
  brandTitle,
};

const seo = resolvePageSeo(seoInput);
const canonicalHref =
  canonical && /^https?:\/\//i.test(canonical)
    ? canonical.replace(/\/public\//g, "/")
    : seo.canonical;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
<link rel="canonical" href={canonicalHref} />
{seo.alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${seoConfig.siteName} RSS`}
  href={seoConfig.rssPath}
/>

<meta property="og:type" content={seo.ogType} />
<meta property="og:site_name" content={seo.siteName} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:locale" content={seo.locale} />
<meta property="og:locale:alternate" content={seo.alternateLocale} />
<meta property="og:image" content={seo.image} />
<meta property="og:image:width" content={String(seo.imageWidth)} />
<meta property="og:image:height" content={String(seo.imageHeight)} />
{seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
{seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}

<meta name="twitter:card" content={seo.twitterCard} />
{seo.twitterSite && <meta name="twitter:site" content={seo.twitterSite} />}
{seo.twitterCreator && <meta name="twitter:creator" content={seo.twitterCreator} />}
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.image} />

<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="msvalidate.01" content="DE6C71A9BE4E011D01CC38799992B4A6" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{/* Non-blocking: render-blocking Google Fonts were tanking / Lighthouse (0.82 < 0.9). */}
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Cormorant:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap"
/>
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
</noscript>

<script
  type="text/partytown"
  async="async"
  is:inline
  crossorigin="anonymous"
  data-cookiecategory="analytics"
  data-service="Google Analytics"
  src="https://www.googletagmanager.com/gtag/js?id=UA-71551100-1"></script>
<script
  is:inline
  type="text/partytown"
  data-cookiecategory="analytics"
  data-service="Google Analytics"
>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "UA-71551100-1");
</script>

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("theme-dark", "cc--darkmode");
  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("theme-dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>
<ClientRouter />
