---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { siteConfig } from "../config/site.ts";
import { navigationConfig } from "../config/navigation.ts";
import { analyticsAttrs } from "../lib/analytics.ts";

interface Props {
  localeSwitchHref?: string;
}

const { localeSwitchHref } = Astro.props;

const pathname = Astro.url.pathname;
const locale =
  pathname.startsWith("/en/") || pathname === "/en" || pathname === "/en/" ? "en" : "fr";
const homeHref = locale === "en" ? "/en/" : "/";
const links = navigationConfig.primary[locale];
const cta = navigationConfig.cta[locale];
const displayName = siteConfig.identity?.name ?? siteConfig.author?.name ?? "Etienne Deneuve";
const role = siteConfig.professionalRole.title;
const otherHref = localeSwitchHref ?? (locale === "en" ? "/" : "/en/");
const menuId = "menu-content";

const isActive = (href: string) => {
  const pathOnly = href.split("#")[0] || "/";
  if (href.includes("#approche")) {
    return pathname === "/" || pathname === "/en" || pathname === "/en/";
  }
  if (pathOnly === "/") return pathname === "/";
  if (pathOnly === "/en/") return pathname === "/en" || pathname === "/en/";
  return pathname === pathOnly || pathname.startsWith(pathOnly);
};

const linkEvent = (href: string) => {
  if (href.includes("start-here")) {
    return analyticsAttrs("cta_start_here", { surface: "nav", lang: locale });
  }
  if (href.includes("speaking")) {
    return analyticsAttrs("cta_speaking", { surface: "nav", lang: locale });
  }
  return {};
};
---

<nav class="site-nav" aria-label={locale === "en" ? "Primary" : "Principale"}>
  <div class="site-nav__shell">
    <div class="menu-header">
      <a href={homeHref} class="site-title">
        <span class="site-title__mono" aria-hidden="true">ÉD</span>
        <span class="site-title__text">
          <span class="site-title__name">{displayName}</span>
          <span class="site-title__role">{role}</span>
        </span>
      </a>
      <menu-button>
        <template>
          <button class="menu-button" type="button" aria-expanded="false" aria-controls={menuId}>
            <span class="sr-only">Menu</span>
            <Icon icon="list" />
          </button>
        </template>
      </menu-button>
    </div>
    <div id={menuId}>
      <ul class="nav-items">
        {
          links.map(({ label, href }) => (
            <li>
              <a
                aria-current={isActive(href) ? "page" : undefined}
                class:list={["link", { active: isActive(href) }]}
                href={href}
                {...linkEvent(href)}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="menu-footer">
        <a
          class="cta-link"
          href={cta.href}
          {...analyticsAttrs("cta_contact_email", {
            surface: "nav",
            intent: "qualification",
            lang: locale,
          })}
        >
          {cta.label}
        </a>
        <div class="menu-tools">
          <LanguageSwitcher lang={locale} otherHref={otherHref} />
          <div class="theme-toggle">
            <ThemeToggle />
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  // @ts-nocheck
  class MenuButton extends HTMLElement {
    constructor() {
      super();

      const template = this.querySelector("template");
      if (!template) return;
      this.appendChild(template.content.cloneNode(true));
      const btn = this.querySelector("button");
      const menu = document.getElementById("menu-content");
      if (!btn || !menu) return;

      menu.hidden = true;

      /** @param {boolean} expand */
      const setExpanded = (expand) => {
        btn.setAttribute("aria-expanded", expand ? "true" : "false");
        menu.hidden = !expand;
      };

      btn.addEventListener("click", () => setExpanded(menu.hidden));

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
          setExpanded(false);
          btn.focus();
        }
      });

      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          if (!btn.hidden) setExpanded(false);
        });
      });

      /** @param {MediaQueryListEvent | MediaQueryList} e */
      const handleViewports = (e) => {
        setExpanded(e.matches);
        btn.hidden = e.matches;
        if (e.matches) {
          menu.hidden = false;
          btn.setAttribute("aria-expanded", "false");
        } else {
          setExpanded(false);
        }
      };
      // Desktop nav from 1200px (75em) — avoids cramped header at 1024–1199.
      const mediaQueries = window.matchMedia("(min-width: 75em)");
      handleViewports(mediaQueries);
      mediaQueries.addEventListener("change", handleViewports);
    }
  }
  customElements.define("menu-button", MenuButton);
</script>

<style>
  .site-nav {
    z-index: 9999;
    position: relative;
    font-family: var(--font-body);
    font-weight: 500;
    margin-bottom: 0;
    background: var(--graphite, #111416);
    color: var(--text-on-dark, #f7f3ec);
    border-bottom: 1px solid var(--border-on-dark, rgba(243, 239, 231, 0.16));
    box-sizing: border-box;
  }

  .site-nav__shell {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--page-max, 90rem);
    margin-inline: auto;
    padding-inline: var(--page-gutter, clamp(1.5rem, 4vw, 4rem));
  }

  .menu-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-4) 0;
  }

  .site-title {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    min-height: var(--touch-min);
    line-height: 1.15;
    color: #f7f3ec;
    text-decoration: none;
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
  }

  .site-title__mono {
    font-family: var(--font-serif, "Cormorant Garamond", Georgia, "Times New Roman", serif);
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1;
    color: var(--copper-on-dark, #f0aa78);
  }

  .site-title__text {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .site-title__name {
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.15;
  }

  .site-title__role {
    font-size: 0.75rem;
    font-weight: 500;
    color: #b8b4ac;
    line-height: 1.15;
  }

  .menu-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    min-width: var(--touch-min);
    border: var(--border-width-strong) solid rgba(243, 239, 231, 0.35);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    font-size: var(--text-xl);
    color: #f7f3ec;
    background: transparent;
  }

  .menu-button[aria-expanded="true"] {
    background: #f7f3ec;
    color: #111416;
    border-color: #f7f3ec;
  }

  .menu-button[hidden] {
    display: none;
  }

  #menu-content {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 10;
  }

  .nav-items {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    font-size: var(--text-md);
    line-height: 1.2;
    list-style: none;
    padding: 0;
    background-color: var(--graphite-soft, #1b1e20);
    border-bottom: 1px solid rgba(243, 239, 231, 0.12);
  }

  .nav-items li {
    border-bottom: 1px solid rgba(243, 239, 231, 0.1);
  }

  .nav-items li:last-child {
    border-bottom: 0;
  }

  .link {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: var(--space-3) 0;
    color: #cdd0cf;
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .link.active {
    color: #f7f3ec;
    background: color-mix(in srgb, var(--accent-on-dark, #f0aa78) 12%, transparent);
    box-shadow: inset 3px 0 0 var(--accent-on-dark, #f0aa78);
  }

  .menu-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    background-color: var(--graphite-soft, #1b1e20);
    border-bottom: 1px solid rgba(243, 239, 231, 0.12);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 4px;
    border: 0;
    background: var(--copper-on-dark, #f0aa78);
    color: #14110f;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 650;
  }

  .cta-link:hover,
  .cta-link:focus-visible {
    filter: brightness(1.06);
  }

  .menu-tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
  }

  .menu-tools :global(.lang-switch__current),
  .menu-tools :global(.lang-switch__link),
  .menu-tools :global(.lang-switch__sep) {
    color: #b8b4ac;
  }

  .menu-tools :global(.lang-switch__current) {
    color: #f7f3ec;
  }

  .menu-tools :global(.lang-switch__link:hover) {
    color: #d69e6f;
  }

  .menu-tools :global(theme-toggle button) {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .menu-tools :global(theme-toggle .icon) {
    color: #b8b4ac;
  }

  @media (min-width: 75em) {
    .site-nav__shell {
      display: grid;
      grid-template-columns: minmax(12rem, 1.1fr) auto minmax(12rem, 1fr);
      align-items: center;
      gap: 1.5rem;
      min-height: 4.25rem;
      padding-block: 0.55rem;
    }

    .menu-header {
      padding: 0;
    }

    #menu-content {
      display: contents;
    }

    .nav-items {
      flex-direction: row;
      align-items: center;
      gap: 0.15rem;
      border: 0;
      background: transparent;
      padding: 0;
    }

    .nav-items li {
      border: 0;
    }

    .link {
      padding: 0.45rem 0;
      min-height: 2.5rem;
      font-size: 0.9rem;
      letter-spacing: 0;
      text-transform: none;
      color: #f7f3ec;
    }

    .nav-items {
      gap: 1.35rem;
    }

    .link:hover,
    .link:focus-visible {
      color: var(--copper-on-dark, #f0aa78);
      background: transparent;
    }

    .link.active {
      color: var(--copper-on-dark, #f0aa78);
      background: transparent;
      box-shadow: none;
    }

    .menu-footer {
      justify-self: flex-end;
      align-items: center;
      padding: 0;
      background-color: transparent;
      border: 0;
      gap: 1rem;
    }

    /* Editorial mock: tools stay available but de-emphasized vs CTA. */
    .theme-toggle {
      opacity: 0.55;
    }

    .theme-toggle:hover,
    .theme-toggle:focus-within {
      opacity: 1;
    }
  }

  @media (forced-colors: active) {
    .link.active {
      color: SelectedItem;
    }
  }
</style>
