---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { siteConfig } from "../config/site.ts";
import { navigationConfig } from "../config/navigation.ts";
import { analyticsAttrs } from "../lib/analytics.ts";

const pathname = Astro.url.pathname;
const locale =
  pathname.startsWith("/en/") || pathname === "/en" || pathname === "/en/" ? "en" : "fr";
const homeHref = locale === "en" ? "/en/" : "/";
const links = navigationConfig.primary[locale];
const cta = navigationConfig.cta[locale];
const displayName = siteConfig.identity?.name ?? siteConfig.author?.name ?? "Etienne Deneuve";

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  if (href === "/en/") return pathname === "/en" || pathname === "/en/";
  return pathname === href || pathname.startsWith(href);
};

const linkEvent = (href: string) => {
  if (href.includes("start-here")) {
    return analyticsAttrs("cta_start_here", { surface: "nav", lang: locale });
  }
  if (href.includes("speaking")) {
    return analyticsAttrs("cta_speaking", { surface: "nav", lang: locale });
  }
  return {};
};
---

<nav>
  <div class="menu-header">
    <a href={homeHref} class="site-title">
      <span class="mark" aria-hidden="true"></span>
      {displayName}
    </a>
    <menu-button>
      <template>
        <button class="menu-button" aria-expanded="false" type="button">
          <span class="sr-only">Menu</span>
          <Icon icon="list" />
        </button>
      </template>
    </menu-button>
  </div>
  <div id="menu-content">
    <ul class="nav-items">
      {
        links.map(({ label, href }) => (
          <li>
            <a
              aria-current={isActive(href) ? "page" : undefined}
              class:list={["link", { active: isActive(href) }]}
              href={href}
              {...linkEvent(href)}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-footer">
      <a
        class="cta-link"
        href={cta.href}
        {...analyticsAttrs("cta_contact_email", {
          surface: "nav",
          intent: "qualification",
          lang: locale,
        })}
      >
        {cta.label}
      </a>
      <div class="theme-toggle">
        <ThemeToggle />
      </div>
    </div>
  </div>
</nav>

<script>
  class MenuButton extends HTMLElement {
    constructor() {
      super();

      const template = this.querySelector("template");
      if (!template) return;
      this.appendChild(template.content.cloneNode(true));
      const btn = this.querySelector("button");
      const menu = document.getElementById("menu-content");
      if (!btn || !menu) return;

      menu.hidden = true;

      const setExpanded = (expand) => {
        btn.setAttribute("aria-expanded", expand ? "true" : "false");
        menu.hidden = !expand;
      };

      btn.addEventListener("click", () => setExpanded(menu.hidden));

      const handleViewports = (e) => {
        setExpanded(e.matches);
        btn.hidden = e.matches;
      };
      const mediaQueries = window.matchMedia("(min-width: 50em)");
      handleViewports(mediaQueries);
      mediaQueries.addEventListener("change", handleViewports);
    }
  }
  customElements.define("menu-button", MenuButton);
</script>

<style>
  nav {
    z-index: 9999;
    position: relative;
    font-family: var(--font-body);
    font-weight: 500;
    margin-bottom: var(--space-6);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .menu-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
  }

  .site-title {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-height: var(--touch-min);
    line-height: 1.1;
    color: var(--color-fg);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-md);
  }

  .mark {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--accent-regular);
    flex-shrink: 0;
  }

  .menu-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    min-width: var(--touch-min);
    border: var(--border-width-strong) solid var(--color-fg);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    font-size: var(--text-xl);
    color: var(--color-fg);
    background: transparent;
  }

  .menu-button[aria-expanded="true"] {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  .menu-button[hidden] {
    display: none;
  }

  #menu-content {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 10;
  }

  .nav-items {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    font-size: var(--text-md);
    line-height: 1.2;
    list-style: none;
    padding: 0;
    background-color: var(--color-bg-elevated);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .nav-items li {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .nav-items li:last-child {
    border-bottom: 0;
  }

  .link {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: var(--space-3) var(--space-6);
    color: var(--color-fg-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .link.active {
    color: var(--color-fg);
    background: var(--accent-subtle-overlay);
    box-shadow: inset 3px 0 0 var(--accent-regular);
  }

  .menu-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-bg-elevated);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    border: var(--border-width-strong) solid var(--accent-regular);
    background: var(--accent-regular);
    color: var(--accent-text-over);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background-color var(--motion-fast);
  }

  .cta-link:hover,
  .cta-link:focus-visible {
    background: var(--accent-dark);
    border-color: var(--accent-dark);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
  }

  @media (min-width: 50em) {
    nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: var(--space-5) var(--space-8);
      gap: var(--space-4);
      border-bottom: var(--border-width) solid var(--color-border);
    }

    .menu-header {
      padding: 0;
    }

    .site-title {
      font-size: var(--text-lg);
    }

    #menu-content {
      display: contents;
    }

    .nav-items {
      flex-direction: row;
      align-items: center;
      gap: var(--space-1);
      border: 0;
      background: transparent;
      padding: 0;
    }

    .nav-items li {
      border: 0;
    }

    .link {
      padding: 0.4rem 0.75rem;
      min-height: 2.4rem;
      transition:
        color var(--motion-fast),
        background-color var(--motion-fast);
    }

    .link:hover,
    .link:focus-visible {
      color: var(--color-fg);
      background-color: var(--accent-subtle-overlay);
    }

    .link.active {
      color: var(--color-fg);
      background: transparent;
      box-shadow: inset 0 -2px 0 var(--accent-regular);
    }

    .menu-footer {
      justify-self: flex-end;
      align-items: center;
      padding: 0;
      background-color: transparent;
      border: 0;
      gap: var(--space-4);
    }
  }

  @media (forced-colors: active) {
    .link.active {
      color: SelectedItem;
    }
  }
</style>
