---
/**
 * Hub-and-spoke map: founders → Omnivya → execution arms.
 * Mirrors the group illustration structure; HTML so FR/EN + links work.
 */
interface Founder {
  id: string;
  name: string;
  role: string;
  href: string;
}

interface HubNode {
  name: string;
  role: string;
  href: string;
}

interface ArmNode {
  id: string;
  name: string;
  role: string;
  href: string;
  external?: boolean;
}

interface Props {
  lang: "fr" | "en";
  founders: Founder[];
  hub: HubNode;
  arms: ArmNode[];
}

const { lang, founders, hub, arms } = Astro.props;
const label = lang === "en" ? "Omnivya group map" : "Carte du groupe Omnivya";
---

<figure class="hub-map" aria-label={label}>
  <div class="hub-map__founders">
    {
      founders.map((founder) => (
        <a class="hub-map__person" href={founder.href}>
          <span class="hub-map__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            >
              <circle cx="12" cy="8" r="3.2" />
              <path d="M5 19c1.2-3.2 3.4-4.8 7-4.8s5.8 1.6 7 4.8" />
            </svg>
          </span>
          <span class="hub-map__name">{founder.name}</span>
          <span class="hub-map__role">{founder.role}</span>
        </a>
      ))
    }
  </div>

  <div class="hub-map__join" aria-hidden="true">
    <span class="hub-map__dot"></span>
  </div>

  <a class="hub-map__hub" href={hub.href}>
    <span class="hub-map__mark" aria-hidden="true">O</span>
    <span class="hub-map__hub-name">{hub.name}</span>
    <span class="hub-map__hub-role">{hub.role}</span>
  </a>

  <div class="hub-map__spread" aria-hidden="true"></div>

  <ul class="hub-map__arms">
    {
      arms.map((arm) => (
        <li>
          <a
            class="hub-map__arm"
            href={arm.href}
            {...(arm.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            <span class="hub-map__arm-name">{arm.name}</span>
            <span class="hub-map__arm-role">{arm.role}</span>
          </a>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .hub-map {
    margin: 0;
    padding: var(--space-6) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background:
      radial-gradient(
          circle at 1px 1px,
          color-mix(in oklab, var(--color-border) 70%, transparent) 1px,
          transparent 0
        )
        0 0 / 18px 18px,
      var(--color-bg-elevated);
    display: grid;
    gap: 0;
    justify-items: center;
  }

  .hub-map__founders {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    width: 100%;
  }

  .hub-map__person,
  .hub-map__hub,
  .hub-map__arm {
    text-decoration: none;
    color: inherit;
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px color-mix(in oklab, var(--color-fg) 6%, transparent);
    transition:
      border-color var(--theme-transition),
      transform 200ms ease;
  }

  .hub-map__person:hover,
  .hub-map__hub:hover,
  .hub-map__arm:hover {
    border-color: color-mix(in oklab, var(--accent-regular) 55%, var(--color-border));
    transform: translateY(-1px);
  }

  .hub-map__person {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    min-width: 9.5rem;
    padding: var(--space-4) var(--space-5);
    text-align: center;
  }

  .hub-map__icon {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: var(--accent-regular);
    background: color-mix(in oklab, var(--accent-regular) 12%, var(--color-bg));
    margin-bottom: 0.35rem;
  }

  .hub-map__name,
  .hub-map__hub-name,
  .hub-map__arm-name {
    font-weight: 600;
    color: var(--color-fg);
  }

  .hub-map__role,
  .hub-map__hub-role,
  .hub-map__arm-role {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-regular);
  }

  .hub-map__arm-role {
    text-transform: none;
    letter-spacing: normal;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-snug);
  }

  .hub-map__join {
    width: 1px;
    height: 1.75rem;
    background: color-mix(in oklab, var(--accent-regular) 55%, var(--color-border));
    position: relative;
    margin-top: 0.15rem;
  }

  .hub-map__join::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: min(12rem, 40vw);
    height: 1px;
    transform: translate(-50%, -100%);
    border-top: 1px dashed color-mix(in oklab, var(--accent-regular) 55%, var(--color-border));
  }

  .hub-map__dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--accent-regular);
    transform: translate(-50%, -50%);
  }

  .hub-map__hub {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
    padding: var(--space-5) var(--space-6);
    min-width: min(22rem, 100%);
    border-color: color-mix(in oklab, var(--accent-regular) 35%, var(--color-border));
  }

  .hub-map__mark {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-bg);
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--accent-regular) 85%, white),
      var(--accent-regular)
    );
  }

  .hub-map__hub-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .hub-map__hub-role {
    max-width: 22ch;
  }

  .hub-map__spread {
    width: min(100%, 52rem);
    height: 1.5rem;
    margin-top: 0.15rem;
    border-top: 1px solid color-mix(in oklab, var(--accent-regular) 45%, var(--color-border));
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--accent-regular) 45%, var(--color-border)),
      color-mix(in oklab, var(--accent-regular) 45%, var(--color-border))
    );
    background-size: 1px 1.5rem;
    background-repeat: no-repeat;
    background-position: center top;
    position: relative;
  }

  .hub-map__arms {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  .hub-map__arm {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-4);
    height: 100%;
  }

  .hub-map__arm-name {
    font-size: var(--text-base);
  }

  @media (min-width: 50em) {
    .hub-map__arms {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-3);
      max-width: 56rem;
    }

    .hub-map__spread {
      background-image: linear-gradient(
          to bottom,
          color-mix(in oklab, var(--accent-regular) 45%, var(--color-border)),
          color-mix(in oklab, var(--accent-regular) 45%, var(--color-border))
        ),
        linear-gradient(
          to bottom,
          color-mix(in oklab, var(--accent-regular) 45%, var(--color-border)),
          color-mix(in oklab, var(--accent-regular) 45%, var(--color-border))
        ),
        linear-gradient(
          to bottom,
          color-mix(in oklab, var(--accent-regular) 45%, var(--color-border)),
          color-mix(in oklab, var(--accent-regular) 45%, var(--color-border))
        ),
        linear-gradient(
          to bottom,
          color-mix(in oklab, var(--accent-regular) 45%, var(--color-border)),
          color-mix(in oklab, var(--accent-regular) 45%, var(--color-border))
        );
      background-size: 1px 1.5rem;
      background-repeat: no-repeat;
      background-position:
        12.5% top,
        37.5% top,
        62.5% top,
        87.5% top;
    }
  }
</style>
