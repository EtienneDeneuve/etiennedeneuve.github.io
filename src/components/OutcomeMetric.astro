---
interface Props {
  label: string;
  before: string;
  after: string;
  unit?: string;
  source?: string;
  verified: boolean;
  lang?: "fr" | "en";
}

const { label, before, after, unit, source, verified, lang = "fr" } = Astro.props;
const verifiedLabel = lang === "en" ? "Verified" : "Vérifiée";
const unverifiedLabel = lang === "en" ? "Not published" : "Non publiée";
---

<div class={`metric ${verified ? "verified" : "unverified"}`}>
  <div class="metric-header">
    <strong>{label}</strong>
    <span class="metric-status">{verified ? verifiedLabel : unverifiedLabel}</span>
  </div>
  {
    verified ? (
      <>
        <p class="metric-values">
          <span>{before}</span>
          <span aria-hidden="true">→</span>
          <span>{after}</span>
          {unit && unit !== "text" && <span class="unit">({unit})</span>}
        </p>
        {source && <p class="metric-source">{source}</p>}
      </>
    ) : (
      <p class="metric-withheld">
        {lang === "en"
          ? "This metric is withheld until verified with a source."
          : "Cette métrique n’est pas publiée tant qu’elle n’est pas vérifiée et sourcée."}
      </p>
    )
  }
</div>

<style>
  .metric {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    background: var(--color-bg-elevated);
  }
  .metric.verified {
    border-color: color-mix(in srgb, var(--accent-regular) 35%, var(--gray-800));
  }
  .metric-header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: 0.35rem;
  }
  .metric-status {
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .metric.verified .metric-status {
    color: var(--accent-regular);
  }
  .metric-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0;
    color: var(--color-fg);
  }
  .unit,
  .metric-source {
    color: var(--color-fg-subtle);
    font-size: var(--text-sm);
    margin: 0.35rem 0 0;
  }
  .metric-withheld {
    margin: 0;
    color: var(--color-fg-subtle);
    font-size: var(--text-sm);
  }
</style>
