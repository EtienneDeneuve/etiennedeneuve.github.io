---
import type { CollectionEntry } from "astro:content";
import { projectField, projectList } from "../lib/projects-i18n.ts";
import { projectsPageConfig } from "../config/projects-page.ts";
import { analyticsAttrs } from "../lib/analytics.ts";

interface Props {
  entry: CollectionEntry<"projects">;
  lang: "fr" | "en";
}

const { entry, lang } = Astro.props;
const labels = Object.fromEntries(
  Object.entries(projectsPageConfig.labels).map(([k, v]) => [k, v[lang]])
) as Record<keyof typeof projectsPageConfig.labels, string>;
const statusLabel = projectsPageConfig.statusLabels[entry.data.status]?.[lang] ?? entry.data.status;
const name = projectField(entry, "name", lang) || entry.data.name;
const prefix = lang === "en" ? "/en" : "";
const href = `${prefix}/projects/${entry.id}/`;
const approach =
  projectList(entry, "principles", lang)[0] || projectList(entry, "decisions", lang)[0] || "";
const technologies = entry.data.technologies ?? [];
const projectAttrs = analyticsAttrs("cta_project_open", {
  surface: "project-card",
  project: entry.id,
  lang,
});
---

<article class="surface-card interactive project-card">
  <header class="card-header">
    <p class="eyebrow">{statusLabel}</p>
    <h2>
      <a href={href} {...projectAttrs}>{name}</a>
    </h2>
  </header>
  <p class="problem">
    <strong>{labels.problem} :</strong>
    {projectField(entry, "problem", lang)}
  </p>
  {
    approach && (
      <p class="approach">
        <strong>{labels.approach} :</strong> {approach}
      </p>
    )
  }
  {
    technologies.length > 0 && (
      <ul class="tech" aria-label={labels.technologies}>
        {technologies.map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>
    )
  }
  <a class="read-more" href={href} {...projectAttrs}>
    {lang === "en" ? "View project" : "Voir le projet"} →
  </a>
</article>

<style>
  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .card-header h2 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-xl);
  }
  .card-header h2 a {
    color: inherit;
    text-decoration: none;
  }
  .card-header h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .problem,
  .approach {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin: 0;
  }
  .tech {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-subtle);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.45rem;
  }
  .read-more {
    margin-top: auto;
  }
</style>
