---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceList from "../components/EvidenceList.astro";
import { projectsPageConfig } from "../config/projects-page.ts";
import { projectEntityHref, projectField, projectList } from "../lib/projects-i18n.ts";
import { resolveContentRefs } from "../lib/resolve-content.ts";
import type { StructuredEvidence } from "../lib/publication-policy.ts";
import {
  breadcrumbJsonLd,
  buildJsonLdGraph,
  personJsonLd,
  projectPageJsonLd,
  softwareSourceCodeJsonLd,
} from "../lib/json-ld.ts";

interface Props {
  entry: CollectionEntry<"projects">;
  lang: "fr" | "en";
}

const { entry, lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const projectPath = `${prefix}/projects/${entry.id}/`;
const labels = Object.fromEntries(
  Object.entries(projectsPageConfig.labels).map(([k, v]) => [k, v[lang]])
) as Record<keyof typeof projectsPageConfig.labels, string>;
const statusLabel = projectsPageConfig.statusLabels[entry.data.status]?.[lang] ?? entry.data.status;

const name = projectField(entry, "name", lang) || entry.data.name;
const summary = projectField(entry, "summary", lang) || entry.data.summary;
const technologies = entry.data.technologies ?? [];
const approachItems = [
  ...projectList(entry, "principles", lang),
  ...projectList(entry, "decisions", lang),
];
const publicHref = projectEntityHref(entry);

const articles = await getCollection("blog");
const relatedItems = resolveContentRefs(
  entry.data.relatedArticles.map((id) => ({ kind: "article" as const, id })),
  { articles, projects: [], resources: [] },
  lang
);

const proofs: Array<string | StructuredEvidence> =
  entry.data.proofs.length > 0
    ? (entry.data.proofs as Array<string | StructuredEvidence>)
    : entry.data.proofLinks.map((url) => ({
        type: "public-repository" as const,
        label: name,
        url,
        description: summary,
      }));

const isOpenSource = entry.data.type === "open-source" && Boolean(entry.data.repository);

const jsonLd = buildJsonLdGraph([
  personJsonLd(),
  projectPageJsonLd({
    name,
    description: summary,
    path: projectPath,
    lang,
    relatedToOmnivya: false,
    repository: entry.data.repository,
  }),
  isOpenSource && entry.data.repository
    ? softwareSourceCodeJsonLd({
        name,
        description: summary,
        codeRepository: entry.data.repository,
        programmingLanguage: technologies[0] ?? null,
        url: projectPath,
      })
    : null,
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: projectsPageConfig.meta.title[lang], path: `${prefix}/projects/` },
    { name: name, path: projectPath },
  ]),
]);
---

<BaseLayout
  title={name}
  description={summary}
  lang={lang}
  path={projectPath}
  alternates={[
    { lang: "fr", href: `/projects/${entry.id}/` },
    { lang: "en", href: `/en/projects/${entry.id}/` },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper stack gap-10">
    <a href={`${prefix}/projects/`}>{labels.back}</a>

    <header class="stack gap-3 hero">
      <p class="eyebrow">{labels.status} · {statusLabel}</p>
      <h1>{name}</h1>
      <p class="subtitle">{summary}</p>
    </header>

    <section class="stack gap-2">
      <h2>{labels.problem}</h2>
      <p>{projectField(entry, "problem", lang)}</p>
    </section>

    {
      approachItems.length > 0 && (
        <section class="stack gap-2">
          <h2>{labels.approach}</h2>
          <ul class="list">
            {approachItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      technologies.length > 0 && (
        <section class="stack gap-2">
          <h2>{labels.technologies}</h2>
          <ul class="tech">
            {technologies.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="stack gap-2">
      <h2>{labels.status}</h2>
      <p>
        <strong>{statusLabel}</strong>
        {
          projectField(entry, "currentState", lang) && (
            <>
              {" — "}
              {projectField(entry, "currentState", lang)}
            </>
          )
        }
      </p>
    </section>

    {
      proofs.length > 0 && (
        <section class="stack gap-3">
          <h2>{labels.proofs}</h2>
          <EvidenceList evidence={proofs} lang={lang} />
        </section>
      )
    }

    {
      relatedItems.length > 0 && (
        <section class="stack gap-3">
          <h2>{labels.related}</h2>
          <ul class="related">
            {relatedItems.map((item) => (
              <li>
                <a href={item.href}>{item.title}</a>
                <p>{item.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      publicHref && (
        <footer class="entity-links">
          {entry.data.repository && (
            <a
              class="btn-primary"
              href={entry.data.repository}
              target="_blank"
              rel="noopener noreferrer"
            >
              {labels.repositoryLink}
            </a>
          )}
          {entry.data.website && entry.data.website !== entry.data.repository && (
            <a
              class="btn-secondary"
              href={entry.data.website}
              target="_blank"
              rel="noopener noreferrer"
            >
              {labels.entityLink}
            </a>
          )}
          {!entry.data.repository && !entry.data.website && entry.data.proofLinks[0] && (
            <a
              class="btn-primary"
              href={entry.data.proofLinks[0]}
              target="_blank"
              rel="noopener noreferrer"
            >
              {labels.open}
            </a>
          )}
        </footer>
      )
    }
  </main>
</BaseLayout>

<style>
  .hero {
    max-width: 72ch;
  }
  .list {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-2);
    color: var(--color-fg-muted);
  }
  .tech {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.55rem;
  }
  .related {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .related a {
    color: var(--color-fg);
    font-weight: 600;
    text-decoration: none;
  }
  .related a:hover {
    text-decoration: underline;
  }
  .related p {
    margin: var(--space-1) 0 0;
    color: var(--color-fg-subtle);
    font-size: var(--text-sm);
  }
  .entity-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
  }
</style>
