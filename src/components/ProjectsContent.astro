---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { isPortfolioProject, projectsPageConfig } from "../config/projects-page.ts";
import { getPublishableEntries } from "../lib/publication-policy.ts";
import { sortProjects } from "../lib/projects-i18n.ts";
import { getSortedGitHubProjects } from "../lib/github-projects.ts";
import {
  breadcrumbJsonLd,
  buildJsonLdGraph,
  collectionPageJsonLd,
  personJsonLd,
  softwareSourceCodeJsonLd,
} from "../lib/json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const projectsPath = `${prefix}/projects/`;
const config = projectsPageConfig;

const projects = sortProjects(
  getPublishableEntries(await getCollection("projects")).filter(isPortfolioProject)
);

const featuredSlugs = new Set(projects.map((p) => p.id));
const otherRepos = getSortedGitHubProjects(lang).filter(
  (repo) => !repo.relatedProjectSlug || !featuredSlugs.has(repo.relatedProjectSlug)
);
const labels = config.labels;

const jsonLd = buildJsonLdGraph([
  personJsonLd(),
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path: projectsPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: config.meta.title[lang], path: projectsPath },
  ]),
  ...otherRepos.map((repo) =>
    softwareSourceCodeJsonLd({
      name: repo.name[lang],
      description: repo.problem[lang],
      codeRepository: repo.htmlUrl,
      programmingLanguage: repo.language,
      license: repo.license,
      url: projectsPath,
    })
  ),
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={projectsPath}
  alternates={[
    { lang: "fr", href: "/projects/" },
    { lang: "en", href: "/en/projects/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper stack gap-12">
    <section class="stack gap-4 page-hero">
      <p class="eyebrow">{config.meta.eyebrow[lang]}</p>
      <h1>{config.meta.title[lang]}</h1>
      <p class="lede">{config.meta.intro[lang]}</p>
    </section>

    <section class="stack gap-4" aria-labelledby="featured-title">
      <h2 id="featured-title">{labels.featured[lang]}</h2>
      {
        projects.length > 0 ? (
          <div class="grid-auto">
            {projects.map((project) => (
              <ProjectCard entry={project} lang={lang} />
            ))}
          </div>
        ) : (
          <p class="muted">{labels.empty[lang]}</p>
        )
      }
    </section>

    {
      otherRepos.length > 0 && (
        <section class="stack gap-4" aria-labelledby="other-title">
          <h2 id="other-title">{labels.other[lang]}</h2>
          <ul class="contrib-list">
            {otherRepos.map((repo) => (
              <li>
                <a href={repo.htmlUrl} target="_blank" rel="noopener noreferrer">
                  {repo.name[lang]}
                </a>
                <span class="meta"> — {repo.problem[lang]}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .muted {
    color: var(--color-fg-subtle);
  }
  .contrib-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
  }
  .contrib-list a {
    font-weight: 600;
    color: var(--color-fg);
    text-decoration: none;
  }
  .contrib-list a:hover {
    text-decoration: underline;
  }
  .meta {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }
</style>
