---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { isPortfolioProject, projectsPageConfig } from "../config/projects-page.ts";
import { getPublishableEntries } from "../lib/publication-policy.ts";
import { sortProjects } from "../lib/projects-i18n.ts";
import { getSortedGitHubProjects } from "../lib/github-projects.ts";
import { analyticsAttrs } from "../lib/analytics.ts";
import "../styles/editorial-pages.css";
import {
  breadcrumbJsonLd,
  buildJsonLdGraph,
  collectionPageJsonLd,
  personJsonLd,
  softwareSourceCodeJsonLd,
} from "../lib/json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const projectsPath = prefix + "/projects/";
const contactPath = prefix + "/contact/";
const thinkingPath = prefix + "/thinking/";
const config = projectsPageConfig;
const labels = config.labels;

const projects = sortProjects(
  getPublishableEntries(await getCollection("projects")).filter(isPortfolioProject)
);
const featuredSlugs = new Set(projects.map((project) => project.id));
const otherRepos = getSortedGitHubProjects(lang).filter(
  (repo) => !repo.relatedProjectSlug || !featuredSlugs.has(repo.relatedProjectSlug)
);

const jsonLd = buildJsonLdGraph([
  personJsonLd(),
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path: projectsPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: config.meta.title[lang], path: projectsPath },
  ]),
  ...otherRepos.map((repo) =>
    softwareSourceCodeJsonLd({
      name: repo.name[lang],
      description: repo.problem[lang],
      codeRepository: repo.htmlUrl,
      programmingLanguage: repo.language,
      license: repo.license,
      url: projectsPath,
    })
  ),
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={projectsPath}
  alternates={[
    { lang: "fr", href: "/projects/" },
    { lang: "en", href: "/en/projects/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="editorial-page ed-projects">
    <header class="ed-band--dark ed-hero">
      <div class="ed-shell ed-hero__grid">
        <div>
          <p class="ed-kicker">{config.meta.eyebrow[lang]}</p>
          <h1 class="ed-title">
            {config.meta.title[lang]}
            <span class="ed-title__accent">{config.meta.headline[lang]}</span>
          </h1>
          <p class="ed-lede">{config.meta.intro[lang]}</p>
        </div>
        <aside class="ed-hero__aside">
          <p class="ed-aside__label">{config.meta.asideLabel[lang]}</p>
          <p>{config.meta.aside[lang]}</p>
          <a class="ed-aside__link" href={thinkingPath}>
            {config.meta.asideLink[lang]}
            <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>
    </header>

    <section class="ed-band--light ed-section" aria-labelledby="featured-title">
      <div class="ed-shell">
        <div class="ed-section__head">
          <h2 id="featured-title">{labels.featured[lang]}</h2>
          <p>{config.meta.featuredIntro[lang]}</p>
        </div>
        {
          projects.length > 0 ? (
            <div class="ed-project-grid">
              {projects.map((project) => (
                <ProjectCard entry={project} lang={lang} />
              ))}
            </div>
          ) : (
            <p>{labels.empty[lang]}</p>
          )
        }
      </div>
    </section>

    <section class="ed-band--dark ed-section" aria-labelledby="reports-title">
      <div class="ed-shell">
        <div class="ed-section__head">
          <p class="ed-kicker">{config.meta.eyebrow[lang]}</p>
          <h2 id="reports-title">{config.meta.fieldReportsTitle[lang]}</h2>
          <p>{config.meta.fieldReportsIntro[lang]}</p>
        </div>
        <div class="ed-reports">
          {
            config.meta.fieldReports.map((report) => (
              <article class="ed-report">
                <p class="ed-report__label">{report.label[lang]}</p>
                <h3>{report.title[lang]}</h3>
                <p>{report.description[lang]}</p>
                <a
                  class="ed-text-link"
                  href={report.href}
                  {...analyticsAttrs("cta_project_open", {
                    surface: "projects",
                    intent: "field-report",
                    lang,
                  })}
                >
                  {lang === "fr" ? "Lire le retour de terrain" : "Read the field report (FR)"}
                  <span aria-hidden="true"> ↗</span>
                </a>
              </article>
            ))
          }
        </div>
        <p class="ed-note">{config.meta.fieldReportsNote[lang]}</p>
        {
          otherRepos.length > 0 && (
            <details class="ed-contrib">
              <summary>
                {labels.other[lang]} ({otherRepos.length})
              </summary>
              <ul class="ed-contrib__list">
                {otherRepos.map((repo) => (
                  <li>
                    <a href={repo.htmlUrl} target="_blank" rel="noopener noreferrer">
                      {repo.name[lang]} <span aria-hidden="true">↗</span>
                    </a>
                    <span class="ed-contrib__desc">{repo.problem[lang]}</span>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </div>
    </section>

    <section class="ed-band--light ed-section" aria-labelledby="projects-contact-title">
      <div class="ed-shell ed-cta">
        <div class="ed-cta__text">
          <h2 id="projects-contact-title">{config.meta.contactTitle[lang]}</h2>
          <p>{config.meta.contactBody[lang]}</p>
        </div>
        <a
          class="ed-button"
          href={contactPath}
          {...analyticsAttrs("cta_contact_email", {
            surface: "projects",
            intent: "qualification",
            lang,
          })}
        >
          {config.meta.contactLabel[lang]}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
