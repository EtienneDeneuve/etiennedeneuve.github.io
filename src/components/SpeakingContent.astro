---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSortedSpeakingTopics, mediaKitConfig, speakingPageConfig } from "../config/speaking.ts";
import { siteConfig } from "../config/site.ts";
import {
  breadcrumbJsonLd,
  buildJsonLdGraph,
  collectionPageJsonLd,
  eventJsonLd,
  personJsonLd,
} from "../lib/json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const config = speakingPageConfig;
const topics = getSortedSpeakingTopics();

const allAppearances = await getCollection("appearances");
const appearances = allAppearances
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const resourcesById = new Map((await getCollection("resources")).map((entry) => [entry.id, entry]));
const mediaParticipations = config.mediaResourceIds
  .map((id) => resourcesById.get(id))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const labels = Object.fromEntries(
  Object.entries(config.labels).map(([key, value]) => [key, value[lang]])
) as Record<keyof typeof config.labels, string>;

function localizeHref(href: string): string {
  if (href.startsWith("http") || lang === "fr") return href;
  if (href.startsWith("/en/")) return href;
  if (href.startsWith("/")) return `/en${href}`;
  return href;
}

function localizedAppearanceField(
  entry: (typeof appearances)[number],
  field: "title" | "event" | "topic" | "location"
): string {
  const data = entry.data as Record<string, unknown>;
  const enKey = `${field}_en`;
  if (lang === "en" && typeof data[enKey] === "string") {
    return data[enKey] as string;
  }
  return String(data[field] ?? "");
}

function formatAppearanceDate(date: Date): string {
  return date.toLocaleDateString(lang === "en" ? "en-GB" : "fr-FR", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const emailSubject = config.cta.emailSubject[lang];
const mailtoLink = `mailto:${siteConfig.omnivya.email}?subject=${encodeURIComponent(emailSubject)}`;
const speakingPath = `${prefix}/speaking/`;

const jsonLd = buildJsonLdGraph([
  personJsonLd(),
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path: speakingPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: config.meta.title[lang], path: speakingPath },
  ]),
  ...appearances.map((entry) =>
    eventJsonLd({
      name: `${localizedAppearanceField(entry, "title")} : ${localizedAppearanceField(entry, "event")}`,
      description: localizedAppearanceField(entry, "topic"),
      startDate: entry.data.date,
      location: localizedAppearanceField(entry, "location"),
      url: entry.data.url ?? entry.data.videoUrl ?? entry.data.proofUrl,
      eventAttendanceMode: entry.data.location.toLowerCase().includes("online")
        ? "OnlineEventAttendanceMode"
        : "OfflineEventAttendanceMode",
    })
  ),
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={speakingPath}
  alternates={[
    { lang: "fr", href: "/speaking/" },
    { lang: "en", href: "/en/speaking/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper stack gap-12">
    <section class="stack gap-4 hero">
      <h1>{config.meta.title[lang]}</h1>
      <p class="lead">{config.meta.positioning[lang]}</p>
    </section>

    {
      appearances.length > 0 && (
        <section class="stack gap-4" id="appearances">
          <h2>{config.meta.appearancesTitle[lang]}</h2>
          <div class="appearances-list stack gap-3">
            {appearances.map((entry) => (
              <article class="appearance-card">
                <header>
                  <h3>{localizedAppearanceField(entry, "title")}</h3>
                  <p class="appearance-event">
                    {localizedAppearanceField(entry, "event")} :{" "}
                    {formatAppearanceDate(entry.data.date)}
                  </p>
                  <p class="appearance-meta">
                    {localizedAppearanceField(entry, "location")} ·{" "}
                    {localizedAppearanceField(entry, "topic")}
                  </p>
                </header>
                <div class="proof-links">
                  {entry.data.url && (
                    <a href={entry.data.url} target="_blank" rel="noopener noreferrer">
                      {labels.proofArticle}
                    </a>
                  )}
                  {entry.data.videoUrl && (
                    <a href={entry.data.videoUrl} target="_blank" rel="noopener noreferrer">
                      {labels.proofVideo}
                    </a>
                  )}
                  {entry.data.slidesUrl && (
                    <a href={entry.data.slidesUrl} target="_blank" rel="noopener noreferrer">
                      {labels.proofSlides}
                    </a>
                  )}
                  {entry.data.proofUrl && entry.data.proofUrl !== entry.data.url && (
                    <a href={entry.data.proofUrl} target="_blank" rel="noopener noreferrer">
                      {entry.data.type === "podcast" ? labels.proofPodcast : labels.proofEvent}
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      mediaParticipations.length > 0 && (
        <section
          class="stack gap-4"
          id="media-participations"
          aria-labelledby="media-participations-title"
        >
          <h2 id="media-participations-title">{config.meta.mediaParticipationsTitle[lang]}</h2>
          <div class="appearances-list stack gap-3">
            {mediaParticipations.map((entry) => {
              const title =
                lang === "en" && entry.data.title_en ? entry.data.title_en : entry.data.title;
              const body =
                (lang === "en" && entry.data.summary_en
                  ? entry.data.summary_en
                  : entry.data.summary) || entry.data.description;
              return (
                <article class="appearance-card" id={entry.id.toLowerCase()}>
                  <header>
                    <h3>{title}</h3>
                    <p class="appearance-meta">{body}</p>
                  </header>
                  {entry.data.indexLinks.length > 0 && (
                    <div class="proof-links">
                      {entry.data.indexLinks
                        .filter((link) => !link.href.startsWith("/speaking"))
                        .map((link) => (
                          <a
                            href={localizeHref(link.href)}
                            target={link.href.startsWith("http") ? "_blank" : undefined}
                            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                          >
                            {lang === "en" && link.label_en ? link.label_en : link.label}
                          </a>
                        ))}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      )
    }

    <section class="stack gap-4" id="topics">
      <header class="stack gap-2">
        <h2>{config.meta.topicsTitle[lang]}</h2>
        <p class="intro">{config.meta.topicsIntro[lang]}</p>
      </header>
      <ul class="topics-compact">
        {
          topics.map((topic) => (
            <li>
              <h3>{topic.title[lang]}</h3>
              <p>{topic.problem[lang]}</p>
              <p class="topic-audience">
                {labels.audience}: {topic.audience[lang]}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="stack gap-4" id="media-kit">
      <header class="stack gap-2">
        <h2>{config.meta.mediaKitTitle[lang]}</h2>
        <p class="intro">{config.meta.mediaKitIntro[lang]}</p>
      </header>
      <div class="media-kit-grid">
        <div class="photo-block">
          <img
            src={mediaKitConfig.photo.src}
            alt={mediaKitConfig.photo.alt[lang]}
            width={mediaKitConfig.photo.width}
            height={mediaKitConfig.photo.height}
            loading="lazy"
            decoding="async"
            class="headshot"
          />
          <a
            href={mediaKitConfig.photo.fullSrc}
            download={mediaKitConfig.photo.downloadFilename}
            class="photo-download"
          >
            {labels.downloadPhoto}
          </a>
        </div>
        <div class="bio-block stack gap-4">
          <div>
            <h3>{labels.shortBio}</h3>
            <p>{mediaKitConfig.shortBio[lang]}</p>
          </div>
          <div>
            <h3>{labels.languages}</h3>
            <p>{mediaKitConfig.languages[lang]}</p>
          </div>
          <div>
            <h3>{labels.contact}</h3>
            <p>
              <a href={`mailto:${siteConfig.omnivya.email}`}>{siteConfig.omnivya.email}</a>
            </p>
          </div>
        </div>
      </div>
      <div class="media-kit-downloads actions">
        <a class="btn-primary" href="/media-kit.html" target="_blank" rel="noopener noreferrer">
          {labels.downloadHtml}
        </a>
        <a class="btn-secondary" href="/media-kit.pdf" download>
          {labels.downloadPdf}
        </a>
      </div>
    </section>

    <section class="cta-section stack gap-3">
      <h2>{config.meta.ctaTitle[lang]}</h2>
      <p>{config.meta.ctaBody[lang]}</p>
      <div class="actions">
        <a class="btn-primary" href={mailtoLink}>
          {labels.emailCta}
        </a>
        <a class="btn-secondary" href={`${prefix}/contact/`}>
          {labels.contact}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    max-width: 72ch;
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
    margin: 0;
    line-height: 1.6;
  }
  .intro {
    margin: 0;
    color: var(--color-fg-muted);
    max-width: 72ch;
  }
  .topics-compact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
  }
  .topics-compact h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-md);
  }
  .topics-compact p {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: 1.5;
  }
  .topic-audience {
    margin-top: var(--space-1) !important;
    font-size: var(--text-sm);
    color: var(--color-fg-subtle) !important;
  }
  .topic-card {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    background: var(--color-bg-elevated);
  }
  .topic-card h3 {
    margin: 0 0 0.75rem;
    font-size: var(--text-lg);
  }
  .topic-meta {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  @media (min-width: 50em) {
    .topic-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .topic-meta dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-fg-subtle);
    margin-bottom: 0.15rem;
  }
  .topic-meta dd {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: 1.5;
  }
  .topic-meta ul,
  .bio-block ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .pill {
    font-size: var(--text-xs);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.15rem 0.55rem;
    color: var(--color-fg-muted);
  }
  .related-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .related-links a {
    color: var(--color-fg);
  }
  .formats-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 50em) {
    .formats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .format-card {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem;
    background: var(--color-bg-elevated);
  }
  .format-card h3 {
    margin: 0 0 0.35rem;
    font-size: var(--text-md);
  }
  .format-card p {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }
  .appearance-card {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.15rem;
    background: var(--color-bg-elevated);
  }
  .appearance-card h3 {
    margin: 0 0 0.25rem;
    font-size: var(--text-md);
  }
  .appearance-event {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }
  .appearance-meta {
    margin: 0.25rem 0 0.75rem;
    color: var(--color-fg-subtle);
    font-size: var(--text-xs);
  }
  .proof-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .proof-links a {
    color: var(--color-fg);
    font-size: var(--text-sm);
    text-decoration: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.2rem 0.65rem;
  }
  .proof-links a:hover {
    border-color: var(--accent-regular);
  }
  .media-kit-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 50em) {
    .media-kit-grid {
      grid-template-columns: 160px 1fr;
      gap: 2rem;
    }
  }
  .photo-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .headshot {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--gray-800);
  }
  .photo-download {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }
  .bio-block h3 {
    margin: 0 0 0.35rem;
    font-size: var(--text-md);
  }
  .bio-block p {
    margin: 0 0 0.65rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
  }
  .social-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .media-kit-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .cta-section {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    max-width: 72ch;
  }
</style>
