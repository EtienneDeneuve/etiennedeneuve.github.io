---
import Icon from "./Icon.astro";
---

<theme-toggle transition:persist="theme-toggle">
  <button type="button">
    <span class="sr-only">Toggle theme</span>
    <span class="icon light"><Icon icon="sun" /></span>
    <span class="icon dark"><Icon icon="moon-stars" /></span>
  </button>
</theme-toggle>

<style>
  button {
    display: flex;
    border: var(--border-width-strong) solid var(--color-fg);
    border-radius: var(--radius-md);
    padding: 0;
    background-color: transparent;
    cursor: pointer;
  }

  .icon {
    z-index: 1;
    position: relative;
    display: flex;
    padding: 0.45rem;
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
    color: var(--color-fg-muted);
  }

  .icon.light::before {
    content: "";
    z-index: -1;
    position: absolute;
    inset: 0;
    background-color: var(--accent-regular);
  }

  :global(.theme-dark) .icon.light::before {
    transform: translateX(100%);
  }

  :global(.theme-dark) .icon.dark,
  :global(html:not(.theme-dark)) .icon.light,
  button[aria-pressed="false"] .icon.light {
    color: var(--accent-text-over);
  }

  @media (prefers-reduced-motion: no-preference) {
    .icon,
    .icon.light::before {
      transition:
        transform var(--theme-transition),
        color var(--theme-transition);
    }
  }

  @media (forced-colors: active) {
    .icon.light::before {
      background-color: SelectedItem;
    }
  }
</style>

<script>
  class ThemeToggle extends HTMLElement {
    #button: HTMLButtonElement | null = null;
    #bound = false;
    #onClick = () => {
      const next = !this.#isDark();
      try {
        localStorage.setItem("theme", next ? "dark" : "light");
      } catch {
        /* private mode */
      }
      this.#paint(next);
    };

    connectedCallback() {
      this.#button = this.querySelector("button");
      if (!this.#button) return;
      if (!this.#bound) {
        this.#button.addEventListener("click", this.#onClick);
        this.#bound = true;
      }
      // Always prefer stored preference — never infer from a mid-swap DOM class.
      this.#paint(this.#prefersDark());
    }

    #prefersDark() {
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || stored === "light") return stored === "dark";
      } catch {
        /* private mode */
      }
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    #isDark() {
      return document.documentElement.classList.contains("theme-dark");
    }

    #paint(dark: boolean) {
      document.documentElement.classList.toggle("theme-dark", dark);
      document.documentElement.classList.toggle("cc--darkmode", dark);
      document.documentElement.style.colorScheme = dark ? "dark" : "light";
      this.#button?.setAttribute("aria-pressed", String(dark));
    }
  }

  if (!customElements.get("theme-toggle")) {
    customElements.define("theme-toggle", ThemeToggle);
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("theme-toggle").forEach((el) => {
      if (el instanceof ThemeToggle) el.connectedCallback();
    });
  });
</script>
