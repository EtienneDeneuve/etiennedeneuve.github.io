---
import Icon from "./Icon.astro";
---

<theme-toggle>
  <button type="button">
    <span class="sr-only">Toggle theme</span>
    <span class="icon light"><Icon icon="sun" /></span>
    <span class="icon dark"><Icon icon="moon-stars" /></span>
  </button>
</theme-toggle>

<style>
  button {
    display: flex;
    border: var(--border-width-strong) solid var(--color-fg);
    border-radius: var(--radius-md);
    padding: 0;
    background-color: transparent;
    cursor: pointer;
  }

  .icon {
    z-index: 1;
    position: relative;
    display: flex;
    padding: 0.45rem;
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
    color: var(--color-fg-muted);
  }

  .icon.light::before {
    content: "";
    z-index: -1;
    position: absolute;
    inset: 0;
    background-color: var(--accent-regular);
  }

  :global(.theme-dark) .icon.light::before {
    transform: translateX(100%);
  }

  :global(.theme-dark) .icon.dark,
  :global(html:not(.theme-dark)) .icon.light,
  button[aria-pressed="false"] .icon.light {
    color: var(--accent-text-over);
  }

  @media (prefers-reduced-motion: no-preference) {
    .icon,
    .icon.light::before {
      transition:
        transform var(--theme-transition),
        color var(--theme-transition);
    }
  }

  @media (forced-colors: active) {
    .icon.light::before {
      background-color: SelectedItem;
    }
  }
</style>

<script>
  // @ts-nocheck
  class ThemeToggle extends HTMLElement {
    constructor() {
      super();

      const button = this.querySelector("button");
      if (!button) return;

      /** @param {boolean} dark */
      const setTheme = (dark) => {
        document.documentElement.classList[dark ? "add" : "remove"]("theme-dark", "cc--darkmode");
        button.setAttribute("aria-pressed", String(dark));
      };

      button.addEventListener("click", () => setTheme(!this.isDark()));
      setTheme(this.isDark());
    }

    isDark() {
      return document.documentElement.classList.contains("theme-dark");
    }
  }
  customElements.define("theme-toggle", ThemeToggle);
</script>
