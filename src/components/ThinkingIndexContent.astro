---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThinkingFilters from "../components/ThinkingFilters.astro";
import { thinkingConfig } from "../config/thinking.ts";
import {
  articlesForLocale,
  formatArticleDate,
  getAllThinkingArticles,
  getArticleLanguage,
  getArticlePath,
  getCanonicalSlug,
  getContentTypeLabel,
  getEntryTags,
  getQualifyingTags,
  isFeatured,
  listPublishedSeries,
  selectOpeningArticles,
  slugifyTag,
  sortArticles,
  type ThinkingContentType,
  type ThinkingPillar,
} from "../lib/thinking.ts";
import { breadcrumbJsonLd, buildJsonLdGraph, collectionPageJsonLd } from "../lib/json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const thinkingPath = `${prefix}/thinking/`;
const config = thinkingConfig;
const labels = config.labels;

/**
 * Static build (GitHub Pages): Astro.url.searchParams is empty at generate time.
 * Render the full library with data-* attributes and apply filters in the browser.
 * Default (no JS / no query): UI locale only, opening shelf visible, opening rows hidden
 * in the library to avoid duplicates.
 */
const defaultSort = "recent" as const;
const allArticles = await getAllThinkingArticles();
const localeArticles = articlesForLocale(allArticles, lang);
const { lead, side } = selectOpeningArticles(localeArticles, config.openingSideCount);
const openingIds = new Set([lead, ...side].filter(Boolean).map((entry) => entry!.id));
const libraryArticles = sortArticles(allArticles, defaultSort);
const defaultVisibleCount = libraryArticles.filter(
  (entry) => getArticleLanguage(entry) === lang && !openingIds.has(entry.id)
).length;
const series = listPublishedSeries(localeArticles, lang);
const qualifyingTags = getQualifyingTags(allArticles);

const jsonLd = buildJsonLdGraph([
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path: thinkingPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: config.meta.title[lang], path: thinkingPath },
  ]),
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={thinkingPath}
  alternates={[
    { lang: "fr", href: "/thinking/" },
    { lang: "en", href: "/en/thinking/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="thinking">
    <section class="thinking-band thinking-band--dark thinking-hero">
      <div class="thinking-shell thinking-hero__grid">
        <div class="thinking-hero__present">
          <p class="thinking-eyebrow">{config.meta.title[lang]}</p>
          <h1 class="thinking-title">
            {
              lang === "fr" ? (
                <>
                  Décisions <span>&amp; retours</span>
                  <br />
                  de terrain
                </>
              ) : (
                <>
                  Decisions <span>&amp; field</span>
                  <br />
                  notes
                </>
              )
            }
          </h1>
          <p class="thinking-tagline">{config.meta.intro[lang]}</p>
          <p class="thinking-lede">{config.meta.description[lang]}</p>
          <a class="thinking-rss" href="/rss.xml">{labels.rss[lang]} →</a>
        </div>

        {
          lead && (
            <aside
              class="thinking-pubs"
              aria-labelledby="thinking-opening-title"
              data-opening-section
            >
              <div class="thinking-pubs__head">
                <h2 id="thinking-opening-title">{labels.opening[lang]}</h2>
                <a class="thinking-pubs__all" href="#bibliotheque">
                  {labels.openingAll[lang]} <span aria-hidden="true">→</span>
                </a>
              </div>
              <article class="thinking-pubs__featured">
                <a href={getArticlePath(getCanonicalSlug(lead), getArticleLanguage(lead))}>
                  <time datetime={lead.data.pubDate.toISOString()}>
                    {formatArticleDate(lead.data.pubDate, lang)}
                  </time>
                  <span class="thinking-pubs__title">{lead.data.title}</span>
                  {lead.data.description && (
                    <span class="thinking-pubs__desc">{lead.data.description}</span>
                  )}
                  <span class="thinking-pubs__read">
                    {labels.readAnalysis[lang]} <span aria-hidden="true">→</span>
                  </span>
                </a>
              </article>
              {side.length > 0 && (
                <ol class="thinking-pubs__list">
                  {side.map((entry) => (
                    <li>
                      <a href={getArticlePath(getCanonicalSlug(entry), getArticleLanguage(entry))}>
                        <time datetime={entry.data.pubDate.toISOString()}>
                          {formatArticleDate(entry.data.pubDate, lang)}
                        </time>
                        <span class="thinking-pubs__title">{entry.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </aside>
          )
        }
      </div>
    </section>

    {
      series.length > 0 && (
        <section
          class="thinking-band thinking-band--light thinking-series"
          aria-labelledby="thinking-series-title"
          data-series-section
        >
          <div class="thinking-shell">
            <p class="thinking-eyebrow thinking-eyebrow--light">{labels.seriesEyebrow[lang]}</p>
            <h2 id="thinking-series-title">{labels.series[lang]}</h2>
            <div class="thinking-series__grid">
              {series.map((item) => {
                const entryLang = getArticleLanguage(item.entry);
                const href = getArticlePath(getCanonicalSlug(item.entry), entryLang);
                const countLabel =
                  item.publishedCount === 1
                    ? labels.publishedCount[lang]
                    : labels.publishedCountPlural[lang];
                return (
                  <article class="thinking-serie">
                    <a href={href}>
                      <span class="thinking-serie__n">
                        {item.total} {labels.textsCount[lang]} · {item.publishedCount} {countLabel}
                      </span>
                      <span class="thinking-serie__name">{item.title[lang]}</span>
                      <span class="thinking-serie__hint">{item.hint[lang]}</span>
                    </a>
                  </article>
                );
              })}
            </div>
          </div>
        </section>
      )
    }

    <section class="thinking-band thinking-band--dark thinking-library" id="bibliotheque">
      <div class="thinking-shell">
        <div class="thinking-library__head">
          <h2>{labels.library[lang]}</h2>
          <div class="thinking-library__tools">
            <p class="thinking-library__count">
              <span data-library-count aria-live="polite">{defaultVisibleCount}</span>{" "}
              {labels.articlesCount[lang]}
            </p>
            <details class="thinking-filters-panel">
              <summary>{labels.filtersToggle[lang]}</summary>
              <div class="thinking-filters-panel__body">
                <ThinkingFilters
                  lang={lang}
                  prefix={prefix}
                  current={{ sort: defaultSort, language: lang }}
                  tagOptions={qualifyingTags}
                />
              </div>
            </details>
          </div>
        </div>

        <div
          class="thinking-rows"
          id="thinking-library-grid"
          data-library-grid
          data-library-page-size={config.libraryPageSize}
        >
          {
            libraryArticles.map((entry) => {
              const articleLang = getArticleLanguage(entry);
              const isOpening = openingIds.has(entry.id);
              const defaultHidden = isOpening || articleLang !== lang;
              const pillar = entry.data.pillar as ThinkingPillar;
              const contentType = entry.data.contentType as ThinkingContentType;
              const tagSlugs = getEntryTags(entry).map(slugifyTag).join(" ");
              const publishedAt = new Date(entry.data.pubDate).toISOString();
              const editorialRank = (config.featuredSlugs as readonly string[]).indexOf(entry.id);
              const featuredRank = isFeatured(entry)
                ? editorialRank >= 0
                  ? editorialRank
                  : 999
                : -1;
              return (
                <article
                  class="thinking-row"
                  data-pillar={pillar}
                  data-type={contentType}
                  data-lang={articleLang}
                  data-tags={tagSlugs}
                  data-date={publishedAt}
                  data-title={entry.data.title.toLocaleLowerCase(articleLang)}
                  data-opening={isOpening ? "true" : undefined}
                  data-featured-rank={featuredRank}
                  hidden={defaultHidden || undefined}
                >
                  <a href={getArticlePath(getCanonicalSlug(entry), articleLang)}>
                    <time datetime={publishedAt}>
                      {formatArticleDate(entry.data.pubDate, lang)}
                    </time>
                    <span class="thinking-rows__title">{entry.data.title}</span>
                    <span class="thinking-rows__type">
                      {getContentTypeLabel(contentType, lang)}
                    </span>
                  </a>
                </article>
              );
            })
          }
        </div>
        <div class="thinking-library__pagination" data-library-pagination hidden>
          <p class="thinking-library__progress" data-library-progress aria-live="polite">
            <span data-library-shown></span> / <span data-library-total></span>{" "}
            {lang === "fr" ? "articles affichés" : "articles shown"}
          </p>
          <button
            class="thinking-library__more"
            type="button"
            data-library-more
            aria-controls="thinking-library-grid"
            hidden
          >
            {labels.seeMore[lang]} →
          </button>
        </div>
        <p class="thinking-empty" data-library-empty hidden>
          {
            lang === "en"
              ? "No article matches these filters."
              : "Aucun article ne correspond à ces filtres."
          }
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

{/* Static GH Pages: filter, sort and paginate released articles in the browser. */}
<script>
  const FILTER_FIELDS = ["pillar", "type", "lang", "sort", "tag"] as const;
  let thinkingFiltersCleanup: (() => void) | undefined;

  function initThinkingLibraryFilters(): void {
    thinkingFiltersCleanup?.();
    thinkingFiltersCleanup = undefined;

    const form = document.querySelector("form.filters");
    const grid = document.querySelector("[data-library-grid]");
    const countEl = document.querySelector("[data-library-count]");
    const emptyEl = document.querySelector("[data-library-empty]");
    const openingSection = document.querySelector("[data-opening-section]");
    const seriesSection = document.querySelector("[data-series-section]");
    const pagination = document.querySelector("[data-library-pagination]");
    const progressEl = document.querySelector("[data-library-progress]");
    const shownEl = document.querySelector("[data-library-shown]");
    const totalEl = document.querySelector("[data-library-total]");
    const moreButton = document.querySelector("[data-library-more]");
    if (!(form instanceof HTMLFormElement) || !(grid instanceof HTMLElement)) return;

    const uiLang = form.getAttribute("data-ui-lang") === "en" ? "en" : "fr";
    const pageSize = Number(grid.dataset.libraryPageSize) || 12;
    const cards = [...grid.querySelectorAll<HTMLElement>(":scope > article")];
    const buildOrder = cards.slice();
    let visibleLimit = pageSize;

    const getSelect = (name: string): HTMLSelectElement | null => {
      const field = form.elements.namedItem(name);
      return field instanceof HTMLSelectElement ? field : null;
    };

    const readFilters = (): URLSearchParams => {
      const params = new URLSearchParams();
      for (const name of FILTER_FIELDS) {
        const value = getSelect(name)?.value ?? "";
        if (!value) continue;
        if (name === "sort" && value === "recent") continue;
        if (name === "lang" && value === uiLang) continue;
        params.set(name, value);
      }
      return params;
    };

    const dateNewestFirst = (a: HTMLElement, b: HTMLElement): number =>
      (b.dataset.date ?? "").localeCompare(a.dataset.date ?? "");

    const featuredFirst = (a: HTMLElement, b: HTMLElement): number => {
      const rankA = Number(a.dataset.featuredRank ?? -1);
      const rankB = Number(b.dataset.featuredRank ?? -1);
      if ((rankA >= 0) !== (rankB >= 0)) return Number(rankB >= 0) - Number(rankA >= 0);
      if (rankA >= 0 && rankB >= 0 && rankA !== rankB) return rankA - rankB;
      return dateNewestFirst(a, b);
    };

    const applyFilters = (): void => {
      const params = readFilters();
      const pillar = params.get("pillar");
      const type = params.get("type");
      const tag = params.get("tag");
      const sort = params.get("sort") ?? "recent";
      const langParam = params.get("lang");
      const languageScope =
        langParam === "all" || langParam === "fr" || langParam === "en" ? langParam : uiLang;
      const hasActiveFilters = Boolean(
        pillar || type || tag || langParam === "all" || (langParam && langParam !== uiLang)
      );

      const ordered =
        sort === "oldest"
          ? [...buildOrder].sort((a, b) =>
              (a.dataset.date ?? "").localeCompare(b.dataset.date ?? "")
            )
          : sort === "title"
            ? [...buildOrder].sort((a, b) =>
                (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "", uiLang)
              )
            : sort === "featured"
              ? [...buildOrder].sort(featuredFirst)
              : [...buildOrder].sort(dateNewestFirst);
      for (const card of ordered) grid.append(card);

      const matching = ordered.filter((card) => {
        const tags = (card.dataset.tags ?? "").split(" ").filter(Boolean);
        const langOk = languageScope === "all" || card.dataset.lang === languageScope;
        return (
          langOk &&
          (!pillar || card.dataset.pillar === pillar) &&
          (!type || card.dataset.type === type) &&
          (!tag || tags.includes(tag)) &&
          (hasActiveFilters || card.dataset.opening !== "true")
        );
      });
      const matches = new Set(matching);
      const shown = Math.min(visibleLimit, matching.length);
      const displayed = new Set(matching.slice(0, shown));
      for (const card of cards) card.hidden = !displayed.has(card);

      if (openingSection instanceof HTMLElement) openingSection.hidden = hasActiveFilters;
      if (seriesSection instanceof HTMLElement) seriesSection.hidden = hasActiveFilters;
      if (countEl) countEl.textContent = String(matching.length);
      if (emptyEl instanceof HTMLElement) emptyEl.hidden = matching.length > 0;
      if (pagination instanceof HTMLElement) pagination.hidden = matching.length <= pageSize;
      if (progressEl instanceof HTMLElement) progressEl.hidden = matching.length <= pageSize;
      if (shownEl) shownEl.textContent = String(shown);
      if (totalEl) totalEl.textContent = String(matching.length);
      if (moreButton instanceof HTMLButtonElement) moreButton.hidden = shown >= matching.length;
    };

    const syncFormFromUrl = (): void => {
      const params = new URLSearchParams(window.location.search);
      for (const name of FILTER_FIELDS) {
        const select = getSelect(name);
        if (!select) continue;
        if (name === "lang") select.value = params.get("lang") ?? uiLang;
        else if (name === "sort") select.value = params.get("sort") ?? "recent";
        else select.value = params.get(name) ?? "";

        if (select.selectedIndex === -1) {
          select.value = name === "sort" ? "recent" : name === "lang" ? uiLang : "";
        }
      }
      const requested = Number(params.get("show"));
      visibleLimit =
        Number.isSafeInteger(requested) && requested > pageSize
          ? Math.min(requested, cards.length)
          : pageSize;
      applyFilters();
    };

    const updateUrl = (push: boolean): void => {
      const params = readFilters();
      if (visibleLimit > pageSize) params.set("show", String(visibleLimit));
      const query = params.toString();
      const nextUrl = `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`;
      const current = `${window.location.pathname}${window.location.search}${window.location.hash}`;
      if (nextUrl === current) return;
      if (push) window.history.pushState(window.history.state, "", nextUrl);
      else window.history.replaceState(window.history.state, "", nextUrl);
    };

    const onChange = (): void => {
      visibleLimit = pageSize;
      updateUrl(true);
      applyFilters();
    };
    const onSubmit = (event: SubmitEvent): void => {
      event.preventDefault();
      onChange();
    };
    const onMore = (): void => {
      visibleLimit = Math.min(visibleLimit + pageSize, cards.length);
      updateUrl(false);
      applyFilters();
    };

    form.addEventListener("change", onChange);
    form.addEventListener("submit", onSubmit);
    if (moreButton instanceof HTMLButtonElement) moreButton.addEventListener("click", onMore);
    window.addEventListener("popstate", syncFormFromUrl);
    syncFormFromUrl();

    thinkingFiltersCleanup = () => {
      form.removeEventListener("change", onChange);
      form.removeEventListener("submit", onSubmit);
      if (moreButton instanceof HTMLButtonElement) moreButton.removeEventListener("click", onMore);
      window.removeEventListener("popstate", syncFormFromUrl);
    };
  }

  document.addEventListener("astro:page-load", initThinkingLibraryFilters);
</script>

<style>
  .thinking {
    --thinking-max: 90rem;
    --thinking-pad: var(--page-gutter, clamp(1.5rem, 4vw, 4rem));
    --thinking-bg: var(--graphite, #111416);
    --thinking-bg-soft: var(--graphite-soft, #1b1e20);
    --thinking-ivory: #f3efe7;
    --thinking-ivory-ink: #151819;
    --thinking-ivory-muted: #454a4d;
    --thinking-ivory-border: rgba(21, 24, 25, 0.14);
    --thinking-copper: var(--copper-on-dark, #f0aa78);
    --thinking-copper-bright: #f5c49a;
    --thinking-copper-light: var(--copper-on-light, #a54822);
    --thinking-ink: var(--text-on-dark, #f7f3ec);
    --thinking-muted: var(--text-muted-on-dark, #cdd0cf);
    --thinking-border: var(--border-on-dark, rgba(243, 239, 231, 0.16));
    --thinking-sans: "Outfit", system-ui, -apple-system, "Segoe UI", sans-serif;
    --thinking-radius: 4px;
    font-family: var(--thinking-sans);
    background: var(--thinking-bg);
    color: var(--thinking-ink);
  }

  .thinking-band--dark {
    background: var(--thinking-bg);
    color: var(--thinking-ink);
  }
  /* Global h1/h2 use --color-fg (theme); force band ink so light theme
     never paints dark titles onto graphite. */
  .thinking-band--dark :global(h1),
  .thinking-band--dark :global(h2),
  .thinking-band--dark .thinking-title,
  .thinking-band--dark .thinking-rows__title,
  .thinking-band--dark .thinking-tagline,
  .thinking-band--dark .thinking-lede {
    color: var(--thinking-ink);
  }
  .thinking-band--light {
    background: var(--thinking-ivory);
    color: var(--thinking-ivory-ink);
  }
  .thinking-band--light :global(h1),
  .thinking-band--light :global(h2),
  .thinking-band--light .thinking-serie__name {
    color: var(--thinking-ivory-ink);
  }
  .thinking-band--light .thinking-serie__hint {
    color: var(--thinking-ivory-muted);
  }
  .thinking-shell {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--thinking-max);
    margin-inline: auto;
    padding-inline: var(--thinking-pad);
  }

  .thinking-hero {
    padding-block: 0.85rem 1.15rem;
  }
  .thinking-hero__grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 60em) {
    .thinking-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }

  .thinking-eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--thinking-copper);
  }
  .thinking-eyebrow--light {
    color: var(--thinking-copper-light);
  }
  .thinking-title {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: clamp(1.85rem, 5vw, 2.35rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .thinking-title span {
    color: var(--thinking-copper);
  }
  .thinking-tagline {
    margin: 0 0 0.75rem;
    max-width: 38ch;
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .thinking-lede {
    margin: 0;
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--thinking-muted);
  }
  .thinking-rss {
    display: inline-block;
    margin-top: 0.85rem;
    color: var(--thinking-copper);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .thinking-rss:hover {
    color: var(--thinking-copper-bright);
  }

  .thinking-pubs__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }
  .thinking-pubs__head h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
  }
  .thinking-pubs__all {
    color: var(--thinking-copper);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .thinking-pubs__featured {
    margin: 0 0 0.55rem;
  }
  .thinking-pubs__featured a {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 0.85rem;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--thinking-border);
  }
  .thinking-pubs__featured time,
  .thinking-pubs__list time,
  .thinking-rows time {
    font-size: 0.8125rem;
    color: var(--thinking-muted);
  }
  .thinking-pubs__title {
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--thinking-ink);
  }
  .thinking-pubs__featured .thinking-pubs__title {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
  }
  .thinking-pubs__desc {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--thinking-muted);
  }
  .thinking-pubs__read {
    margin-top: 0.15rem;
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--thinking-copper);
  }
  .thinking-pubs__featured a:hover .thinking-pubs__title,
  .thinking-pubs__list a:hover .thinking-pubs__title,
  .thinking-row > a:hover .thinking-rows__title,
  .thinking-serie a:hover .thinking-serie__name {
    color: var(--thinking-copper-bright);
  }
  .thinking-pubs__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .thinking-pubs__list > li {
    border-bottom: 1px solid var(--thinking-border);
  }
  .thinking-pubs__list a {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.6rem;
    text-decoration: none;
    color: inherit;
  }
  .thinking-pubs__list .thinking-pubs__title {
    font-size: clamp(1rem, 1.3vw, 1.2rem);
  }

  .thinking-series {
    padding-block: 1.25rem 1.45rem;
  }
  .thinking-series h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 650;
  }
  .thinking-series__grid {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 50em) {
    .thinking-series__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .thinking-serie {
    padding-top: 0.75rem;
    border-top: 2px solid var(--thinking-ivory-ink);
  }
  .thinking-serie a {
    display: grid;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }
  .thinking-serie__n {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--thinking-copper-light);
  }
  .thinking-serie__name {
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .thinking-serie__hint {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--thinking-ivory-muted);
  }

  .thinking-library {
    padding-block: 1.35rem 2rem;
  }
  .thinking-library__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }
  .thinking-library__head h2 {
