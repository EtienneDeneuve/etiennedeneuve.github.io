---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThinkingFilters from "../components/ThinkingFilters.astro";
import { thinkingConfig } from "../config/thinking.ts";
import {
  articlesForLocale,
  filterArticles,
  formatArticleDate,
  getAllThinkingArticles,
  getArticleLanguage,
  getArticlePath,
  getCanonicalSlug,
  getContentTypeLabel,
  getQualifyingTags,
  listPublishedSeries,
  parseThinkingFilters,
  resolveThinkingLanguageScope,
  selectOpeningArticles,
  sortArticles,
  type ThinkingContentType,
} from "../lib/thinking.ts";
import { breadcrumbJsonLd, buildJsonLdGraph, collectionPageJsonLd } from "../lib/json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const thinkingPath = `${prefix}/thinking/`;
const config = thinkingConfig;
const labels = config.labels;

const url = Astro.url;
const filters = parseThinkingFilters(url.searchParams);
const sort = filters.sort ?? "recent";
const languageScope = resolveThinkingLanguageScope(lang, url.searchParams);
const languageFromUrl = url.searchParams.has("lang");
const hasActiveFilters = Boolean(
  filters.pillar || filters.contentType || languageFromUrl || filters.tag
);

const allArticles = await getAllThinkingArticles();
const localeArticles = articlesForLocale(allArticles, lang);
const libraryFilters = {
  ...filters,
  language: languageScope === "all" ? undefined : languageScope,
  sort,
};
const filtered = sortArticles(filterArticles(allArticles, libraryFilters), sort);
const openingSource = hasActiveFilters ? filtered : localeArticles;
const { lead, side } = selectOpeningArticles(openingSource, config.openingSideCount);
const openingIds = new Set([lead, ...side].filter(Boolean).map((entry) => entry!.id));
const libraryArticles = filtered.filter((entry) => !openingIds.has(entry.id));
const libraryPage = libraryArticles.slice(0, config.libraryPageSize);
const libraryMore = libraryArticles.slice(config.libraryPageSize);
const series = listPublishedSeries(localeArticles, lang);
const qualifyingTags = getQualifyingTags(localeArticles);

const jsonLd = buildJsonLdGraph([
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path: thinkingPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: config.meta.title[lang], path: thinkingPath },
  ]),
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={thinkingPath}
  alternates={[
    { lang: "fr", href: "/thinking/" },
    { lang: "en", href: "/en/thinking/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="thinking">
    <section class="thinking-band thinking-band--dark thinking-hero">
      <div class="thinking-shell thinking-hero__grid">
        <div class="thinking-hero__present">
          <p class="thinking-eyebrow">{config.meta.title[lang]}</p>
          <h1 class="thinking-title">
            {
              lang === "fr" ? (
                <>
                  Décisions <span>&amp; retours</span>
                  <br />
                  de terrain
                </>
              ) : (
                <>
                  Decisions <span>&amp; field</span>
                  <br />
                  notes
                </>
              )
            }
          </h1>
          <p class="thinking-tagline">{config.meta.intro[lang]}</p>
          <p class="thinking-lede">{config.meta.description[lang]}</p>
          <a class="thinking-rss" href="/rss.xml">{labels.rss[lang]} →</a>
        </div>

        {
          !hasActiveFilters && lead && (
            <aside class="thinking-pubs" aria-labelledby="thinking-opening-title">
              <div class="thinking-pubs__head">
                <h2 id="thinking-opening-title">{labels.opening[lang]}</h2>
                <a class="thinking-pubs__all" href="#bibliotheque">
                  {labels.openingAll[lang]} <span aria-hidden="true">→</span>
                </a>
              </div>
              <article class="thinking-pubs__featured">
                <a href={getArticlePath(getCanonicalSlug(lead), getArticleLanguage(lead))}>
                  <time datetime={lead.data.pubDate.toISOString()}>
                    {formatArticleDate(lead.data.pubDate, lang)}
                  </time>
                  <span class="thinking-pubs__title">{lead.data.title}</span>
                  {lead.data.description && (
                    <span class="thinking-pubs__desc">{lead.data.description}</span>
                  )}
                  <span class="thinking-pubs__read">
                    {labels.readAnalysis[lang]} <span aria-hidden="true">→</span>
                  </span>
                </a>
              </article>
              {
                side.length > 0 && (
                  <ol class="thinking-pubs__list">
                    {side.map((entry) => (
                      <li>
                        <a
                          href={getArticlePath(
                            getCanonicalSlug(entry),
                            getArticleLanguage(entry)
                          )}
                        >
                          <time datetime={entry.data.pubDate.toISOString()}>
                            {formatArticleDate(entry.data.pubDate, lang)}
                          </time>
                          <span class="thinking-pubs__title">{entry.data.title}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                )
              }
            </aside>
          )
        }
      </div>
    </section>

    {
      !hasActiveFilters && series.length > 0 && (
        <section class="thinking-band thinking-band--light thinking-series" aria-labelledby="thinking-series-title">
          <div class="thinking-shell">
            <p class="thinking-eyebrow thinking-eyebrow--light">{labels.seriesEyebrow[lang]}</p>
            <h2 id="thinking-series-title">{labels.series[lang]}</h2>
            <div class="thinking-series__grid">
              {series.map((item) => {
                const entryLang = getArticleLanguage(item.entry);
                const href = getArticlePath(getCanonicalSlug(item.entry), entryLang);
                const countLabel =
                  item.publishedCount === 1
                    ? labels.publishedCount[lang]
                    : labels.publishedCountPlural[lang];
                return (
                  <article class="thinking-serie">
                    <a href={href}>
                      <span class="thinking-serie__n">
                        {item.total} {labels.textsCount[lang]} · {item.publishedCount}{" "}
                        {countLabel}
                      </span>
                      <span class="thinking-serie__name">{item.title[lang]}</span>
                      <span class="thinking-serie__hint">{item.hint[lang]}</span>
                    </a>
                  </article>
                );
              })}
            </div>
          </div>
        </section>
      )
    }

    <section class="thinking-band thinking-band--dark thinking-library" id="bibliotheque">
      <div class="thinking-shell">
        <div class="thinking-library__head">
          <h2>{labels.library[lang]}</h2>
          <div class="thinking-library__tools">
            <span>{labels.sortRecent[lang]}</span>
            <details class="thinking-filters-panel">
              <summary>{labels.filtersToggle[lang]}</summary>
              <div class="thinking-filters-panel__body">
                <ThinkingFilters
                  lang={lang}
                  prefix={prefix}
                  current={{ ...filters, sort, language: languageScope }}
                  tagOptions={qualifyingTags}
                />
              </div>
            </details>
          </div>
        </div>

        {
          filtered.length === 0 ? (
            <p class="thinking-empty">
              {lang === "en"
                ? "No article matches these filters."
                : "Aucun article ne correspond à ces filtres."}
            </p>
          ) : (
            <>
              <ul class="thinking-rows">
                {libraryPage.map((entry) => (
                  <li>
                    <a
                      href={getArticlePath(
                        getCanonicalSlug(entry),
                        getArticleLanguage(entry)
                      )}
                    >
                      <time datetime={entry.data.pubDate.toISOString()}>
                        {formatArticleDate(entry.data.pubDate, lang)}
                      </time>
                      <span class="thinking-rows__title">{entry.data.title}</span>
                      <span class="thinking-rows__type">
                        {getContentTypeLabel(
                          entry.data.contentType as ThinkingContentType,
                          lang
                        )}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              {
                libraryMore.length > 0 && (
                  <details class="thinking-more">
                    <summary>
                      {labels.seeMore[lang]} ({libraryMore.length})
                    </summary>
                    <ul class="thinking-rows">
                      {libraryMore.map((entry) => (
                        <li>
                          <a
                            href={getArticlePath(
                              getCanonicalSlug(entry),
                              getArticleLanguage(entry)
                            )}
                          >
                            <time datetime={entry.data.pubDate.toISOString()}>
                              {formatArticleDate(entry.data.pubDate, lang)}
                            </time>
                            <span class="thinking-rows__title">{entry.data.title}</span>
                            <span class="thinking-rows__type">
                              {getContentTypeLabel(
                                entry.data.contentType as ThinkingContentType,
                                lang
                              )}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                )
              }
            </>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .thinking {
    --thinking-max: 90rem;
    --thinking-pad: var(--page-gutter, clamp(1.5rem, 4vw, 4rem));
    --thinking-bg: var(--graphite, #111416);
    --thinking-bg-soft: var(--graphite-soft, #1b1e20);
    --thinking-ivory: #f3efe7;
    --thinking-ivory-ink: #151819;
    --thinking-ivory-muted: #454a4d;
    --thinking-ivory-border: rgba(21, 24, 25, 0.14);
    --thinking-copper: var(--copper-on-dark, #f0aa78);
    --thinking-copper-bright: #f5c49a;
    --thinking-copper-light: var(--copper-on-light, #a54822);
    --thinking-ink: var(--text-on-dark, #f7f3ec);
    --thinking-muted: var(--text-muted-on-dark, #cdd0cf);
    --thinking-border: var(--border-on-dark, rgba(243, 239, 231, 0.16));
    --thinking-sans: "Outfit", system-ui, -apple-system, "Segoe UI", sans-serif;
    --thinking-radius: 4px;
    font-family: var(--thinking-sans);
    background: var(--thinking-bg);
    color: var(--thinking-ink);
  }

  .thinking-band--dark {
    background: var(--thinking-bg);
    color: var(--thinking-ink);
  }
  .thinking-band--light {
    background: var(--thinking-ivory);
    color: var(--thinking-ivory-ink);
  }
  .thinking-shell {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--thinking-max);
    margin-inline: auto;
    padding-inline: var(--thinking-pad);
  }

  .thinking-hero {
    padding-block: 0.85rem 1.15rem;
  }
  .thinking-hero__grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 60em) {
    .thinking-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }

  .thinking-eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--thinking-copper);
  }
  .thinking-eyebrow--light {
    color: var(--thinking-copper-light);
  }
  .thinking-title {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: clamp(1.85rem, 5vw, 2.35rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .thinking-title span {
    color: var(--thinking-copper);
  }
  .thinking-tagline {
    margin: 0 0 0.75rem;
    max-width: 38ch;
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .thinking-lede {
    margin: 0;
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--thinking-muted);
  }
  .thinking-rss {
    display: inline-block;
    margin-top: 0.85rem;
    color: var(--thinking-copper);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .thinking-rss:hover {
    color: var(--thinking-copper-bright);
  }

  .thinking-pubs__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }
  .thinking-pubs__head h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
  }
  .thinking-pubs__all {
    color: var(--thinking-copper);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .thinking-pubs__featured {
    margin: 0 0 0.55rem;
  }
  .thinking-pubs__featured a {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 0.85rem;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--thinking-border);
  }
  .thinking-pubs__featured time,
  .thinking-pubs__list time,
  .thinking-rows time {
    font-size: 0.8125rem;
    color: var(--thinking-muted);
  }
  .thinking-pubs__title {
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--thinking-ink);
  }
  .thinking-pubs__featured .thinking-pubs__title {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
  }
  .thinking-pubs__desc {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--thinking-muted);
  }
  .thinking-pubs__read {
    margin-top: 0.15rem;
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--thinking-copper);
  }
  .thinking-pubs__featured a:hover .thinking-pubs__title,
  .thinking-pubs__list a:hover .thinking-pubs__title,
  .thinking-rows a:hover .thinking-rows__title,
  .thinking-serie a:hover .thinking-serie__name {
    color: var(--thinking-copper-bright);
  }
  .thinking-pubs__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .thinking-pubs__list > li {
    border-bottom: 1px solid var(--thinking-border);
  }
  .thinking-pubs__list a {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.6rem;
    text-decoration: none;
    color: inherit;
  }
  .thinking-pubs__list .thinking-pubs__title {
    font-size: clamp(1rem, 1.3vw, 1.2rem);
  }

  .thinking-series {
    padding-block: 1.25rem 1.45rem;
  }
  .thinking-series h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 650;
  }
  .thinking-series__grid {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 50em) {
    .thinking-series__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .thinking-serie {
    padding-top: 0.75rem;
    border-top: 2px solid var(--thinking-ivory-ink);
  }
  .thinking-serie a {
    display: grid;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }
  .thinking-serie__n {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--thinking-copper-light);
  }
  .thinking-serie__name {
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .thinking-serie__hint {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--thinking-ivory-muted);
  }

  .thinking-library {
    padding-block: 1.35rem 2rem;
  }
  .thinking-library__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }
  .thinking-library__head h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
  }
  .thinking-library__tools {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--thinking-muted);
  }
  .thinking-filters-panel summary {
    list-style: none;
    cursor: pointer;
    font-weight: 650;
    color: var(--thinking-ink);
    border: 1px solid var(--thinking-border);
    border-radius: var(--thinking-radius);
    padding: 0.55rem 0.8rem;
  }
  .thinking-filters-panel summary::-webkit-details-marker {
    display: none;
  }
  .thinking-filters-panel[open] summary {
    color: var(--thinking-copper);
    border-color: var(--thinking-copper);
  }
  .thinking-filters-panel__body {
    margin-top: 0.85rem;
  }

  .thinking-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .thinking-rows a {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: 0.75rem 1rem;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--thinking-border);
    text-decoration: none;
    color: inherit;
  }
  .thinking-rows__title {
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .thinking-rows__type {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--thinking-muted);
    white-space: nowrap;
  }
  .thinking-more {
    margin-top: 1rem;
  }
  .thinking-more summary {
    cursor: pointer;
    color: var(--thinking-copper);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .thinking-empty {
    margin: 0;
    color: var(--thinking-muted);
  }

  @media (max-width: 50em) {
    .thinking-rows a {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
