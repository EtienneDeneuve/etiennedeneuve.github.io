---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import LearningPath from "../components/LearningPath.astro";
import ThinkingFilters from "../components/ThinkingFilters.astro";
import { thinkingConfig, thinkingPillars, thinkingContentTypes } from "../config/thinking.ts";
import {
  filterArticles,
  getAllThinkingArticles,
  getFeaturedArticles,
  getQualifyingTags,
  parseThinkingFilters,
  sortArticles,
} from "../lib/thinking.ts";
import { resolveContentRefs } from "../lib/resolve-content.ts";
import { breadcrumbJsonLd, buildJsonLdGraph, collectionPageJsonLd } from "../lib/json-ld.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const thinkingPath = `${prefix}/thinking/`;
const config = thinkingConfig;
const labels = config.labels;

const url = Astro.url;
const filters = parseThinkingFilters(url.searchParams);
const sort = filters.sort ?? "featured";
const hasActiveFilters = Boolean(
  filters.pillar || filters.contentType || filters.language || filters.tag
);

const allArticles = await getAllThinkingArticles();
const filtered = sortArticles(filterArticles(allArticles, filters), sort);
const featured = hasActiveFilters ? [] : getFeaturedArticles(allArticles);
const qualifyingTags = getQualifyingTags(allArticles);

const [projects, resources] = await Promise.all([
  getCollection("projects"),
  getCollection("resources"),
]);

const readingPaths = config.readingPaths
  .map((path) => ({
    ...path,
    resolvedItems: resolveContentRefs(
      path.items,
      {
        articles: allArticles,
        projects,
        resources,
      },
      lang
    ),
  }))
  .filter((path) => path.resolvedItems.length > 0);

const jsonLd = buildJsonLdGraph([
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path: thinkingPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: config.meta.title[lang], path: thinkingPath },
  ]),
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={thinkingPath}
  alternates={[
    { lang: "fr", href: "/thinking/" },
    { lang: "en", href: "/en/thinking/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper stack gap-12">
    <section class="stack gap-3 hero">
      <h1>{config.meta.title[lang]}</h1>
      <p class="intro">{config.meta.intro[lang]}</p>
      <p class="rss-links">
        <a href="/rss.xml">{labels.rss[lang]}</a>
        {
          thinkingPillars.map((pillar) => (
            <>
              {" · "}
              <a href={`/thinking/rss/${pillar}.xml`}>RSS {config.pillarLabels[pillar][lang]}</a>
            </>
          ))
        }
      </p>
    </section>

    <section class="stack gap-3" id="browse">
      <h2>{lang === "en" ? "Browse" : "Explorer"}</h2>
      <div class="browse-grid">
        <div>
          <h3>{labels.browsePillars[lang]}</h3>
          <ul>
            {
              thinkingPillars.map((pillar) => (
                <li>
                  <a href={`${prefix}/thinking/pillar/${pillar}/`}>
                    {config.pillarLabels[pillar][lang]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3>{labels.browseTypes[lang]}</h3>
          <ul>
            {
              thinkingContentTypes.map((type) => (
                <li>
                  <a href={`${prefix}/thinking/type/${type}/`}>
                    {config.contentTypeLabels[type][lang]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        {
          qualifyingTags.length > 0 && (
            <div>
              <h3>{labels.browseTags[lang]}</h3>
              <ul>
                {qualifyingTags.map((tag) => (
                  <li>
                    <a href={`${prefix}/thinking/tag/${tag.slug}/`}>
                      {tag.label} ({tag.count})
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <ThinkingFilters
      lang={lang}
      prefix={prefix}
      current={{ ...filters, sort }}
      tagOptions={qualifyingTags}
    />

    {
      featured.length > 0 && (
        <section class="stack gap-4">
          <h2>{labels.featured[lang]}</h2>
          <div class="cards-grid">
            {featured.map((entry) => (
              <ArticleCard entry={entry} lang={lang} />
            ))}
          </div>
        </section>
      )
    }

    <section class="stack gap-4">
      <header class="section-header">
        <h2>{labels.allArticles[lang]}</h2>
        <p>{filtered.length} {labels.articlesCount[lang]}</p>
      </header>
      <div class="cards-grid">
        {filtered.map((entry) => <ArticleCard entry={entry} lang={lang} />)}
      </div>
    </section>

    {
      readingPaths.length > 0 && (
        <section class="stack gap-4" id="reading-paths">
          <h2>{labels.readingPaths[lang]}</h2>
          <div class="paths stack gap-4">
            {readingPaths.map((path) => (
              <LearningPath
                id={path.id}
                title={path.title[lang]}
                summary={path.summary[lang]}
                themes={path.themes[lang]}
                items={path.resolvedItems}
                lang={lang}
              />
            ))}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .hero {
    max-width: 40rem;
    padding-block: var(--space-4);
  }
  .intro {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: var(--leading-relaxed);
    font-size: var(--text-lg);
  }
  .rss-links {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .rss-links a {
    color: var(--color-fg-muted);
  }
  .browse-grid {
    display: grid;
    gap: 0;
    border: var(--border-width) solid var(--color-border);
  }
  @media (min-width: 50em) {
    .browse-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .browse-grid > div {
    padding: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  @media (min-width: 50em) {
    .browse-grid > div {
      border-bottom: 0;
      border-right: var(--border-width) solid var(--color-border);
    }
    .browse-grid > div:last-child {
      border-right: 0;
    }
  }
  .browse-grid h3 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-subtle);
  }
  .browse-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .browse-grid a {
    color: var(--color-fg);
    text-decoration: none;
  }
  .browse-grid a:hover {
    color: var(--accent-regular);
  }
  .cards-grid {
    display: grid;
    gap: 0;
    border: var(--border-width) solid var(--color-border);
  }
  .cards-grid > :global(*) {
    border: 0;
    border-bottom: var(--border-width) solid var(--color-border);
    border-radius: 0;
  }
  @media (min-width: 50em) {
    .cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cards-grid > :global(*) {
      border-right: var(--border-width) solid var(--color-border);
    }
  }
  @media (min-width: 75em) {
    .cards-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .section-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .section-header p {
    margin: 0;
    color: var(--color-fg-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
</style>
