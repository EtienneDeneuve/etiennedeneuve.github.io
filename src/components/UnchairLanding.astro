---
import "../styles/editorial-pages.css";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";
const comparePath = `${prefix}/unchair/compare/`;
const projectsPath = `${prefix}/projects/`;

const copy = {
  fr: {
    eyebrow: "Produit open source · macOS",
    title: "Unchair",
    accent: "Le rappel de pause qui vérifie que tu as vraiment bougé.",
    lede: "App macOS local-first, volontairement un peu pénible : elle transforme les rappels de pause en mouvement réellement vérifié, sans compte cloud.",
    asideLabel: "En une phrase",
    aside:
      "Dismissible reminders don’t fix sitting debt. Unchair keeps the debt and, if you allow it, verifies sit → stand on-device with Apple Vision.",
    asideLink: "Voir les réalisations",
    download: "Télécharger pour macOS",
    source: "Code source",
    homebrewLabel: "Homebrew",
    facts: ["macOS 14+", "v1.0.0", "Gratuit · MIT", "Apple Vision", "Sans compte cloud"],
    whyTitle: "Pourquoi je l’ai construit",
    whyBody:
      "Je passe mes journées devant un Mac. Les rappels classiques ont un défaut fatal : on peut les fermer sans bouger. Unchair conserve la dette de mouvement et peut vérifier localement le passage assis → debout.",
    pillarsTitle: "Ce que ça change",
    pillars: [
      [
        "01",
        "Pas un timer cosmétique",
        "Unchair attend un mouvement réel avant de considérer la pause comme faite.",
      ],
      [
        "02",
        "Caméra = capteur éphémère",
        "Frames et landmarks restent en mémoire sur le Mac, puis disparaissent. Pas d’upload.",
      ],
      [
        "03",
        "Pénible, pas suicidaire",
        "Réunions, écran verrouillé, Mac endormi : les interruptions sont différées. La dette revient ensuite.",
      ],
      [
        "04",
        "Home Assistant optionnel",
        "MQTT Discovery si tu veux. Le cœur fonctionne sans broker ni réseau.",
      ],
    ],
    engTitle: "Sous le capot",
    engIntro: "Petit produit, vraies contraintes d’ingénierie.",
    engineering: [
      ["State machine déterministe", "Transitions explicites et testables."],
      ["Local-first", "Pas de backend obligatoire."],
      ["Observabilité optionnelle", "OpenMetrics / OpenTelemetry si besoin."],
      ["Release propre", "Developer ID, notarized, Homebrew, Sparkle."],
    ],
    compareTitle: "Unchair vs Stretchly vs Time Out",
    compareBody:
      "Comparatif factuel : plateformes, vérification du mouvement, réunions, licence et intégrations — sans faux classement.",
    compareLink: "Lire le comparatif",
    statusTitle: "Où en est le produit",
    statusIntro: "La roadmap détaillée vit sur GitHub. Ici, l’essentiel.",
    shippedLabel: "Disponible",
    shipped: [
      "Breaks + overlay difficile à ignorer",
      "Vérification assis → debout (Apple Vision)",
      "Garde réunion / présentation",
      "Historique local et stats du jour",
      "Home Assistant / MQTT optionnel",
      "DMG signé + Homebrew Cask",
    ],
    nextLabel: "Ensuite",
    next: ["Companion iOS / HealthKit", "watchOS", "Transport local authentifié"],
    roadmapLink: "Roadmap GitHub",
    faqTitle: "FAQ",
    faqIntro: "Local-first, pas de compte obligatoire, peu de magie cachée.",
    faqs: [
      [
        "Est-ce qu’Unchair enregistre ou envoie ma caméra ?",
        "Non. Les frames et données Apple Vision sont traitées en mémoire sur le Mac. Ni enregistrement ni upload.",
      ],
      [
        "La caméra est-elle obligatoire ?",
        "Non. Les rappels fonctionnent sans vérification visuelle. La caméra sert seulement si tu actives la preuve de mouvement.",
      ],
      [
        "Que se passe-t-il en réunion ?",
        "Unchair détecte des signaux forts de présentation ou d’appel et diffère les interruptions. La dette revient ensuite.",
      ],
      [
        "Faut-il Home Assistant ?",
        "Non. MQTT / Home Assistant sont optionnels. Le cœur tourne offline.",
      ],
      ["Combien ça coûte ?", "Gratuit, MIT, sans abonnement ni compte obligatoire."],
      [
        "Comment l’installer ?",
        "brew install --cask EtienneDeneuve/unchair/unchair — ou le DMG signé sur GitHub.",
      ],
    ],
    finalTitle: "Ton dos ne lit pas ton backlog.",
    finalBody:
      "Gratuit, open source, macOS 14+. À installer avant la prochaine session « juste encore une heure ».",
    engineeringLink: "Note d’ingénierie côté Omnivya",
    workplaceLink: "Santé au travail — note My Dare",
    footer: "Construit par Étienne Deneuve. L’agacement est volontaire.",
  },
  en: {
    eyebrow: "Open-source product · macOS",
    title: "Unchair",
    accent: "The break reminder that checks you actually moved.",
    lede: "A mildly annoying, local-first macOS app that turns break reminders into verified movement — no cloud account.",
    asideLabel: "In one line",
    aside:
      "Dismissible reminders don’t fix sitting debt. Unchair keeps the debt and can verify sit → stand on-device with Apple Vision.",
    asideLink: "See projects",
    download: "Download for macOS",
    source: "Source code",
    homebrewLabel: "Homebrew",
    facts: ["macOS 14+", "v1.0.0", "Free · MIT", "Apple Vision", "No cloud account"],
    whyTitle: "Why I built it",
    whyBody:
      "Classic break reminders have one fatal flaw: I can dismiss them without moving. Unchair keeps the movement debt and can verify sit → stand locally.",
    pillarsTitle: "What changes",
    pillars: [
      [
        "01",
        "Not a cosmetic timer",
        "Unchair waits for real movement before counting the break as done.",
      ],
      [
        "02",
        "Camera as ephemeral sensor",
        "Frames and landmarks stay in memory on the Mac, then disappear. No upload.",
      ],
      [
        "03",
        "Annoying, not career-limiting",
        "Meetings, locked screen, sleep: interruptions defer. The debt returns afterwards.",
      ],
      [
        "04",
        "Optional Home Assistant",
        "MQTT Discovery if you want it. The core works without a broker or network.",
      ],
    ],
    engTitle: "Under the hood",
    engIntro: "Small product. Real engineering constraints.",
    engineering: [
      ["Deterministic state machine", "Explicit, testable transitions."],
      ["Local-first", "No mandatory backend."],
      ["Optional observability", "OpenMetrics / OpenTelemetry when useful."],
      ["Proper releases", "Developer ID, notarized, Homebrew, Sparkle."],
    ],
    compareTitle: "Unchair vs Stretchly vs Time Out",
    compareBody:
      "A factual side-by-side: platforms, movement verification, meetings, licence and integrations — no fake ranking.",
    compareLink: "Read the comparison",
    statusTitle: "Where the product stands",
    statusIntro: "Detailed roadmap lives on GitHub. Here is the short version.",
    shippedLabel: "Available",
    shipped: [
      "Breaks + hard-to-ignore overlay",
      "Sit → stand verification (Apple Vision)",
      "Meeting / presentation guard",
      "Local history and Today stats",
      "Optional Home Assistant / MQTT",
      "Signed DMG + Homebrew Cask",
    ],
    nextLabel: "Next",
    next: ["iOS companion / HealthKit", "watchOS", "Authenticated local transport"],
    roadmapLink: "GitHub roadmap",
    faqTitle: "FAQ",
    faqIntro: "Local-first, no mandatory account, as little hidden magic as possible.",
    faqs: [
      [
        "Does Unchair record or upload my camera?",
        "No. Frames and Apple Vision data are processed in memory on the Mac. Nothing is recorded or uploaded.",
      ],
      [
        "Is the camera required?",
        "No. Reminders work without visual verification. Camera access is only needed for movement proof.",
      ],
      [
        "What about meetings?",
        "Strong presentation/call signals defer interruptions. The movement debt returns afterwards.",
      ],
      [
        "Do I need Home Assistant?",
        "No. MQTT / Home Assistant are optional. The core loop works offline.",
      ],
      ["How much does it cost?", "Free, MIT, no subscription or mandatory account."],
      [
        "How do I install it?",
        "brew install --cask EtienneDeneuve/unchair/unchair — or the signed DMG on GitHub.",
      ],
    ],
    finalTitle: "Your back does not read your backlog.",
    finalBody:
      "Free, open source, macOS 14+. Install it before the next “just one more hour” session.",
    engineeringLink: "Engineering note on Omnivya",
    workplaceLink: "Workplace wellbeing — My Dare field note",
    footer: "Built by Étienne Deneuve. The annoyance is intentional.",
  },
}[lang];

const source = "etienne_deneuve";
const homebrewCommand = "brew install --cask EtienneDeneuve/unchair/unchair";
const repoBase = "https://github.com/EtienneDeneuve/unchair";
const release = `${repoBase}/releases/latest/download/Unchair-latest-macos.dmg?utm_source=${source}&utm_medium=website&utm_campaign=unchair&utm_content=download`;
const repo = `${repoBase}?utm_source=${source}&utm_medium=website&utm_campaign=unchair&utm_content=source`;
const roadmap = `${repoBase}/blob/main/ROADMAP.md?utm_source=${source}&utm_medium=website&utm_campaign=unchair&utm_content=roadmap`;
const tour =
  "https://raw.githubusercontent.com/EtienneDeneuve/unchair/main/docs/assets/unchair-tour.gif";
const omnivyaHref =
  lang === "fr"
    ? "https://www.omnivya.fr/fr/open-source/unchair/?utm_source=etienne_deneuve&utm_medium=website&utm_campaign=unchair&utm_content=omnivya-engineering"
    : "https://www.omnivya.fr/open-source/unchair/?utm_source=etienne_deneuve&utm_medium=website&utm_campaign=unchair&utm_content=omnivya-engineering";
const workplaceHref =
  "https://www.my-dare.com/blog/sante-travail-sedentarite?utm_source=etienne_deneuve&utm_medium=website&utm_campaign=unchair&utm_content=mydare-workplace";
---

<main class="editorial-page ed-unchair">
  <header class="ed-band--dark ed-hero">
    <div class="ed-shell ed-hero__grid">
      <div>
        <p class="ed-kicker">{copy.eyebrow}</p>
        <h1 class="ed-title">
          {copy.title}
          <span class="ed-title__accent">{copy.accent}</span>
        </h1>
        <p class="ed-lede">{copy.lede}</p>
        <div class="ed-actions ed-unchair__actions">
          <a
            class="ed-button"
            href={release}
            rel="noopener noreferrer"
            data-analytics-event="cta_unchair_download"
            data-analytics-props={JSON.stringify({ surface: "unchair-hero", lang })}
          >
            {copy.download}
            <span aria-hidden="true">↓</span>
          </a>
          <a
            class="ed-text-link"
            href={repo}
            rel="noopener noreferrer"
            data-analytics-event="cta_unchair_source"
            data-analytics-props={JSON.stringify({ surface: "unchair-hero", lang })}
          >
            {copy.source}
          </a>
        </div>
        <p class="ed-unchair__brew">
          <span>{copy.homebrewLabel}</span>
          <code>{homebrewCommand}</code>
        </p>
        <ul class="ed-unchair__facts" aria-label="Unchair">
          {copy.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
      <aside class="ed-hero__aside ed-unchair__visual">
        <p class="ed-aside__label">{copy.asideLabel}</p>
        <p>{copy.aside}</p>
        <a class="ed-aside__link" href={projectsPath}>
          {copy.asideLink}
          <span aria-hidden="true">↗</span>
        </a>
        <figure class="ed-unchair__shot">
          <img
            src={tour}
            alt={lang === "fr" ? "Tour produit Unchair sur macOS" : "Unchair macOS product tour"}
            width="840"
            height="560"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </aside>
    </div>
  </header>

  <section class="ed-band--light ed-section" aria-labelledby="unchair-why">
    <div class="ed-shell">
      <div class="ed-section__head">
        <h2 id="unchair-why">{copy.whyTitle}</h2>
        <p>{copy.whyBody}</p>
      </div>
    </div>
  </section>

  <section class="ed-band--dark ed-section" aria-labelledby="unchair-pillars">
    <div class="ed-shell">
      <div class="ed-section__head">
        <h2 id="unchair-pillars">{copy.pillarsTitle}</h2>
      </div>
      <ul class="ed-situations ed-unchair__pillars">
        {
          copy.pillars.map(([index, title, body]) => (
            <li class="ed-situation ed-unchair__pillar">
              <span class="ed-situation__index">{index}</span>
              <h3>{title}</h3>
              <p class="ed-situation__signal">{body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ed-band--light ed-section" aria-labelledby="unchair-eng">
    <div class="ed-shell">
      <div class="ed-section__head">
        <h2 id="unchair-eng">{copy.engTitle}</h2>
        <p>{copy.engIntro}</p>
      </div>
      <dl class="ed-facts ed-unchair__eng">
        {
          copy.engineering.map(([title, body]) => (
            <div>
              <dt>{title}</dt>
              <dd>{body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="ed-band--soft ed-section" aria-labelledby="unchair-compare">
    <div class="ed-shell ed-unchair__compare">
      <div class="ed-section__head">
        <h2 id="unchair-compare">{copy.compareTitle}</h2>
        <p>{copy.compareBody}</p>
      </div>
      <a class="ed-button" href={comparePath}>{copy.compareLink}</a>
    </div>
  </section>

  <section class="ed-band--light ed-section" aria-labelledby="unchair-status">
    <div class="ed-shell">
      <div class="ed-section__head">
        <h2 id="unchair-status">{copy.statusTitle}</h2>
        <p>{copy.statusIntro}</p>
      </div>
      <div class="ed-unchair__status">
        <div>
          <h3>{copy.shippedLabel}</h3>
          <ul>
            {copy.shipped.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3>{copy.nextLabel}</h3>
          <ul>
            {copy.next.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <p class="ed-unchair__roadmap">
        <a class="ed-text-link" href={roadmap} rel="noopener noreferrer">{copy.roadmapLink}</a>
      </p>
    </div>
  </section>

  <section class="ed-band--dark ed-section" aria-labelledby="unchair-faq">
    <div class="ed-shell">
      <div class="ed-section__head">
        <h2 id="unchair-faq">{copy.faqTitle}</h2>
        <p>{copy.faqIntro}</p>
      </div>
      <div class="ed-unchair__faq">
        {
          copy.faqs.map(([question, answer]) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ed-band--light ed-section" aria-labelledby="unchair-final">
    <div class="ed-shell">
      <div class="ed-section__head">
        <h2 id="unchair-final">{copy.finalTitle}</h2>
        <p>{copy.finalBody}</p>
      </div>
      <div class="ed-actions">
        <a
          class="ed-button"
          href={release}
          rel="noopener noreferrer"
          data-analytics-event="cta_unchair_download"
          data-analytics-props={JSON.stringify({ surface: "unchair-final", lang })}
        >
          {copy.download}
        </a>
        <a class="ed-text-link" href={repo} rel="noopener noreferrer">{copy.source}</a>
      </div>
      <p class="ed-unchair__links">
        <a href={omnivyaHref} rel="noopener noreferrer" target="_blank">{copy.engineeringLink}</a>
        <span aria-hidden="true">·</span>
        <a href={workplaceHref} rel="noopener noreferrer" target="_blank">{copy.workplaceLink}</a>
      </p>
      <p class="ed-unchair__note">{copy.footer}</p>
    </div>
  </section>
</main>

<style>
  .ed-unchair__actions {
    margin-top: 1.5rem;
  }

  .ed-unchair__brew {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.75rem;
    margin: 1.1rem 0 0;
    font-size: 0.82rem;
    color: var(--ed-muted-dark);
  }

  .ed-unchair__brew code {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--ed-line-dark);
    border-radius: var(--radius-md, 6px);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ed-ink-dark);
    background: rgba(243, 239, 231, 0.06);
  }

  .ed-unchair__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 1.15rem 0 0;
    padding: 0;
  }

  .ed-unchair__facts li {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--ed-line-dark);
    border-radius: 999px;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--ed-muted-dark);
  }

  .ed-unchair__visual {
    display: grid;
    gap: 0.85rem;
  }

  .ed-unchair__shot {
    margin: 0.85rem 0 0;
    overflow: hidden;
    border: 1px solid var(--ed-line-dark);
    border-radius: var(--radius-md, 6px);
    background: #090c0d;
  }

  .ed-unchair__shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 840 / 560;
    object-fit: cover;
  }

  .ed-unchair__pillars {
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .ed-unchair__pillar {
    background: var(--ed-graphite-soft);
    border-color: var(--ed-line-dark);
  }

  .ed-unchair__pillar .ed-situation__index {
    color: var(--ed-copper-dark);
  }

  .ed-unchair__pillar h3 {
    color: var(--ed-ink-dark);
  }

  .ed-unchair__pillar .ed-situation__signal {
    color: var(--ed-muted-dark);
  }

  .ed-unchair__eng {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    border-top: none;
    padding-top: 0;
    gap: 1.15rem 1.5rem;
  }

  .ed-unchair__eng div {
    padding: 1rem 0 0;
    border-top: 1px solid var(--ed-line-light);
  }

  .ed-unchair__compare .ed-section__head {
    margin-bottom: 1.25rem;
  }

  .ed-unchair__status {
    display: grid;
    gap: 1.75rem;
  }

  .ed-unchair__status h3 {
    margin: 0 0 0.65rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ed-copper-light);
  }

  .ed-unchair__status ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
    color: var(--ed-muted-light);
    line-height: 1.45;
  }

  .ed-unchair__roadmap {
    margin: 1.35rem 0 0;
  }

  .ed-unchair__faq {
    display: grid;
    gap: 0.65rem;
    max-width: 52rem;
  }

  .ed-unchair__faq details {
    border: 1px solid var(--ed-line-dark);
    border-radius: var(--radius-md, 6px);
    padding: 0.85rem 1rem;
    background: rgba(243, 239, 231, 0.03);
  }

  .ed-unchair__faq summary {
    cursor: pointer;
    font-weight: 650;
    color: var(--ed-ink-dark);
  }

  .ed-unchair__faq p {
    margin: 0.7rem 0 0;
    color: var(--ed-muted-dark);
    line-height: 1.55;
  }

  .ed-unchair__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
  }

  .ed-unchair__links a {
    color: var(--ed-copper-light);
    font-weight: 650;
  }

  .ed-unchair__note {
    margin: 1rem 0 0;
    font-size: 0.85rem;
    color: var(--ed-muted-light);
  }

  @media (min-width: 56rem) {
    .ed-unchair__status {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 2.5rem;
    }
  }
</style>
