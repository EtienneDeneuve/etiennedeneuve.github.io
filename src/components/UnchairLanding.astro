---
interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;

const copy = {
  fr: {
    eyebrow: "UNCHAIR · macOS · OPEN SOURCE",
    title: "Ton Mac sait que tu es assis depuis trop longtemps.",
    accent: "Maintenant, il veut une preuve que tu t’es levé.",
    lead: "Unchair est une app macOS local-first, volontairement un peu pénible, qui transforme les rappels de pause en mouvement réellement vérifié.",
    download: "Télécharger pour macOS",
    source: "Voir le code",
    homebrewLabel: "Ou avec Homebrew",
    facts: [
      "macOS 14+",
      "100 % gratuit · MIT",
      "Swift + SwiftUI",
      "Apple Vision",
      "Homebrew Cask",
      "aucun compte cloud",
    ],
    whyKicker: "Pourquoi je l’ai construit",
    whyTitle: "Parce que « rappelle-moi plus tard » ne fait pas bouger.",
    whyBody:
      "Je passe mes journées devant un Mac, entre architecture, incidents, CI et agents qui travaillent. Les rappels classiques ont un défaut fatal : je peux les fermer sans bouger. Unchair conserve la dette de mouvement et, si tu l’autorises, vérifie localement le passage assis → debout avec Apple Vision.",
    cards: [
      [
        "01",
        "Pas un timer avec un joli bouton.",
        "Un rappel peut être ignoré. Une notification peut être balayée. Unchair attend un mouvement réel avant de considérer la pause comme faite.",
      ],
      [
        "02",
        "La caméra comme capteur éphémère.",
        "Frames, masques et landmarks restent en mémoire sur le Mac puis sont jetés. Aucun compte, aucune vidéo enregistrée, aucun upload.",
      ],
      [
        "03",
        "Pénible, pas suicidaire en réunion.",
        "Le moteur diffère les interruptions lorsque le Mac est verrouillé, endormi, inactif ou qu’un signal fort de présentation/appel est détecté. La dette revient ensuite.",
      ],
      [
        "04",
        "Home Assistant, parce qu’évidemment.",
        "MQTT Discovery expose l’état dérivé d’Unchair et une petite allowlist de commandes. Ta lampe peut passer à l’orange, puis au rouge, avant que tu reconsidères tes choix de vie.",
      ],
    ],
    underKicker: "Sous le capot",
    underTitle: "Petit produit. Vraies contraintes d’ingénierie.",
    engineering: [
      [
        "State machine déterministe",
        "Pause due, report, présentation et validation du mouvement : les transitions sont explicites et testables.",
      ],
      [
        "Local-first par défaut",
        "Le cœur fonctionne sans backend, sans Home Assistant et sans connexion réseau.",
      ],
      [
        "Observabilité optionnelle",
        "OpenMetrics/Prometheus et tracing permettent d’observer le runtime humain sans imposer de service cloud.",
      ],
      [
        "Release propre",
        "Builds Developer ID signés, notarized et stapled, DMG + ZIP, Homebrew Cask et Sparkle pour les mises à jour.",
      ],
    ],
    demoKicker: "Le produit, pas le pitch",
    demoTitle: "sit → stand → move → verify",
    compareKicker: "Tu compares encore ?",
    compareTitle: "Unchair vs Stretchly vs Time Out",
    compareBody:
      "J’ai mis les trois côte à côte sans faux classement : plateformes, vérification du mouvement, réunions, open source, prix et intégrations.",
    compareLink: "Voir le comparatif factuel",
    roadmapKicker: "Roadmap publique",
    roadmapTitle: "Déjà utile aujourd’hui. Plus bizarre demain.",
    roadmapIntro:
      "Pas de dates marketing inventées : les issues GitHub sont la source de vérité. Ce qui est livré est fermé ; ce qui arrive reste ouvert et inspectable.",
    roadmapGroups: [
      {
        label: "Disponible maintenant",
        meta: "v0.1 → v0.4.0",
        status: "shipped",
        items: [
          ["Breaks configurables + overlay difficile à ignorer", [2, 3]],
          ["Apple Vision local : assis → debout + preuve de mouvement", [4, 5, 6]],
          ["Protection réunions / présentations + mouvement différé", [13, 20]],
          ["Historique local, stats Today, launch at login", [8, 9, 11]],
          ["Home Assistant / MQTT optionnel", [15, 16, 17, 18, 19]],
          ["OpenMetrics, OpenTelemetry, Grafana + CLI doctor", [22, 23, 24, 33]],
          ["Homebrew Cask + carte Human Runtime + checklist release", [84, 85, 86]],
          ["Comparatif Stretchly / Time Out + premières mentions hors sites", [97, 98]],
        ],
      },
      {
        label: "Ensuite",
        meta: "issues ouvertes · sans date promise",
        status: "next",
        items: [["v1.0 Mac Standalone — fiabilité / a11y / onboarding", [44]]],
      },
      {
        label: "Apple Enhanced",
        meta: "v1.5",
        status: "later",
        items: [
          ["Companion iOS + mouvement récent via HealthKit", [36, 37]],
          ["App watchOS + preuve de mouvement live", [38, 39]],
          ["Transport local authentifié et réconciliation wearable", [40, 41]],
          ["Proximité Watch/iPhone + threat model étendu", [42, 43]],
        ],
      },
      {
        label: "Human Reliability Engineering",
        meta: "v2.x · laboratoire",
        status: "later",
        items: [
          ["Sitting SLO + Human Error Budget", [21]],
          ["Standing desk et capteur de chaise optionnels", [26, 27]],
          ["Boss Fight + achievements", [28, 29]],
          ["Post-mortems automatiques + calendrier + multi-Mac", [30, 31, 32]],
        ],
      },
    ],
    roadmapLink: "Voir toute la roadmap sur GitHub",
    faqKicker: "FAQ",
    faqTitle: "Les questions normales avant de laisser une app te dire de te lever.",
    faqIntro:
      "Le cœur d’Unchair est volontairement simple : local-first, pas de compte obligatoire, et le moins de magie cachée possible.",
    faqs: [
      [
        "Est-ce qu’Unchair enregistre ou envoie ma caméra ?",
        "Non. Les frames caméra et les données Apple Vision utilisées pour vérifier le mouvement sont traitées en mémoire sur le Mac. Elles ne sont ni enregistrées ni uploadées.",
      ],
      [
        "La caméra est-elle obligatoire ?",
        "Non. Tu peux utiliser les rappels de pause sans activer la vérification visuelle. La caméra sert uniquement si tu veux qu’Unchair vérifie localement que tu t’es réellement levé et déplacé.",
      ],
      [
        "Que se passe-t-il pendant une réunion ou une présentation ?",
        "Unchair détecte des signaux forts de présentation ou d’appel et diffère les interruptions. La dette de mouvement n’est pas oubliée : elle revient lorsque le contexte redevient normal.",
      ],
      [
        "Et si je verrouille mon Mac ou pars déjeuner ?",
        "Les horloges de travail et de position assise se mettent en pause lorsque le Mac est verrouillé, endormi ou inactif assez longtemps. Revenir à son bureau ne transforme donc pas automatiquement le déjeuner en deux heures assis.",
      ],
      [
        "Faut-il Home Assistant ou MQTT ?",
        "Non. Home Assistant et MQTT sont entièrement optionnels. Le scheduling des pauses, la vérification caméra, le mode présentation et les statistiques locales continuent de fonctionner sans broker.",
      ],
      [
        "Unchair a-t-il besoin d’Internet ou d’un compte ?",
        "Pas pour la boucle principale. Le mode standalone ne nécessite ni compte cloud ni backend. Le réseau sert uniquement aux fonctions optionnelles comme MQTT, OpenMetrics et les mises à jour du canal direct.",
      ],
      [
        "Combien coûte Unchair ?",
        "Unchair est 100 % gratuit et open source sous licence MIT. Il n’y a ni abonnement, ni licence payante, ni compte obligatoire. Le code, les releases et le modèle de confidentialité sont publics sur GitHub.",
      ],
      [
        "Comment installer Unchair ?",
        "Avec Homebrew : brew install --cask EtienneDeneuve/unchair/unchair. Sinon, le DMG signé et notarisé reste disponible sur GitHub.",
      ],
      [
        "Quels Mac sont compatibles et comment arrivent les mises à jour ?",
        "Unchair cible macOS 14 et versions suivantes. Les builds directs sont signés Developer ID, notarized et stapled ; les mises à jour intégrées utilisent Sparkle.",
      ],
    ],
    finalTitle: "Ton dos ne lit pas ton backlog.",
    finalBody:
      "Unchair est gratuit, open source et fonctionne sur macOS 14+. Installe-le avant une autre session de deux heures « juste pour finir ce truc ».",
    workplaceLink:
      "Santé au travail : pourquoi on finit par normaliser des journées entières assis — My Dare",
    footer: "Construit par Étienne Deneuve. Le bug est volontairement agaçant.",
  },
  en: {
    eyebrow: "UNCHAIR · macOS · OPEN SOURCE",
    title: "Your Mac knows you have been sitting too long.",
    accent: "Now it wants proof that you actually stood up.",
    lead: "Unchair is a mildly annoying, local-first macOS app that turns break reminders into movement you can actually verify.",
    download: "Download for macOS",
    source: "View the source",
    homebrewLabel: "Or with Homebrew",
    facts: [
      "macOS 14+",
      "100% free · MIT",
      "Swift + SwiftUI",
      "Apple Vision",
      "Homebrew Cask",
      "no cloud account",
    ],
    whyKicker: "Why I built it",
    whyTitle: "Because “remind me later” does not make you move.",
    whyBody:
      "I spend my days in front of a Mac, somewhere between architecture, incidents, CI and agents doing their thing. Classic break reminders have one fatal flaw: I can dismiss them without moving. Unchair keeps the movement debt and, if you allow it, verifies sit → stand locally with Apple Vision.",
    cards: [
      [
        "01",
        "Not a timer with a nicer button.",
        "A reminder can be ignored. A notification can be swiped away. Unchair waits for real movement before it considers the break complete.",
      ],
      [
        "02",
        "The camera is an ephemeral sensor.",
        "Frames, masks and landmarks stay in memory on the Mac, then disappear. No account, no recorded video, no upload.",
      ],
      [
        "03",
        "Annoying, not career-limiting.",
        "The engine defers interruptions while the Mac is locked, asleep, idle, or strong presentation/call signals are present. The movement debt returns afterwards.",
      ],
      [
        "04",
        "Home Assistant, because obviously.",
        "MQTT Discovery exposes derived Unchair state plus a narrow command allowlist. Your desk light can go orange, then red, before you reconsider your life choices.",
      ],
    ],
    underKicker: "Under the hood",
    underTitle: "Small product. Real engineering constraints.",
    engineering: [
      [
        "Deterministic state machine",
        "Due, postponed, presentation-deferred and movement-verified transitions stay explicit and testable.",
      ],
      [
        "Local-first by default",
        "The core loop works without a backend, Home Assistant or a network connection.",
      ],
      [
        "Optional observability",
        "OpenMetrics/Prometheus and tracing let you inspect the human runtime without requiring a cloud service.",
      ],
      [
        "Proper release path",
        "Developer ID signed, notarized and stapled builds, DMG + ZIP, Homebrew Cask, with Sparkle updates.",
      ],
    ],
    demoKicker: "The product, not the pitch",
    demoTitle: "sit → stand → move → verify",
    compareKicker: "Still comparing?",
    compareTitle: "Unchair vs Stretchly vs Time Out",
    compareBody:
      "I put all three side by side without a fake winner: platforms, movement verification, meetings, open source, pricing and integrations.",
    compareLink: "Read the factual comparison",
    roadmapKicker: "Public roadmap",
    roadmapTitle: "Useful today. Weirder tomorrow.",
    roadmapIntro:
      "No invented marketing dates: GitHub issues are the source of truth. Shipped work is closed; upcoming work stays open and inspectable.",
    roadmapGroups: [
      {
        label: "Available now",
        meta: "v0.1 → v0.4.0",
        status: "shipped",
        items: [
          ["Configurable breaks + hard-to-ignore overlay", [2, 3]],
          ["Local Apple Vision: sit → stand + movement proof", [4, 5, 6]],
          ["Meeting / presentation protection + movement debt", [13, 20]],
          ["Local history, Today stats, launch at login", [8, 9, 11]],
          ["Optional Home Assistant / MQTT", [15, 16, 17, 18, 19]],
          ["OpenMetrics, OpenTelemetry, Grafana + CLI doctor", [22, 23, 24, 33]],
          ["Homebrew Cask + Human Runtime card + release checklist", [84, 85, 86]],
          ["Stretchly / Time Out compare + first off-site mentions", [97, 98]],
        ],
      },
      {
        label: "Next",
        meta: "open issues · no promised date",
        status: "next",
        items: [["v1.0 Mac Standalone — reliability / a11y / onboarding", [44]]],
      },
      {
        label: "Apple Enhanced",
        meta: "v1.5",
        status: "later",
        items: [
          ["iOS companion + recent movement from HealthKit", [36, 37]],
          ["watchOS app + live movement evidence", [38, 39]],
          ["Authenticated local transport + wearable reconciliation", [40, 41]],
          ["Watch/iPhone proximity research + extended threat model", [42, 43]],
        ],
      },
      {
        label: "Human Reliability Engineering",
        meta: "v2.x · lab",
        status: "later",
        items: [
          ["Sitting SLO + Human Error Budget", [21]],
          ["Optional standing desk and chair sensor", [26, 27]],
          ["Boss Fight + achievements", [28, 29]],
          ["Automatic post-mortems + calendar + multi-Mac", [30, 31, 32]],
        ],
      },
    ],
    roadmapLink: "See the full roadmap on GitHub",
    faqKicker: "FAQ",
    faqTitle: "The normal questions before letting an app tell you to stand up.",
    faqIntro:
      "Unchair keeps the core deliberately boring: local-first, no mandatory account, and as little hidden magic as possible.",
    faqs: [
      [
        "Does Unchair record or upload my camera feed?",
        "No. Camera frames and Apple Vision data used for movement verification are processed in memory on your Mac. They are not recorded or uploaded.",
      ],
      [
        "Is the camera required?",
        "No. Break reminders work without visual verification. Camera access is only needed if you want Unchair to verify locally that you actually stood up and moved.",
      ],
      [
        "What happens during a meeting or presentation?",
        "Unchair detects strong presentation or call signals and defers interruptions. The movement debt is not discarded; it returns when the context is normal again.",
      ],
      [
        "What if I lock my Mac or go to lunch?",
        "Work and sitting clocks pause while the Mac is locked, asleep, or idle for long enough. Coming back to your desk therefore does not automatically turn lunch into two hours of sitting.",
      ],
      [
        "Do I need Home Assistant or MQTT?",
        "No. Home Assistant and MQTT are entirely optional. Break scheduling, camera verification, presentation mode and local stats keep working without a broker.",
      ],
      [
        "Does Unchair need the Internet or an account?",
        "Not for the core loop. The standalone path needs no cloud account or backend. Networking is only used by optional features such as MQTT, OpenMetrics and direct-channel updates.",
      ],
      [
        "How much does Unchair cost?",
        "Unchair is 100% free and open source under the MIT license. There is no subscription, paid license or mandatory account. The source, releases and privacy model are public on GitHub.",
      ],
      [
        "How do I install Unchair?",
        "With Homebrew: brew install --cask EtienneDeneuve/unchair/unchair. The signed and notarized DMG is also available on GitHub.",
      ],
      [
        "Which Macs are supported and how do updates work?",
        "Unchair targets macOS 14 and later. Direct builds are Developer ID signed, notarized and stapled, with in-app updates powered by Sparkle.",
      ],
    ],
    finalTitle: "Your back does not read your backlog.",
    finalBody:
      "Unchair is free, open source and runs on macOS 14+. Install it before another two-hour session of “I just need to finish this one thing”.",
    engineeringLink: "The engineering write-up at Omnivya",
    workplaceLink: "Workplace wellbeing in practice — a French field note from My Dare",
    footer: "Built by Étienne Deneuve. The annoyance is a feature.",
  },
}[lang];

const source = "etienne_deneuve";
const homebrewCommand = "brew install --cask EtienneDeneuve/unchair/unchair";
const repoBase = "https://github.com/EtienneDeneuve/unchair";
const release =
  "https://github.com/EtienneDeneuve/unchair/releases/latest/download/Unchair-latest-macos.dmg?utm_source=etienne_deneuve&utm_medium=website&utm_campaign=unchair&utm_content=download";
const repo = `${repoBase}?utm_source=${source}&utm_medium=website&utm_campaign=unchair&utm_content=source`;
const tour =
  "https://raw.githubusercontent.com/EtienneDeneuve/unchair/main/docs/assets/unchair-tour.gif";
const menu =
  "https://raw.githubusercontent.com/EtienneDeneuve/unchair/main/docs/assets/screenshots/01-menubar-menu.png";
const ha =
  "https://raw.githubusercontent.com/EtienneDeneuve/unchair/main/docs/assets/screenshots/07-ha-device-controls.png";
---

<main class="unchair">
  <section class="hero">
    <div class="hero__copy">
      <p class="kicker">{copy.eyebrow}</p>
      <h1>{copy.title}<strong>{copy.accent}</strong></h1>
      <p class="lead">{copy.lead}</p>
      <div class="actions">
        <a
          class="btn btn--primary"
          href={release}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="cta_unchair_download"
        >
          {copy.download}<span aria-hidden="true">↗</span>
        </a>
        <a
          class="btn btn--ghost"
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="cta_unchair_source">{copy.source}</a
        >
      </div>
      <div class="homebrew-command" aria-label={copy.homebrewLabel}>
        <span>{copy.homebrewLabel}</span>
        <code>{homebrewCommand}</code>
      </div>
      <ul class="facts" aria-label="Unchair product facts">
        {copy.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>
    <div class="hero__visual">
      <div class="window">
        <div class="window__bar">
          <span></span><span></span><span></span><code>human-runtime.local</code>
        </div>
        <img
          src={tour}
          alt="Unchair macOS product tour showing break reminders and local movement verification"
          loading="eager"
        />
        <div class="runtime">
          <span></span><code>movement_debt &gt; 0 → human_action_required</code>
        </div>
      </div>
    </div>
  </section>

  <section class="why section">
    <div><p class="kicker">{copy.whyKicker}</p><h2>{copy.whyTitle}</h2></div>
    <p>{copy.whyBody}</p>
  </section>

  <section class="cards section">
    {
      copy.cards.map(([index, title, body], i) => (
        <article class:list={["card", i === 0 || i === 3 ? "card--wide" : ""]}>
          <p class="card__index">{index}</p>
          <h3>{title}</h3>
          <p>{body}</p>
          {i === 2 && <img src={menu} alt="Unchair menu bar controls on macOS" loading="lazy" />}
          {i === 3 && (
            <img src={ha} alt="Unchair device controls in Home Assistant" loading="lazy" />
          )}
        </article>
      ))
    }
  </section>

  <section class="engineering section">
    <div class="engineering__head">
      <p class="kicker">{copy.underKicker}</p>
      <h2>{copy.underTitle}</h2>
    </div>
    <div class="engineering__list">
      {
        copy.engineering.map(([title, body], index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="demo section">
    <div><p class="kicker">{copy.demoKicker}</p><h2>{copy.demoTitle}</h2></div>
    <div class="flow" aria-label="Unchair movement verification flow">
      <code>desk time</code><span>→</span><code>break due</code><span>→</span><code>stand</code
      ><span>→</span><code>move</code><span>→</span><code>verified ✓</code>
    </div>
  </section>

  <section class="compare-callout section">
    <p class="kicker">{copy.compareKicker}</p>
    <h2>{copy.compareTitle}</h2>
    <p>{copy.compareBody}</p>
    <a class="btn btn--ghost" href={lang === "fr" ? "/unchair/compare/" : "/en/unchair/compare/"}>
      {copy.compareLink}
    </a>
  </section>

  <section class="roadmap section" id="roadmap">
    <div class="roadmap__head">
      <p class="kicker">{copy.roadmapKicker}</p>
      <h2>{copy.roadmapTitle}</h2>
      <p>{copy.roadmapIntro}</p>
      <a
        class="roadmap__link"
        href={`${repoBase}/blob/main/ROADMAP.md?utm_source=${source}&utm_medium=website&utm_campaign=unchair&utm_content=roadmap`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.roadmapLink}<span aria-hidden="true"> ↗</span>
      </a>
    </div>
    <div class="roadmap__groups">
      {
        copy.roadmapGroups.map((group) => (
          <article class:list={["roadmap__group", `roadmap__group--${group.status}`]}>
            <div class="roadmap__group-head">
              <div>
                <p>{group.label}</p>
                <span>{group.meta}</span>
              </div>
              <i aria-hidden="true" />
            </div>
            <ul>
              {group.items.map(([label, issues]) => (
                <li>
                  <span>{label}</span>
                  <small>
                    {(issues as number[]).map((issue: number, index: number) => (
                      <>
                        {index > 0 && " · "}
                        <a
                          href={`${repoBase}/issues/${issue}`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          #{issue}
                        </a>
                      </>
                    ))}
                  </small>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="faq section" id="faq">
    <div class="faq__head">
      <p class="kicker">{copy.faqKicker}</p>
      <h2>{copy.faqTitle}</h2>
      <p>{copy.faqIntro}</p>
    </div>
    <div class="faq__list">
      {
        copy.faqs.map(([question, answer], index) => (
          <details class="faq__item">
            <summary>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{question}</strong>
              <i aria-hidden="true">+</i>
            </summary>
            <p>{answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="final section">
    <p class="kicker">{copy.eyebrow}</p>
    <h2>{copy.finalTitle}</h2>
    <p>{copy.finalBody}</p>
    <div class="actions">
      <a
        class="btn btn--primary"
        href={release}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="cta_unchair_download"
      >
        {copy.download}<span aria-hidden="true">↗</span>
      </a>
      <a class="btn btn--ghost" href={repo} target="_blank" rel="noopener noreferrer"
        >{copy.source}</a
      >
    </div>
    <p class="workplace-note">
      <a
        href={lang === "fr"
          ? "https://www.omnivya.fr/fr/open-source/unchair/?utm_source=etienne_deneuve&utm_medium=website&utm_campaign=unchair&utm_content=omnivya-engineering"
          : "https://www.omnivya.fr/open-source/unchair/?utm_source=etienne_deneuve&utm_medium=website&utm_campaign=unchair&utm_content=omnivya-engineering"}
        target="_blank"
        rel="noopener noreferrer">{copy.engineeringLink} ↗</a
      >
      <span aria-hidden="true"> · </span>
      <a
        href="https://www.my-dare.com/blog/sante-travail-sedentarite?utm_source=etienne_deneuve&utm_medium=website&utm_campaign=unchair&utm_content=mydare-workplace"
        target="_blank"
        rel="noopener noreferrer">{copy.workplaceLink} ↗</a
      >
    </p>
    <small>{copy.footer}</small>
  </section>
</main>

<style>
  .unchair {
    --u-bg: #101415;
    --u-panel: #171d1e;
    --u-panel2: #202728;
    --u-text: #f3f6ef;
    --u-muted: #a9b0aa;
    --u-line: rgba(255, 255, 255, 0.11);
    --u-acid: #c8ff4d;
    --u-cyan: #67e8f9;
    background: var(--u-bg);
    color: var(--u-text);
    min-height: 100vh;
  }
  .section,
  .hero {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 4rem;
    align-items: center;
    padding: 7rem 0 5rem;
  }
  .kicker {
