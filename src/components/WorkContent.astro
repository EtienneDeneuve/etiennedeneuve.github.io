---
import BaseLayout from "../layouts/BaseLayout.astro";
import { omnivyaContactUrl, siteConfig } from "../config/site.ts";
import { workConfig } from "../config/work.ts";
import {
  breadcrumbJsonLd,
  buildJsonLdGraph,
  collectionPageJsonLd,
  personJsonLd,
  websiteJsonLd,
  type JsonLdObject,
} from "../lib/json-ld.ts";
import { ecosystemNodeId } from "../lib/ecosystem-json-ld.ts";
import { absoluteUrl } from "../config/seo.ts";
import { analyticsAttrs } from "../lib/analytics.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const config = workConfig;
const prefix = lang === "en" ? "/en" : "";
const workPath = `${prefix}/work/`;
const contactPath = `${prefix}/contact/`;
const omnivyaHref = omnivyaContactUrl(lang, "work");

const omnivyaExpertNode: JsonLdObject = {
  "@type": "Organization",
  "@id": ecosystemNodeId("omnivya-expert"),
  name: siteConfig.omnivya.name,
  url: siteConfig.omnivya.website,
};

const jsonLd = buildJsonLdGraph([
  personJsonLd({
    worksFor: { "@id": ecosystemNodeId("omnivya-expert") },
  }),
  omnivyaExpertNode,
  websiteJsonLd(),
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path: workPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: config.meta.title[lang], path: workPath },
  ]),
  {
    "@type": "Service",
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    url: absoluteUrl(workPath),
    provider: { "@id": ecosystemNodeId("omnivya-expert") },
  },
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={workPath}
  alternates={[
    { lang: "fr", href: "/work/" },
    { lang: "en", href: "/en/work/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper stack gap-12 work-page">
    <section class="stack gap-4 page-hero">
      <p class="eyebrow">{config.meta.eyebrow[lang]}</p>
      <h1>{config.meta.title[lang]}</h1>
      <p class="lede">{config.meta.intro[lang]}</p>
    </section>

    <section class="stack gap-6" aria-labelledby="situations-title">
      <h2 id="situations-title">{config.labels.situationsTitle[lang]}</h2>
      <ol class="situations">
        {
          config.situations.map((item) => (
            <li id={item.id}>
              <h3>{item.title[lang]}</h3>
              <p>{item.body[lang]}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="stack gap-5" aria-labelledby="method-title">
      <h2 id="method-title">{config.method.title[lang]}</h2>
      <ol class="method">
        {
          config.method.steps.map((step) => (
            <li>
              <span class="method__num" aria-hidden="true">
                {step.number}
              </span>
              <div>
                <h3>{step.title[lang]}</h3>
                <p>{step.body[lang]}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="stack gap-3" aria-labelledby="boundaries-title">
      <h2 id="boundaries-title">{config.boundaries.title[lang]}</h2>
      <ul class="boundaries">
        {config.boundaries.items[lang].map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="cta-band stack gap-4" aria-labelledby="cta-title">
      <h2 id="cta-title">{config.cta.title[lang]}</h2>
      <p>{config.cta.body[lang]}</p>
      <div class="actions">
        <a
          class="btn-primary"
          href={contactPath}
          {...analyticsAttrs("cta_contact_email", {
            surface: "work",
            intent: "qualification",
            lang,
          })}
        >
          {config.cta.contactLabel[lang]}
        </a>
        <a
          class="btn-secondary"
          href={omnivyaHref}
          rel="noopener noreferrer"
          target="_blank"
          {...analyticsAttrs("cta_booking", {
            surface: "work",
            intent: "qualification",
            lang,
          })}
        >
          {config.cta.omnivyaLabel[lang]}
        </a>
        <a class="btn-text" href={`${prefix}/speaking/`}>{config.labels.speakingLink[lang]}</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .work-page {
    max-width: 48rem;
    padding-block: var(--space-10) var(--space-16);
  }

  .situations {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  .situations h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .situations p {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: 1.5;
  }

  .method {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }

  .method li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3);
  }

  .method__num {
    font-weight: 700;
    color: var(--copper-on-light, var(--accent-regular));
  }

  .method h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-md);
  }

  .method p {
    margin: 0;
    color: var(--color-fg-muted);
  }

  .boundaries {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--color-fg-muted);
    display: grid;
    gap: var(--space-2);
  }

  .cta-band {
    border-top: var(--border-width) solid var(--color-border);
    padding-top: var(--space-8);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
</style>
