---
import BaseLayout from "../layouts/BaseLayout.astro";
import { omnivyaContactUrl, siteConfig } from "../config/site.ts";
import { workConfig } from "../config/work.ts";
import "../styles/editorial-pages.css";
import {
  breadcrumbJsonLd,
  buildJsonLdGraph,
  collectionPageJsonLd,
  personJsonLd,
  websiteJsonLd,
  type JsonLdObject,
} from "../lib/json-ld.ts";
import { ecosystemNodeId } from "../lib/ecosystem-json-ld.ts";
import { absoluteUrl } from "../config/seo.ts";
import { analyticsAttrs } from "../lib/analytics.ts";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const config = workConfig;
const prefix = lang === "en" ? "/en" : "";
const workPath = prefix + "/work/";
const contactPath = prefix + "/contact/";
const projectsPath = prefix + "/projects/";
const omnivyaHref = omnivyaContactUrl(lang, "work");

function localizedHref(href: string): string {
  // Use the actual English speaking page. Field notes remain on their
  // documented French canonical URLs rather than inventing translations.
  return lang === "en" && href === "/speaking/" ? "/en/speaking/" : href;
}

const omnivyaExpertNode: JsonLdObject = {
  "@type": "Organization",
  "@id": ecosystemNodeId("omnivya-expert"),
  name: siteConfig.omnivya.name,
  url: siteConfig.omnivya.website,
};

const jsonLd = buildJsonLdGraph([
  personJsonLd({
    worksFor: { "@id": ecosystemNodeId("omnivya-expert") },
  }),
  omnivyaExpertNode,
  websiteJsonLd(),
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path: workPath,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: prefix || "/" },
    { name: config.meta.title[lang], path: workPath },
  ]),
  {
    "@type": "Service",
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    url: absoluteUrl(workPath),
    provider: { "@id": ecosystemNodeId("omnivya-expert") },
  },
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={workPath}
  alternates={[
    { lang: "fr", href: "/work/" },
    { lang: "en", href: "/en/work/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="editorial-page ed-work">
    <header class="ed-band--dark ed-hero">
      <div class="ed-shell ed-hero__grid">
        <div>
          <p class="ed-kicker">{config.meta.eyebrow[lang]}</p>
          <h1 class="ed-title">
            {config.meta.title[lang]}
            <span class="ed-title__accent">{config.meta.headline[lang]}</span>
          </h1>
          <p class="ed-lede">{config.meta.intro[lang]}</p>
        </div>
        <aside class="ed-hero__aside">
          <p class="ed-aside__label">{config.meta.asideLabel[lang]}</p>
          <p>{config.meta.aside[lang]}</p>
          <a class="ed-aside__link" href={projectsPath}>
            {config.meta.asideLink[lang]} <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>
    </header>

    <section class="ed-band--light ed-section" aria-labelledby="situations-title">
      <div class="ed-shell">
        <div class="ed-section__head">
          <p class="ed-kicker ed-kicker--light">{config.meta.eyebrow[lang]}</p>
          <h2 id="situations-title">{config.labels.situationsTitle[lang]}</h2>
          <p>{config.labels.situationsIntro[lang]}</p>
        </div>
        <ol class="ed-situations">
          {config.situations.map((item, index) => (
            <li class="ed-situation" id={item.id}>
              <span class="ed-situation__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{item.title[lang]}</h3>
              <p class="ed-situation__signal">{item.signal[lang]}</p>
              <dl class="ed-facts">
                <div>
                  <dt>{config.labels.examines[lang]}</dt>
                  <dd>{item.examines[lang]}</dd>
                </div>
                <div>
                  <dt>{config.labels.decision[lang]}</dt>
                  <dd>{item.decision[lang]}</dd>
                </div>
                <div>
                  <dt>{config.labels.outcome[lang]}</dt>
                  <dd>{item.outcome[lang]}</dd>
                </div>
              </dl>
              {item.related && (
                <p class="ed-situation__related">
                  <a href={localizedHref(item.related.href)}>
                    {item.related.label[lang]} <span aria-hidden="true">↗</span>
                  </a>
                  {lang === "en" && item.related.href.startsWith("/thinking/") && (
                    <span> — {config.labels.originalLanguage[lang]}</span>
                  )}
                </p>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="ed-band--dark ed-section" aria-labelledby="method-title">
      <div class="ed-shell">
        <div class="ed-section__head">
          <h2 id="method-title">{config.method.title[lang]}</h2>
          <p>{config.method.intro[lang]}</p>
        </div>
        <ol class="ed-steps">
          {config.method.steps.map((step) => (
            <li>
              <span class="ed-steps__number" aria-hidden="true">{step.number}</span>
              <h3>{step.title[lang]}</h3>
              <p>{step.body[lang]}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="ed-band--light ed-section" aria-labelledby="cta-title">
      <div class="ed-shell ed-cta">
        <div class="ed-cta__text">
          <h2 id="cta-title">{config.cta.title[lang]}</h2>
          <p>{config.cta.body[lang]}</p>
          <p class="ed-note">{config.omnivyaNote[lang]}</p>
        </div>
        <div class="ed-actions">
          <a
            class="ed-button"
            href={contactPath}
            {...analyticsAttrs("cta_contact_email", {
              surface: "work",
              intent: "qualification",
              lang,
            })}
          >
            {config.cta.contactLabel[lang]} <span aria-hidden="true">↗</span>
          </a>
          <a
            class="ed-text-link"
            href={omnivyaHref}
            target="_blank"
            rel="noopener noreferrer"
            {...analyticsAttrs("cta_booking", {
              surface: "work",
              intent: "qualification",
              lang,
            })}
          >
            {config.cta.omnivyaLabel[lang]} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
