---
interface Props {
  items: string[];
  title?: string;
}

const { items, title } = Astro.props;
---

{
  items.length > 0 && (
    <div class="ds-decisions">
      {title && <h3 class="ds-decisions__title">{title}</h3>}
      <ol class="ds-decision-list">
        {items.map((item) => (
          <li>
            <span>{item}</span>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .ds-decisions__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
  }
</style>
