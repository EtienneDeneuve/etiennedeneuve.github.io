---
interface Props {
  ratio?: "16/9" | "4/3" | "1";
  alt?: string;
  src?: string;
}

const { ratio = "16/9", alt = "", src } = Astro.props;
---

<div class="media-frame" data-ratio={ratio}>
  {
    src ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" width="1600" height="900" />
    ) : (
      <slot />
    )
  }
</div>
