---
interface Props {
  name: string;
  status: string;
  summary: string;
  href: string;
  meta?: string;
}

const { name, status, summary, href, meta } = Astro.props;
---

<article class="ds-project-panel surface-card interactive">
  <p class="ds-project-panel__meta eyebrow">{status}{meta ? ` · ${meta}` : ""}</p>
  <h3 class="ds-project-panel__name">
    <a href={href}>{name}</a>
  </h3>
  <p class="ds-project-panel__summary">{summary}</p>
</article>

<style>
  .ds-project-panel__name {
    margin: var(--space-2) 0;
    font-size: var(--text-lg);
  }
  .ds-project-panel__name a {
    color: var(--color-fg);
    text-decoration: none;
  }
  .ds-project-panel__name a:hover {
    text-decoration: underline;
  }
  .ds-project-panel__summary {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
</style>
