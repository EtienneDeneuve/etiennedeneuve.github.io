---
import MainHead from "../components/MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CustomStyles from "../components/CustomStyles.astro";
import CustomScripts from "../components/CustomScripts.astro";
import Analytics from "../components/Analytics.astro";
import JsonLd from "../components/JsonLd.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import type { SeoLang, SeoOgType } from "../config/seo.ts";
import type { JsonLdObject } from "../lib/json-ld.ts";

interface Props {
  title?: string;
  description?: string;
  og?: string;
  image?: string;
  lang?: SeoLang;
  alternates?: { lang: SeoLang; href: string }[];
  canonical?: string;
  path?: string;
  noIndex?: boolean;
  robots?: string;
  ogType?: SeoOgType;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  brandTitle?: boolean;
  jsonLd?: JsonLdObject | JsonLdObject[] | null;
}

const {
  title,
  description,
  og,
  image,
  lang = "fr",
  alternates = [],
  canonical,
  path,
  noIndex = false,
  robots,
  ogType = "website",
  publishedTime,
  modifiedTime,
  brandTitle,
  jsonLd = null,
} = Astro.props;
---

<html lang={lang} transition:animate="none" prefix="og: https://ogp.me/ns#">
  <head>
    <MainHead
      title={title}
      description={description}
      og={og}
      image={image}
      alternates={alternates}
      canonical={canonical}
      path={path}
      noIndex={noIndex}
      robots={robots}
      lang={lang}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      brandTitle={brandTitle}
    />
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <div class="stack backgrounds">
      <Nav />
      <slot />
      <Footer />
    </div>
    <CustomScripts />
    <CustomStyles />
    <Analytics />
    <ScrollReveal />
  </body>
</html>
