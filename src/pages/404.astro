---
import BaseLayout from "../layouts/BaseLayout.astro";
import { notFoundConfig } from "../config/not-found.ts";

const copy = notFoundConfig.fr;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang="fr"
  path="/404/"
  noIndex={true}
  brandTitle={true}
>
  <main class="wrapper stack gap-8 not-found">
    <header class="stack gap-3 page-hero">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <nav aria-label={copy.navLabel}>
      <ul class="links">
        {
          copy.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
</BaseLayout>

<style>
  .not-found {
    max-width: 36rem;
    padding-block: var(--space-12);
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
</style>
