---
import {
  getAllThinkingArticles,
  getArticleLanguage,
  getArticlePath,
  getCanonicalSlug,
  getLegacySlug,
} from "../lib/thinking.ts";

export async function getStaticPaths() {
  const articles = await getAllThinkingArticles();
  const seen = new Set<string>();
  const paths: Array<{ params: { slug: string } }> = [];

  for (const entry of articles) {
    for (const slug of [getCanonicalSlug(entry), getLegacySlug(entry)].filter(
      Boolean
    ) as string[]) {
      if (seen.has(slug)) continue;
      seen.add(slug);
      paths.push({ params: { slug } });
    }
  }

  return paths;
}

const slug = Astro.params.slug;
if (!slug) throw new Error("Missing slug");

const articles = await getAllThinkingArticles();
const entry =
  articles.find((candidate) => getCanonicalSlug(candidate) === slug) ??
  articles.find((candidate) => getLegacySlug(candidate) === slug);

if (!entry) {
  return Astro.redirect("/thinking/", 302);
}

const canonicalPath = getArticlePath(getCanonicalSlug(entry), getArticleLanguage(entry));
return Astro.redirect(canonicalPath, 301);
---
