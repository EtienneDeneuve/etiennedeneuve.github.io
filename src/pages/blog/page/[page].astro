---
/**
 * Legacy paginated blog routes — always redirect to Thinking.
 * Kept so old /blog/page/N URLs resolve during static generation.
 */
export async function getStaticPaths() {
  return Array.from({ length: 12 }, (_, i) => ({
    params: { page: String(i + 1) },
  }));
}

return Astro.redirect("/thinking/", 301);
---
