---
import { getCollection } from "astro:content";
import { getPublishableEntries } from "../../lib/publication-policy.ts";

export async function getStaticPaths() {
  const caseStudies = getPublishableEntries(await getCollection("caseStudies"));
  return caseStudies.map((entry) => ({ params: { slug: entry.id } }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error("Missing slug");
return Astro.redirect(`/work/case-studies/${slug}/`, 301);
---
