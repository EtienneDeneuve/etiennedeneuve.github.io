---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeContent from "../../components/HomeContent.astro";
import { siteConfig } from "../../config/site.ts";
import { messagingConfig } from "../../config/messaging.ts";
import { buildJsonLdGraph, websiteJsonLd } from "../../lib/json-ld.ts";
import { coreIdentityNodes } from "../../lib/ecosystem-json-ld.ts";
import { getAllThinkingArticles, articlesForLocale } from "../../lib/thinking.ts";
import { selectHomeThinking } from "../../lib/home-thinking.ts";

const homeJsonLd = buildJsonLdGraph([...coreIdentityNodes("en"), websiteJsonLd()]);

// EN home only lists EN articles; no FR fallback cards.
const enArticles = articlesForLocale(await getAllThinkingArticles(), "en").sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const selectedThinking = selectHomeThinking(enArticles, "en");
const description = messagingConfig.etienne.promise.en;
---

<BaseLayout
  title={siteConfig.identity.name}
  description={description}
  lang="en"
  path="/en/"
  brandTitle={false}
  ogType="website"
  alternates={[
    { lang: "fr", href: "/" },
    { lang: "en", href: "/en/" },
  ]}
  jsonLd={homeJsonLd}
>
  <HomeContent lang="en" selectedThinking={selectedThinking} />
</BaseLayout>
