---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeContent from "../../components/HomeContent.astro";
import { siteConfig } from "../../config/site.ts";
import { buildJsonLdGraph, websiteJsonLd } from "../../lib/json-ld.ts";
import { coreIdentityNodes } from "../../lib/ecosystem-json-ld.ts";
import { getReleasedArticles } from "../../lib/publication-policy.ts";
import { selectHomeThinking } from "../../lib/home-thinking.ts";

const homeJsonLd = buildJsonLdGraph([...coreIdentityNodes("en"), websiteJsonLd()]);

const released = getReleasedArticles(await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// EN home only lists EN articles — no FR fallback cards.
const enArticles = released.filter((entry) => entry.data.language === "en");
const selectedThinking = selectHomeThinking(enArticles, "en");

const allProjects = (await getCollection("projects")).filter(
  (project) => !project.data.draft && project.data.verified
);
const priorityNames = ["External Metrics Exporter"];
const priorityProjects = priorityNames
  .map((name) => allProjects.find((project) => project.data.name === name))
  .filter((project): project is (typeof allProjects)[number] => Boolean(project));
const featuredOthers = allProjects.filter(
  (project) => project.data.featured && !priorityNames.includes(project.data.name)
);
const proofProjects = [...priorityProjects, ...featuredOthers];
---

<BaseLayout
  title={siteConfig.identity.name}
  description="Doctrine, decisions and public proof for steering an estate under real constraints."
  lang="en"
  path="/en/"
  brandTitle={false}
  ogType="website"
  alternates={[
    { lang: "fr", href: "/" },
    { lang: "en", href: "/en/" },
  ]}
  jsonLd={homeJsonLd}
>
  <HomeContent lang="en" proofProjects={proofProjects} selectedThinking={selectedThinking} />
</BaseLayout>
