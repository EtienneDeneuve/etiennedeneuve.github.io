---
import ThinkingFacetContent from "../../../../components/ThinkingFacetContent.astro";
import { thinkingConfig, type ThinkingContentType } from "../../../../config/thinking.ts";
import { loadFacetCorpus, typeFacetPaths } from "../../../../lib/thinking-facets.ts";
import type { ThinkingArticle } from "../../../../lib/thinking.ts";

export async function getStaticPaths() {
  const { fr, en } = await loadFacetCorpus();
  return typeFacetPaths(fr, en, "en");
}

interface Props {
  type: ThinkingContentType;
  entries: ThinkingArticle[];
}

const { type, entries } = Astro.props;
const label = thinkingConfig.contentTypeLabels[type];
---

<ThinkingFacetContent
  lang="en"
  title={label.en}
  description={`Articles of type “${label.en}”.`}
  entries={entries}
  facetLabel={thinkingConfig.labels.browseTypes.en}
/>
