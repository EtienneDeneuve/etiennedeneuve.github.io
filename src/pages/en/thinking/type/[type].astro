---
import ThinkingFacetContent from "../../../../components/ThinkingFacetContent.astro";
import {
  thinkingConfig,
  thinkingContentTypes,
  type ThinkingContentType,
} from "../../../../config/thinking.ts";
import { articlesForLocale, getAllThinkingArticles } from "../../../../lib/thinking.ts";

export async function getStaticPaths() {
  const articles = articlesForLocale(await getAllThinkingArticles(), "en");
  return thinkingContentTypes
    .map((type) => ({
      params: { type },
      props: {
        type,
        entries: articles.filter((entry) => entry.data.contentType === type),
      },
    }))
    .filter((path) => path.props.entries.length > 0);
}

interface Props {
  type: ThinkingContentType;
  entries: Awaited<ReturnType<typeof getAllThinkingArticles>>;
}

const { type, entries } = Astro.props;
const label = thinkingConfig.contentTypeLabels[type];
---

<ThinkingFacetContent
  lang="en"
  title={label.en}
  description={`Articles of type “${label.en}”.`}
  entries={entries}
  facetLabel={thinkingConfig.labels.browseTypes.en}
/>
