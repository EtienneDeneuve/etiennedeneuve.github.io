---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeContent from "../components/HomeContent.astro";
import { siteConfig } from "../config/site.ts";
import {
  buildJsonLdGraph,
  organizationJsonLd,
  personJsonLd,
  websiteJsonLd,
} from "../lib/json-ld.ts";
import { getReleasedArticles } from "../lib/publication-policy.ts";
import { selectHomeThinking } from "../lib/home-thinking.ts";

const homeJsonLd = buildJsonLdGraph([personJsonLd(), organizationJsonLd(), websiteJsonLd()]);

const allArticles = getReleasedArticles(await getCollection("blog"))
  .filter((entry) => (entry.data.language ?? "fr") === "fr")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const selectedThinking = selectHomeThinking(allArticles, "fr");

const allProjects = (await getCollection("projects")).filter(
  (project) => !project.data.draft && project.data.verified
);

const priorityNames = ["Omnivya", "My Dare", "External Metrics Exporter", "Sanad"];
const priorityProjects = priorityNames
  .map((name) => allProjects.find((project) => project.data.name === name))
  .filter((project): project is (typeof allProjects)[number] => Boolean(project));
const featuredOthers = allProjects.filter(
  (project) => project.data.featured && !priorityNames.includes(project.data.name)
);
const proofProjects = [...priorityProjects, ...featuredOthers];
---

<BaseLayout
  title={siteConfig.identity.name}
  description="Doctrine, décisions et preuves publiques pour piloter un SI sous contraintes réelles."
  lang="fr"
  path="/"
  brandTitle={false}
  ogType="website"
  alternates={[
    { lang: "fr", href: "/" },
    { lang: "en", href: "/en/" },
  ]}
  jsonLd={homeJsonLd}
>
  <HomeContent lang="fr" proofProjects={proofProjects} selectedThinking={selectedThinking} />
</BaseLayout>
