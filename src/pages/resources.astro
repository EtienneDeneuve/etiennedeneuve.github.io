---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resourcesPageConfig } from "../config/resources-page.ts";
import {
  breadcrumbJsonLd,
  buildJsonLdGraph,
  collectionPageJsonLd,
  personJsonLd,
} from "../lib/json-ld.ts";

const lang = "fr" as const;
const config = resourcesPageConfig;
const path = "/resources/";

const jsonLd = buildJsonLdGraph([
  personJsonLd(),
  collectionPageJsonLd({
    name: config.meta.title[lang],
    description: config.meta.description[lang],
    path,
    lang,
  }),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: config.meta.title[lang], path },
  ]),
]);
---

<BaseLayout
  title={config.meta.title[lang]}
  description={config.meta.description[lang]}
  lang={lang}
  path={path}
  alternates={[
    { lang: "fr", href: "/resources/" },
    { lang: "en", href: "/en/resources/" },
  ]}
  jsonLd={jsonLd}
>
  <main class="wrapper resources stack gap-10">
    <header class="page-hero stack gap-3">
      <h1>{config.meta.title[lang]}</h1>
      <p class="lede">{config.meta.intro[lang]}</p>
    </header>

    <ul class="list">
      {
        config.items.map((item) => (
          <li class="item">
            <h2>{item.title[lang]}</h2>
            <p>{item.note[lang]}</p>
            <p class="links">
              {item.links.map((link, i) => (
                <>
                  {i > 0 && " · "}
                  <a
                    href={link.href}
                    target={link.href.startsWith("http") ? "_blank" : undefined}
                    rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  >
                    {link.label[lang]}
                  </a>
                </>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .resources {
    max-width: 40rem;
    padding-block: var(--space-10) var(--space-16);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }
  .item h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .item p {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: 1.55;
  }
  .links {
    margin-top: var(--space-3) !important;
    font-size: var(--text-sm);
  }
</style>
