---
import { resourcesPageConfig } from "../../config/resources-page.ts";

/**
 * Former per-resource transit pages: 301 to the compact index section
 * (or /resources/ when the entry was retired). Collection content feeds the index.
 */
export function getStaticPaths() {
  return Object.keys(resourcesPageConfig.transitRedirects).map((slug) => ({
    params: { slug },
    props: {
      destination:
        resourcesPageConfig.transitRedirects[
          slug as keyof typeof resourcesPageConfig.transitRedirects
        ],
    },
  }));
}

const { destination } = Astro.props as { destination: string };
return Astro.redirect(destination, 301);
---
