---
import ThinkingFacetContent from "../../../components/ThinkingFacetContent.astro";
import { thinkingConfig, type ThinkingPillar } from "../../../config/thinking.ts";
import { loadFacetCorpus, pillarFacetPaths } from "../../../lib/thinking-facets.ts";
import type { ThinkingArticle } from "../../../lib/thinking.ts";

export async function getStaticPaths() {
  const { fr, en } = await loadFacetCorpus();
  return pillarFacetPaths(fr, en, "fr");
}

interface Props {
  pillar: ThinkingPillar;
  entries: ThinkingArticle[];
}

const { pillar, entries } = Astro.props;
const label = thinkingConfig.pillarLabels[pillar];
---

<ThinkingFacetContent
  lang="fr"
  title={label.fr}
  description={`Articles du pilier « ${label.fr} ».`}
  entries={entries}
  facetLabel={thinkingConfig.labels.browsePillars.fr}
/>
