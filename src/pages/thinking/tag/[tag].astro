---
import ThinkingFacetContent from "../../../components/ThinkingFacetContent.astro";
import { thinkingConfig } from "../../../config/thinking.ts";
import { loadFacetCorpus, tagFacetPaths } from "../../../lib/thinking-facets.ts";
import type { ThinkingArticle } from "../../../lib/thinking.ts";

export async function getStaticPaths() {
  const { fr, en } = await loadFacetCorpus();
  return tagFacetPaths(fr, en, "fr");
}

interface Props {
  tag: { slug: string; label: string; count: number };
  entries: ThinkingArticle[];
}

const { tag, entries } = Astro.props;
---

<ThinkingFacetContent
  lang="fr"
  title={tag.label}
  seoTitle={`Tag : ${tag.label}`}
  description={`Articles tagués « ${tag.label} » (${entries.length}).`}
  entries={entries}
  facetLabel={thinkingConfig.labels.browseTags.fr}
/>
